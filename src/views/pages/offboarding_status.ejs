<%- include('../partials/header', { title: 'Offboarding Status' }) %>
<link rel="stylesheet" href="/css/modern.css">
<!-- Stepper display fonts (graceful fallback if the intranet blocks Google) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap">

<header class="app-header">
    <div class="brand-section">
        <img src="/logo.png" alt="IFL" class="logo" onerror="this.style.display='none'">
        <div class="app-title">
            <h1>Offboarding Workflow</h1>
            <p>Ibrahim Fibres Limited</p>
        </div>
    </div>
    <div class="status-section">
        <% if (token && request && request.id) { %>
            <div class="status-badge">REQ #<%= request.id %> | <%= request.status %></div>
        <% } %>
    </div>
</header>

<%
    // Client-side verification cloak — hides the page body until SSO identity
    // is resolved. Mirrors the onboarding_form pattern. Only active when the
    // request has a stage assignee (token-bearing pages); for ReadOnly / no-
    // token renders the cloak lifts immediately.
%>
<% if (typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail) { %>
<style>
    body.ifl-is-verifying main, body.ifl-is-verifying .app-container,
    body.ifl-is-verifying .portal-shell, body.ifl-is-verifying form { visibility: hidden; }
    body.ifl-is-verifying { overflow: hidden; }
    .iflv-overlay {
        position: fixed; inset: 0; z-index: 9000;
        display: flex; align-items: center; justify-content: center;
        background: #fff;
        transition: opacity 0.24s ease;
    }
    .iflv-overlay.is-fading-out { opacity: 0; pointer-events: none; }
    .iflv-card { text-align: center; max-width: 360px; }
    .iflv-spin {
        width: 36px; height: 36px; border-radius: 50%;
        border: 3px solid #e2e8f0; border-top-color: #0078D4;
        margin: 0 auto 14px; animation: iflv-spin 0.8s linear infinite;
    }
    @keyframes iflv-spin { to { transform: rotate(360deg); } }
    .iflv-title { font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0 0 4px; }
    .iflv-sub   { font-size: 0.86rem; color: #64748b; margin: 0; }
</style>
<script>document.documentElement.classList.add('ifl-is-verifying'); document.body && document.body.classList.add('ifl-is-verifying');</script>
<div id="iflVerifyOverlay" class="iflv-overlay" role="status" aria-live="polite">
    <div class="iflv-card">
        <div class="iflv-spin"></div>
        <p class="iflv-title">Verifying your access</p>
        <p class="iflv-sub">Please wait while we confirm you are the intended approver for this offboarding request.</p>
    </div>
</div>
<% } %>

<%# Queue sidebar removed per Israr (6 Jun 2026): the queue belongs in the
    standalone portal view (/portal/dci-manager), not next to the form. %>

<style>
    /* modern.css styles .app-container as the onboarding "app shell": a fixed
       calc(100vh) flex card with overflow:hidden, which relies on an inner
       .form-scroll region to scroll. This offboarding page is a naturally
       flowing stack of .off-card panels with no such inner scroller, so that
       shell clips the content and kills scrolling. Opt this page out: let the
       container size to its content and the page scroll normally. The .off-card
       panels supply their own card chrome, so the container itself is bare. */
    .app-container {
        height: auto;
        min-height: 0;
        overflow: visible;
        display: block;
        background: transparent;
        border-radius: 0;
        box-shadow: none;
    }

    .off-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 18px -10px rgba(15,23,42,0.18);
        padding: 28px;
        margin-bottom: 24px;
        border: 1px solid #e2e8f0;
    }

    /* Submit-button loading state — same visual language as the onboarding
       form, so the DCI Manager / DCI Implementer see the spinner-and-disable
       UX they're already used to and can't double-click into an Invalid Token. */
    @keyframes ifl-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .ifl-spinner { animation: ifl-spin 0.7s linear infinite; vertical-align: -3px; margin-right: 6px; }
    button.is-loading { opacity: 0.75; cursor: wait; pointer-events: none; }
    button.is-loading > .ifl-btn-original { display: none; }
    button:disabled { cursor: not-allowed; }
    /* Match the stepper bar to the .off-card chrome so it reads as a card on the
       flowing page rather than a bare full-width strip. */
    .steps-container {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 6px 18px -10px rgba(15,23,42,0.18);
    }
    .off-card h2 {
        margin: 0 0 16px;
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 10px;
    }
    .off-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 4px;
    }
    .off-info-grid .field-label {
        font-size: 0.7rem; font-weight: 700; color: #64748b;
        letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px;
    }
    .off-info-grid .field-value {
        font-size: 0.95rem; color: #0f172a; font-weight: 500;
    }

    /* Privileges Summary — read-only list of services that will be revoked */
    .priv-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 10px 18px;
        margin-top: 8px;
    }
    .priv-item {
        display: flex; align-items: center; gap: 10px;
        font-size: 0.92rem; color: #0f172a;
    }
    .priv-item .priv-dot {
        flex: 0 0 18px;
        width: 18px; height: 18px; border-radius: 50%;
        background: #fef3c7; color: #b45309;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 700;
    }
    .priv-empty {
        padding: 18px; background: #fef9c3; border-radius: 8px;
        color: #854d0e; font-size: 0.9rem;
    }

    /* Live AD account panel */
    .ad-loading { display:flex; align-items:center; gap:10px; color:#64748b; font-size:0.9rem; padding:6px 0; }
    .ad-table { width:100%; border-collapse:collapse; font-size:0.9rem; }
    .ad-table td { padding:6px 10px 6px 0; vertical-align:top; }
    .ad-table td.ad-key { color:#64748b; white-space:nowrap; width:1%; font-weight:600; }
    .ad-table code { background:#f0f9ff; padding:1px 6px; border-radius:3px; font-size:0.85rem; }
    .ad-badge { display:inline-block; padding:2px 10px; border-radius:999px; font-size:0.72rem; font-weight:700; letter-spacing:0.02em; }
    .ad-badge--enabled  { background:#dcfce7; color:#166534; }
    .ad-badge--disabled { background:#fee2e2; color:#b91c1c; }
    .ad-groups { display:flex; flex-wrap:wrap; gap:6px; margin-top:2px; }
    .ad-chip { background:#eef2ff; color:#3730a3; border:1px solid #e0e7ff; border-radius:6px; padding:2px 8px; font-size:0.78rem; }
    .ad-empty { display:flex; align-items:center; gap:10px; padding:14px 16px; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; color:#64748b; font-size:0.9rem; }

    /* Action panel */
    .action-panel {
        margin-top: 12px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 22px;
    }
    .check-row {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 10px 0;
        border-bottom: 1px dashed #e2e8f0;
    }
    .check-row:last-child { border-bottom: none; }
    .check-row input[type=checkbox] {
        width: 18px; height: 18px; margin-top: 2px; accent-color: #0078D4;
    }
    .check-row label { font-size: 0.95rem; color: #0f172a; }
    .check-row small { display: block; color: #64748b; font-size: 0.78rem; margin-top: 2px; }

    .btn-row { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .btn {
        padding: 10px 22px; border-radius: 6px; border: none;
        font-weight: 600; font-size: 0.92rem; cursor: pointer; font-family: inherit;
    }
    .btn-success { background: #10b981; color: #fff; }
    .btn-success:hover { background: #059669; }
    .btn-danger  { background: #ef4444; color: #fff; }
    .btn-danger:hover { background: #dc2626; }
    .btn-primary { background: #0284c7; color: #fff; }
    .btn-primary:hover { background: #0369a1; }
</style>

<div class="app-container" style="max-width: 1000px; margin: 30px auto; padding: 0 20px;">

    <!-- Stepper — shares the Figma connector-rail styling in modern.css with
         the onboarding form. The flex row + rail rules target .steps-row, so the
         wrapper must be .steps-row (not .steps) for the layout to apply. -->
    <div class="steps-container" style="margin-bottom: 28px;">
        <div class="steps-row">
            <% steps.forEach((s, i) => { %>
                <div class="step-item <%= s.status %>">
                    <div class="step-circle"><%= i + 1 %></div>
                    <div class="step-label" title="<%= s.label %>"><%= s.label %></div>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- Employee Header -->
    <div class="off-card">
        <h2>Employee Being Offboarded</h2>
        <div class="off-info-grid">
            <div>
                <div class="field-label">Employee ID</div>
                <div class="field-value"><%= request.employeeId || '—' %></div>
            </div>
            <div>
                <div class="field-label">Full Name</div>
                <div class="field-value"><%= request.fullName || '—' %></div>
            </div>
            <div>
                <div class="field-label">Department</div>
                <div class="field-value"><%= request.department || '—' %></div>
            </div>
            <div>
                <div class="field-label">Designation</div>
                <div class="field-value"><%= request.designation || '—' %></div>
            </div>
            <div>
                <div class="field-label">Location Group</div>
                <div class="field-value">
                    <%
                        const locKey  = request.location || '';
                        const locShow = locKey && typeof locationGroupLabels !== 'undefined' && locationGroupLabels[locKey]
                                        ? locationGroupLabels[locKey] : (locKey || '—');
                    %>
                    <%= locShow %>
                </div>
            </div>
            <div>
                <div class="field-label">Initiated By</div>
                <div class="field-value"><%= request.initiatedBy || '—' %></div>
            </div>
        </div>
    </div>

    <!-- Live Active Directory account — the real account + groups that deletion
         will remove, fetched client-side via the sidecar (adsearch.aspx) so a
         slow AD lookup never blocks the form render. Two-phase pattern: render a
         placeholder now, fill it from /api/offboarding/:id/ad-profile on load.
         Shown to the DCI Manager (confirmation) and DCI Implementer (deletion). -->
    <% if (role === 'DCIManager' || role === 'DCIImplementer') { %>
        <div class="off-card" id="adAccountCard">
            <h2>Active Directory Account
                <span style="font-weight:400; font-size:0.78rem; color:#64748b;">— live from AD</span>
            </h2>
            <p style="font-size: 0.88rem; color: #475569; margin: 0 0 14px;">
                The actual Active Directory account that will be <strong>deleted</strong>, shown live
                alongside the granted-services snapshot below. If no account is linked, deletion may
                already be done or the Employee ID isn't set in AD.
            </p>
            <div id="adAccountBody">
                <div class="ad-loading">
                    <svg class="ifl-spinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                    Looking up the Active Directory account…
                </div>
            </div>
        </div>
    <% } %>

    <%
        // Helper: build a list of "granted" services from the matched
        // OnboardingRequest row. Each entry has a label and an optional detail
        // string. Rendered as a read-only checklist on the DCI Manager view.
        const builtPriv = (function buildPrivileges(p) {
            if (!p) return [];
            const items = [];
            const yes = (label, detail) => items.push({ label, detail: detail || '' });
            if (p.intranetAccess)    yes('Intranet Access');
            if (p.internetAccess)    yes('Internet (General Browsing)');
            if (p.specificWebsites)  yes('Specific Websites Access');
            if (p.emailIncoming)     yes('Incoming Email');
            if (p.emailOutgoing)     yes('Outgoing (External) Email');
            if (p.laserPrinter)      yes('Laser Printer', p.laserPrinterLocation);
            if (p.dotMatrixPrinter)  yes('Dot Matrix Printer', p.dotMatrixPrinterLocation);
            if (p.deptSharePath)     yes('Department Share (S:)', p.deptSharePath);
            if (p.homeFolderPath)    yes('Home Folder (Z:)', p.homeFolderPath);
            if (p.iflPortalLink)     yes('IFL Portal Shortcut', p.iflPortalLink);
            if (p.sharepointRole)    yes('SharePoint Role', p.sharepointRole);
            if (p.ntUserName)        yes('NT User Name', p.ntUserName);
            if (p.exchangeDisplayName) yes('Exchange Display Name', p.exchangeDisplayName);
            if (p.smtpAddress)       yes('SMTP Address', p.smtpAddress);
            if (p.memberOf)          yes('AD Groups', p.memberOf);
            if (p.dgMembers)         yes('Distribution Groups', p.dgMembers);
            if (p.mailSizeLimit)     yes('Mailbox Size Limit', p.mailSizeLimit);
            if (p.recipientLimit)    yes('Recipient Limit', p.recipientLimit);
            if (p.mailboxStorageLimit) yes('Mailbox Storage Limit', p.mailboxStorageLimit);
            if (p.groupPolicyLevel)  yes('Group Policy Level', p.groupPolicyLevel);
            if (p.extraFacility)     yes('Extra Facility', p.extraFacility);
            return items;
        })(typeof privileges !== 'undefined' ? privileges : null);
    %>

    <!-- DCI Manager Approval — privileges card + decision form -->
    <% if (role === 'DCIManager') { %>
        <div class="off-card">
            <h2>Privileges That Will Be Revoked</h2>
            <p style="font-size: 0.88rem; color: #475569; margin: 0 0 14px;">
                Below is a snapshot of the services granted at onboarding. Approval below
                <strong>acknowledges</strong> that these will be revoked when the DCI Implementer deletes the AD account.
            </p>
            <% if (!privileges) { %>
                <div class="priv-empty">
                    <strong>No matching onboarding record found</strong> for employee <%= request.employeeId %>.
                    Proceeding without a privilege summary. Confirm with HR before approving.
                </div>
            <% } else if (!builtPriv.length) { %>
                <div class="priv-empty">
                    Onboarding record found, but no granted services are recorded on it.
                </div>
            <% } else { %>
                <div class="priv-list">
                    <% builtPriv.forEach(function(p) { %>
                        <div class="priv-item">
                            <span class="priv-dot">!</span>
                            <div>
                                <div><%= p.label %></div>
                                <% if (p.detail) { %>
                                    <small style="color:#64748b; font-size:0.78rem;"><%= p.detail %></small>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <div class="off-card">
            <h2>Your Decision</h2>
            <form action="/api/offboarding/handle?token=<%= token %>" method="POST" id="offMgrForm">
                <div style="margin-bottom: 14px;">
                    <label class="field-label" style="display:block; margin-bottom:4px;">Manager Remarks (optional)</label>
                    <textarea name="managerRemarks" rows="3" style="width:100%; padding:10px; border-radius:6px; border:1px solid #cbd5e1; font-size:0.95rem;"></textarea>
                </div>
                <div class="btn-row">
                    <button type="submit" name="action" value="Reject"
                            class="btn btn-danger"
                            data-ifl-confirm="Reject this offboarding request? The workflow will be closed."
                            data-ifl-confirm-title="Reject offboarding"
                            data-ifl-confirm-ok="Reject">Reject</button>
                    <button type="submit" name="action" value="Approve" class="btn btn-success">Approve &amp; Forward to DCI Implementer</button>
                </div>
            </form>
        </div>
    <% } %>

    <!-- DCI Implementer — AD delete confirm + SmartX + door access checkboxes -->
    <% if (role === 'DCIImplementer') { %>
        <div class="off-card">
            <h2>Revocation Checklist</h2>
            <p style="font-size: 0.88rem; color: #475569; margin: 0 0 14px;">
                Confirm each item. Deleting the AD account automatically revokes email, printers,
                Windows login, IGC Portal, the shared file server, and intranet/internet browsing
                rights. SmartX and door-access systems are physical and must be confirmed separately.
            </p>

            <!-- Revocation Work Order PDF — generated at DCI Manager approval with
                 the AD account, employee details, and onboarding-granted services.
                 Download, action it, then upload the proof below. -->
            <% if (request.revocationPdfPath) { %>
                <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:14px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b91c1c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    <div>
                        <div style="font-size:0.88rem;font-weight:600;color:#991b1b;margin-bottom:4px;">Access Revocation Work Order (PDF)</div>
                        <div style="font-size:0.78rem;color:#4b5563;margin-bottom:8px;">Includes the live AD account, employee details, and the services granted at onboarding. Download and action it before uploading proof.</div>
                        <a href="/api/offboarding/pdf/<%= token %>" target="_blank" rel="noopener"
                           style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:#b91c1c;color:#fff;border-radius:6px;font-size:0.8rem;font-weight:600;text-decoration:none;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Open Work Order PDF
                        </a>
                    </div>
                </div>
            <% } %>

            <form action="/api/offboarding/handle?token=<%= token %>" method="POST" enctype="multipart/form-data">
                <div class="action-panel">
                    <div style="margin-bottom: 14px;">
                        <label class="field-label" style="display:block;">Implementer Name
                            <span style="color:#64748b; font-weight:400; font-size:0.78rem;">(auto-filled from Windows login)</span>
                        </label>
                        <input type="text" name="implementerName"
                               data-ifl-sso-name="1"
                               value="<%= (currentUser && (currentUser.displayName || currentUser.username)) || '' %>"
                               disabled
                               style="width:100%; padding:8px 10px; border-radius:6px; border:1px solid #cbd5e1; background:#f1f5f9; color:#0f172a; font-size:0.95rem;">
                    </div>

                    <div class="check-row">
                        <input type="checkbox" name="adRevoked" value="on" id="cb-ad" required>
                        <label for="cb-ad">
                            AD Account Deleted
                            <small>Email, printers, Windows login, IGC Portal, file server, intranet &amp; internet — all automatic.</small>
                        </label>
                    </div>
                    <div class="check-row">
                        <input type="checkbox" name="smartXRevoked" value="on" id="cb-smartx" required>
                        <label for="cb-smartx">
                            SmartX Access Revoked
                            <small>Building access via the SmartX system has been disabled.</small>
                        </label>
                    </div>
                    <div class="check-row">
                        <input type="checkbox" name="doorAccessRevoked" value="on" id="cb-door" required>
                        <label for="cb-door">
                            Door Access Control Revoked
                            <small>Door / physical access controllers have been removed for this user.</small>
                        </label>
                    </div>

                    <div style="margin-top: 14px;">
                        <label class="field-label" style="display:block; margin-bottom: 4px;">Notes (optional)</label>
                        <textarea name="checklistNotes" rows="2" style="width:100%; padding:10px; border-radius:6px; border:1px solid #cbd5e1; font-size:0.95rem;"></textarea>
                    </div>

                    <div style="margin-top: 14px; padding: 14px; border: 2px dashed #cbd5e1; border-radius: 8px; text-align:center;">
                        <label style="cursor:pointer; color: #0078D4; font-weight: 600;">Upload proof screenshots <span style="color:#dc2626;">*</span></label>
                        <div style="font-size:0.75rem; color:#64748b; margin-top:2px;">Required — up to 5 images, max 1 MB each (5 MB total). JPG, PNG, GIF, or WEBP.</div>
                        <input type="file" name="dciProof" id="dciProofInput" multiple required accept="image/jpeg,image/png,image/gif,image/webp" style="display:block; margin: 8px auto 0;">
                    </div>
                </div>

                <div class="btn-row">
                    <button type="submit" class="btn btn-success">Confirm All Revocations &amp; Complete</button>
                </div>
            </form>
        </div>
    <% } %>

    <!-- Read-only summary for Completed / Rejected / other read-only views -->
    <% if (role === 'ReadOnly') { %>
        <div class="off-card">
            <h2>Status</h2>
            <% if (request.status === 'Completed') { %>
                <div style="padding: 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px;">
                    <h3 style="color: #065f46; margin: 0 0 6px;">Offboarding Completed</h3>
                    <p style="color: #047857; margin: 0; font-size: 0.92rem;">
                        Completed on <%= request.completedAt ? new Date(request.completedAt).toLocaleString() : 'N/A' %>
                        <% if (request.dciImplementerName) { %> · by <%= request.dciImplementerName %><% } %>
                    </p>
                </div>
            <% } else if (request.status === 'Rejected') { %>
                <div style="padding: 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;">
                    <h3 style="color: #991b1b; margin: 0 0 6px;">Offboarding Rejected</h3>
                    <% if (request.managerRemarks) { %>
                        <p style="color: #7f1d1d; margin: 0; font-size: 0.92rem;"><%= request.managerRemarks %></p>
                    <% } %>
                </div>
            <% } else { %>
                <p style="color:#64748b;">Status: <strong><%= request.status || 'Unknown' %></strong></p>
            <% } %>

            <% if (request.status === 'Completed') { %>
                <div style="margin-top: 18px;">
                    <h3 style="font-size: 0.92rem; color:#475569; margin: 0 0 8px;">Revocation summary</h3>
                    <div class="check-row">
                        <input type="checkbox" disabled <%= request.adRevoked ? 'checked' : '' %>>
                        <label>AD Account Deleted</label>
                    </div>
                    <div class="check-row">
                        <input type="checkbox" disabled <%= request.smartXRevoked ? 'checked' : '' %>>
                        <label>SmartX Access Revoked</label>
                    </div>
                    <div class="check-row">
                        <input type="checkbox" disabled <%= request.doorAccessRevoked ? 'checked' : '' %>>
                        <label>Door Access Control Revoked</label>
                    </div>
                    <% if (request.checklistNotes) { %>
                        <div style="margin-top: 12px; padding: 12px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">
                            <div class="field-label" style="color: #d97706;">Implementer Notes</div>
                            <div class="field-value" style="font-size: 0.92rem;"><%= request.checklistNotes %></div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    <% } %>

</div>

<%# portal_close + portal_scripts dropped together with portal_shell above —
    no queue sidebar on this form. The standalone portal at /portal/dci-manager
    is the single source for the queue view. %>

<script>
    // ── Verification cloak — hides the page until the SSO user is confirmed
    // to be the expected assignee. Same pattern as onboarding_form.ejs.
    document.addEventListener('DOMContentLoaded', async () => {
        const expected = <%- JSON.stringify(typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail ? expectedAssigneeEmail : null) %>;
        const overlay  = document.getElementById('iflVerifyOverlay');

        // Local-part comparison so different domains (ifl.net vs igc.com.pk)
        // for the same person don't fail. Mirrors src/utils/emailMatch.js.
        const emailLocalPart = (e) => {
            if (!e || typeof e !== 'string') return '';
            const at = e.indexOf('@');
            if (at <= 0) return '';
            return e.slice(0, at).toLowerCase().trim();
        };
        const emailsMatch = (a, b) => {
            const la = emailLocalPart(a);
            const lb = emailLocalPart(b);
            return !!la && la === lb;
        };

        const liftCloak = () => {
            document.documentElement.classList.remove('ifl-is-verifying');
            document.body.classList.remove('ifl-is-verifying');
            if (overlay) {
                overlay.classList.add('is-fading-out');
                setTimeout(() => overlay.remove(), 260);
            }
        };

        const showRejection = (expectedEmail, actualLabel) => {
            document.documentElement.classList.remove('ifl-is-verifying');
            document.body.classList.remove('ifl-is-verifying');
            if (overlay) overlay.remove();
            document.body.innerHTML = `
              <div style="max-width:560px;margin:80px auto;padding:36px;background:#fff;border:1px solid #fee2e2;border-radius:14px;text-align:center;font-family:'Segoe UI',sans-serif;box-shadow:0 12px 40px -8px rgba(220,38,38,.18);">
                <div style="width:72px;height:72px;border-radius:50%;background:#fee2e2;color:#b91c1c;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 18px;">⛔</div>
                <h2 style="color:#b91c1c;margin:0 0 14px;font-size:1.15rem;">Access Denied</h2>
                <p style="color:#475569;line-height:1.55;margin:0 0 14px;">
                  Account <strong>${actualLabel}</strong> is not configured as the approver for this offboarding request.
                </p>
                <p style="color:#475569;line-height:1.55;margin:0 0 14px;">
                  This action link was sent to <strong>${expectedEmail}</strong>.
                </p>
                <p style="color:#64748b;font-size:.9rem;">If you need to handle it on someone's behalf, please contact your administrator.</p>
              </div>`;
        };

        // No expected email → not a token-bearing stage. Lift any cloak and exit.
        if (!expected) {
            liftCloak();
        } else if (typeof window.iflGetUser !== 'function') {
            // SSO helper unavailable (page loaded outside the portal/IIS).
            showRejection(expected, 'an unverified user (SSO not available on this device)');
            return;
        } else {
            try {
                const u = await window.iflGetUser();
                if (!u || !u.email) {
                    showRejection(expected, 'an unverified user');
                    return;
                }
                if (!emailsMatch(u.email, expected)) {
                    showRejection(expected, u.email || u.username);
                    return;
                }
                liftCloak();
            } catch (_) {
                showRejection(expected, 'an unverified user (SSO check failed)');
                return;
            }
        }

        // Auto-fill implementer name from SSO — mirrors the onboarding form pattern.
        try {
            if (typeof window.iflGetUser !== 'function') return;
            const u = await window.iflGetUser();
            if (!u) return;
            const v = u.displayName || u.username || '';
            document.querySelectorAll('input[data-ifl-sso-name="1"]').forEach(el => {
                if (!el.value) el.value = v;
            });
        } catch (_) {}
    });

    // Submit lifecycle — same setupSubmitLoaders pattern as the onboarding
    // form. Three jobs: (1) attach the sidecar token to every POST so IIS
    // doesn't re-challenge for Windows auth, (2) mirror the clicked button's
    // name/value into a hidden field so the action survives disabling, and
    // (3) disable + spinner-ify the submit buttons immediately so the user
    // can't double-click (which would re-POST the now-rotated stage token and
    // land on the "Invalid or Expired Token" screen).
    (function setupSubmitLoaders() {
        const SPINNER_SVG = '<svg class="ifl-spinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>';

        const ensureTokenField = async (form) => {
            if (typeof window.iflGetToken !== 'function') return;
            let hidden = form.querySelector('input[name="x-sidecar-token"]');
            if (!hidden) {
                hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'x-sidecar-token';
                form.appendChild(hidden);
            }
            try { hidden.value = await window.iflGetToken(); }
            catch (_) { /* server returns 401 with clear JSON */ }
        };

        // form.requestSubmit(btn) preserves e.submitter; fall back to click()
        // for very old browsers.
        function reSubmit(form, submitter) {
            if (submitter && typeof form.requestSubmit === 'function') {
                try { form.requestSubmit(submitter); return; } catch (_) {}
            }
            if (submitter && typeof submitter.click === 'function') submitter.click();
            else form.submit();
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    // Run native validation first; if it fails, don't lock the buttons.
                    if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;

                    const submitter = e.submitter
                        || form.querySelector('button[type="submit"]:focus')
                        || form.querySelector('button[type="submit"]');

                    // Pin the action value into a hidden mirror field IMMEDIATELY —
                    // before any async work or disabling. Browsers serialize form
                    // data after the handler returns, at which point disabled
                    // buttons are excluded from the body. The mirror guarantees
                    // the action (Approve/Reject/etc.) still reaches the server.
                    if (submitter && submitter.name) {
                        let mirror = form.querySelector('input[data-ifl-action-mirror]');
                        if (!mirror) {
                            mirror = document.createElement('input');
                            mirror.type = 'hidden';
                            mirror.dataset.iflActionMirror = '1';
                            form.appendChild(mirror);
                        }
                        mirror.name  = submitter.name;
                        mirror.value = submitter.value;
                    }

                    // Custom confirm dialog if the submitter declares one
                    // (e.g. the Reject button's data-ifl-confirm). Runs before
                    // disabling so the user can still cancel.
                    const confirmMsg = submitter && submitter.dataset && submitter.dataset.iflConfirm;
                    if (confirmMsg && !form.dataset.iflConfirmed && typeof IflDialog !== 'undefined' && IflDialog && typeof IflDialog.confirm === 'function') {
                        e.preventDefault();
                        const ok = await IflDialog.confirm(confirmMsg, {
                            title:  submitter.dataset.iflConfirmTitle || undefined,
                            okText: submitter.dataset.iflConfirmOk    || 'Confirm',
                            danger: submitter.dataset.iflConfirmDanger === '1'
                        });
                        if (!ok) return;
                        form.dataset.iflConfirmed = '1';
                        reSubmit(form, submitter);
                        return;
                    }

                    // First pass — block, attach token, re-fire preserving submitter.
                    if (!form.dataset.iflTokenAttached) {
                        e.preventDefault();
                        await ensureTokenField(form);
                        form.dataset.iflTokenAttached = '1';
                        reSubmit(form, submitter);
                        return;
                    }

                    // Second pass — token attached, real submit proceeds.
                    // Disable every submit button + show spinner on the clicked
                    // one. Strip name= so the mirror field is the sole source
                    // of the action value (avoids duplicate POST keys).
                    form.querySelectorAll('button[type="submit"]').forEach(btn => {
                        if (!btn.querySelector('.ifl-btn-original')) {
                            const span = document.createElement('span');
                            span.className = 'ifl-btn-original';
                            while (btn.firstChild) span.appendChild(btn.firstChild);
                            btn.appendChild(span);
                        }
                        if (btn.name) btn.dataset.iflBtnName = btn.name;
                        btn.removeAttribute('name');
                        btn.disabled = true;
                        btn.classList.add('is-loading');
                        if (btn === submitter) {
                            const indicator = document.createElement('span');
                            indicator.className = 'ifl-btn-loading-text';
                            indicator.innerHTML = SPINNER_SVG + 'Working…';
                            btn.appendChild(indicator);
                        }
                    });

                    // Safety net: if the page hasn't navigated within 30s
                    // (server stall), restore the buttons so the user isn't
                    // permanently stuck.
                    setTimeout(() => {
                        form.querySelectorAll('button[type="submit"]').forEach(btn => {
                            if (btn.dataset.iflBtnName) { btn.setAttribute('name', btn.dataset.iflBtnName); delete btn.dataset.iflBtnName; }
                            btn.disabled = false;
                            btn.classList.remove('is-loading');
                            const ind = btn.querySelector('.ifl-btn-loading-text');
                            if (ind) ind.remove();
                        });
                        delete form.dataset.iflTokenAttached;
                        delete form.dataset.iflConfirmed;
                        const mirror = form.querySelector('input[data-ifl-action-mirror]');
                        if (mirror) mirror.remove();
                    }, 30000);
                });
            });
        });
    })();

    // ── Live AD account loader ────────────────────────────────────────────
    // Two-phase render: the card placeholder is already in the DOM; here we
    // fetch the real AD account for this request's employee and fill it in.
    // Done client-side (not at server render) so a slow adsearch.aspx round-trip
    // never blocks the form. Uses window.iflFetch so the sidecar token is
    // attached and IIS doesn't throw a Windows-auth popup.
    (function loadAdAccount() {
        const body = document.getElementById('adAccountBody');
        if (!body) return; // card only renders for DCI Manager / Implementer

        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const fmtDate = (d) => {
            if (!d) return '—';
            try { return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
            catch (_) { return '—'; }
        };
        const row = (k, v) => '<tr><td class="ad-key">' + esc(k) + '</td><td>' + v + '</td></tr>';

        const renderProfile = (p) => {
            const badgeCls = p.accountEnabled ? 'ad-badge--enabled' : 'ad-badge--disabled';
            const badge = '<span class="ad-badge ' + badgeCls + '">' + esc(p.accountStatus || (p.accountEnabled ? 'Enabled' : 'Disabled')) + '</span>';
            const groups = Array.isArray(p.groups) ? p.groups : [];
            const groupsHtml = groups.length
                ? '<div class="ad-groups">' + groups.map(g => '<span class="ad-chip">' + esc(g) + '</span>').join('') + '</div>'
                : '<span style="color:#94a3b8;">No group memberships</span>';

            let html = '<table class="ad-table">';
            html += row('Status', badge);
            html += row('Login', '<code>' + esc(p.sAMAccountName || '—') + '</code>');
            html += row('AD Email', esc(p.mail || '—'));
            if (p.upn)        html += row('UPN', esc(p.upn));
            if (p.title)      html += row('Title', esc(p.title));
            if (p.department) html += row('AD Department', esc(p.department));
            if (p.office)     html += row('AD Office', esc(p.office));
            if (p.locality)   html += row('AD City', esc(p.locality));
            if (p.phone)      html += row('Phone', esc(p.phone));
            html += row('Last Login', esc(fmtDate(p.lastLogon)));
            html += row('Account Created', esc(fmtDate(p.createdAt)));
            html += row('Groups (' + groups.length + ')', groupsHtml);
            html += '</table>';
            body.innerHTML = html;
        };

        const renderEmpty = (msg) => {
            body.innerHTML = '<div class="ad-empty"><span style="font-size:1.2rem;opacity:.5;">&#128274;</span><span>' + esc(msg) + '</span></div>';
        };

        (async () => {
            try {
                const fetcher = (typeof window.iflFetch === 'function') ? window.iflFetch : (u, o) => fetch(u, o);
                const r = await fetcher('/api/offboarding/<%= request.id %>/ad-profile');
                if (!r.ok) { renderEmpty('Could not load the AD account (HTTP ' + r.status + ').'); return; }
                const j = await r.json();
                if (j && j.found && j.profile) renderProfile(j.profile);
                else renderEmpty('No Active Directory account is linked to this Employee ID.');
            } catch (e) {
                renderEmpty('Could not reach Active Directory: ' + (e && e.message ? e.message : 'unknown error'));
            }
        })();
    })();

    // ── Proof-image validation (count / per-file / total size) ─────────────
    // Mirrors the server-side multer limits so the implementer gets immediate
    // feedback instead of a rejected POST: max 5 images, 1 MB each, 5 MB total.
    (function validateProofInput() {
        const MAX_FILES = 5, MAX_BYTES = 1 * 1024 * 1024, MAX_TOTAL = 5 * 1024 * 1024;
        const input = document.getElementById('dciProofInput');
        if (!input) return;
        input.addEventListener('change', () => {
            const files = Array.from(input.files || []);
            let msg = '';
            if (files.length > MAX_FILES) {
                msg = 'You can upload at most ' + MAX_FILES + ' images.';
            } else {
                const tooBig = files.find(f => f.size > MAX_BYTES);
                const total  = files.reduce((s, f) => s + f.size, 0);
                if (tooBig)            msg = 'Each image must be 1 MB or smaller — "' + tooBig.name + '" is too large.';
                else if (total > MAX_TOTAL) msg = 'The images combined must be 5 MB or smaller.';
            }
            input.setCustomValidity(msg);
            if (msg) input.reportValidity();
        });
    })();
</script>

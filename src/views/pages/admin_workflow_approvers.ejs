        <div class="a-toast" id="toast"></div>

        <%- include('../partials/admin_shell_bottom') %>

          <script>
            /* ================================================================
               FLOAT SUGGEST — single fixed overlay, escapes any overflow clipping
            ================================================================ */
            const FloatSuggest = (() => {
              let el, activeInput = null, focusIdx = -1, items = [];

              function init() {
                el = document.createElement('div');
                el.className = 'a-float-suggest';
                document.body.appendChild(el);
                document.addEventListener('mousedown', e => {
                  if (el.contains(e.target) || e.target === activeInput) return;
                  close();
                });
                window.addEventListener('scroll', reposition, { passive: true, capture: true });
                window.addEventListener('resize', reposition, { passive: true });
              }

              function show(inputEl, html, onItemClick) {
                activeInput = inputEl;
                el.innerHTML = html;
                focusIdx = -1;
                items = [...el.querySelectorAll('.a-suggest-item')];
                items.forEach((item, i) => {
                  item.addEventListener('mousedown', e => { e.preventDefault(); onItemClick(item, i); });
                });
                el.classList.add('open');
                reposition();
              }

              function close() {
                el.classList.remove('open');
                el.innerHTML = '';
                activeInput = null;
                focusIdx = -1;
                items = [];
              }

              function isOpen() { return el && el.classList.contains('open'); }

              function navigate(dir) {
                if (!items.length) return false;
                focusIdx = Math.max(-1, Math.min(items.length - 1, focusIdx + dir));
                items.forEach((it, i) => it.classList.toggle('a-suggest-item--focused', i === focusIdx));
                if (focusIdx >= 0) items[focusIdx].scrollIntoView({ block: 'nearest' });
                return true;
              }

              function selectFocused() {
                if (focusIdx >= 0 && items[focusIdx]) { items[focusIdx].dispatchEvent(new MouseEvent('mousedown')); return true; }
                return false;
              }

              function reposition() {
                if (!activeInput || !isOpen()) return;
                const r = activeInput.getBoundingClientRect();
                const spaceBelow = window.innerHeight - r.bottom;
                el.style.left = r.left + 'px';
                el.style.width = Math.max(r.width, 280) + 'px';
                if (spaceBelow >= 150) {
                  el.style.top = (r.bottom + 5) + 'px';
                  el.style.bottom = 'auto';
                  el.style.maxHeight = Math.min(320, spaceBelow - 12) + 'px';
                } else {
                  el.style.bottom = (window.innerHeight - r.top + 5) + 'px';
                  el.style.top = 'auto';
                  el.style.maxHeight = Math.min(320, r.top - 12) + 'px';
                }
              }

              return { init, show, close, isOpen, navigate, selectFocused };
            })();

            /* ================================================================
               HELPERS
            ================================================================ */
            function debounce(fn, ms) {
              let t;
              return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
            }

            function highlight(text, q) {
              if (!q || !text) return text || '';
              const esc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
              return String(text).replace(new RegExp(`(${esc})`, 'gi'), '<mark>$1</mark>');
            }

            function suggestLoading() {
              return '<div class="a-suggest-loading"><div class="a-spinner"></div>Searching…</div>';
            }
            function suggestEmpty(q) {
              return `<div class="a-suggest-empty">No results for "<strong>${q}</strong>"</div>`;
            }
            function adUserHTML(user, q) {
              return `<div class="a-suggest-item">
    <div class="a-suggest-item__avatar">${(user.displayName || '?').charAt(0).toUpperCase()}</div>
    <div class="a-suggest-item__body">
      <div class="a-suggest-item__name">${highlight(user.displayName, q)}</div>
      <div class="a-suggest-item__meta">
        <strong style="font-family:monospace;font-size:.8rem;">${highlight(user.sAMAccountName, q)}</strong>
        ${user.email ? ' · ' + highlight(user.email, q) : ''}
        ${user.title ? ' · ' + user.title : ''}
      </div>
    </div>
    <span class="a-suggest-item__badge" style="background:var(--a-brand-light);color:var(--a-brand);">Select</span>
  </div>`;
            }

            /* ================================================================
               APPROVER SEARCH (Primary OR Secondary slot)
            ================================================================ */
            const _approverDebouncers = {};

            async function _approverSuggestFetch(id, which, q) {
              const inpId = (which === 'primary' ? 'psearch-' : 'ssearch-') + id;
              const inp = document.getElementById(inpId);
              if (q.length < 2) { FloatSuggest.close(); return; }

              FloatSuggest.show(inp, suggestLoading(), () => { });
              try {
                const res = await window.iflFetch(`/admin/ad-search?q=${encodeURIComponent(q)}`);
                const json = await res.json();
                if (!json.success || !json.results || !json.results.length) {
                  FloatSuggest.show(inp, suggestEmpty(q), () => { });
                  return;
                }
                const html = json.results.map(u => adUserHTML(u, q)).join('');
                FloatSuggest.show(inp, html, (item, i) => {
                  const user = json.results[i];
                  const emailId = (which === 'primary' ? 'email-' : 'semail-') + id;
                  const nameId = (which === 'primary' ? 'name-' : 'sname-') + id;
                  const usernameId = (which === 'primary' ? 'username-' : 'susername-') + id;
                  const badgeId = (which === 'primary' ? 'uname-badge-' : 'suname-badge-') + id;
                  const emailBadgeId = (which === 'primary' ? 'email-badge-' : 'semail-badge-') + id;
                  const emailInp = document.getElementById(emailId);
                  const nameInp = document.getElementById(nameId);
                  const userInp = document.getElementById(usernameId);
                  const badgeEl = document.getElementById(badgeId);
                  const emailBadge = document.getElementById(emailBadgeId);
                  if (user.email && emailInp) {
                    emailInp.value = user.email;
                    emailInp.classList.remove('a-input--warn');
                    if (emailBadge) { emailBadge.className = 'uname-badge uname-badge--ok'; emailBadge.textContent = '✓ from AD'; }
                  }
                  if (user.displayName && nameInp) nameInp.value = user.displayName;
                  if (user.sAMAccountName && userInp) {
                    userInp.value = user.sAMAccountName.toLowerCase();
                    if (badgeEl) { badgeEl.className = 'uname-badge uname-badge--ok'; badgeEl.textContent = '✓ from AD'; }
                  }
                  inp.value = '';
                  FloatSuggest.close();
                  setStatus(id, 'ing', 'Unsaved changes');
                });
              } catch {
                FloatSuggest.show(inp, '<div class="a-suggest-empty" style="color:var(--a-red);">Error fetching results</div>', () => { });
              }
            }

            async function lookupAdLoginName(email, userInp, badgeEl) {
              if (!email || !userInp) return;
              if (badgeEl) { badgeEl.className = 'uname-badge uname-badge--loading'; badgeEl.textContent = 'Looking up…'; }
              try {
                const r = await window.iflFetch('/admin/ad-user?email=' + encodeURIComponent(email));
                const d = await r.json();
                if (d.found && d.sAMAccountName) {
                  userInp.value = d.sAMAccountName.toLowerCase();
                  if (badgeEl) { badgeEl.className = 'uname-badge uname-badge--ok'; badgeEl.textContent = '✓ from AD'; }
                } else {
                  if (badgeEl) { badgeEl.className = 'uname-badge uname-badge--warn'; badgeEl.textContent = '⚠ not in AD — enter manually'; }
                }
              } catch {
                if (badgeEl) { badgeEl.className = 'uname-badge uname-badge--err'; badgeEl.textContent = 'lookup failed'; }
              }
            }

            function _getDebouncer(id, which) {
              const key = `${id}-${which}`;
              if (!_approverDebouncers[key]) {
                _approverDebouncers[key] = debounce((q) => _approverSuggestFetch(id, which, q), 280);
              }
              return _approverDebouncers[key];
            }

            function onApproverSearch(id, which, val) { _getDebouncer(id, which)(val.trim()); }

            function onApproverKey(e) {
              if (e.key === 'ArrowDown') { e.preventDefault(); FloatSuggest.navigate(1); }
              else if (e.key === 'ArrowUp') { e.preventDefault(); FloatSuggest.navigate(-1); }
              else if (e.key === 'Enter') { e.preventDefault(); FloatSuggest.selectFocused(); }
              else if (e.key === 'Escape') FloatSuggest.close();
            }

            /* ================================================================
               TOGGLE / INPUT
            ================================================================ */
            function onToggle(id) {
              const cb = document.getElementById('active-' + id);
              const pill = document.getElementById('pill-' + id);
              const lbl = document.getElementById('pill-lbl-' + id);
              pill.classList.toggle('a-pill--on', cb.checked);
              lbl.textContent = cb.checked ? 'Active' : 'Inactive';
            }

            function onInput(id, el) {
              el.classList.toggle('a-input--warn', !el.value.trim());
              document.getElementById('st-' + id).textContent = '';
              const b = document.getElementById('email-badge-' + id);
              if (b) { b.className = 'uname-badge'; b.textContent = ''; }
            }

            function onSEmailInput(id, el) {
              document.getElementById('st-' + id).textContent = '';
              const b = document.getElementById('semail-badge-' + id);
              if (b) { b.className = 'uname-badge'; b.textContent = ''; }
            }

            /* ================================================================
               LOCATION-SCOPED CARDS (IT_OPS, HR_INITIATOR)
               Each card tracks its own scope independently.
            ================================================================ */
            const locScope = {};   // id → current location string ('' = Default)
            const locSnapshot = {};   // id → global values snapshot

            function snapCard(id) {
              const g = (eid) => { const el = document.getElementById(eid + id); return el ? el.value : ''; };
              const act = document.getElementById('active-' + id);
              return {
                approverEmail: g('email-'),
                approverName: g('name-'),
                approverUsername: g('username-'),
                secondaryEmail: g('semail-'),
                secondaryName: g('sname-'),
                secondaryUsername: g('susername-'),
                isActive: act ? act.checked : true
              };
            }

            function applyCardData(id, ap, { isOverride, isDefault }) {
              if (!ap) return;
              const set = (eid, val) => { const el = document.getElementById(eid + id); if (el) el.value = val || ''; };
              set('email-', ap.approverEmail);
              set('name-', ap.approverName);
              set('username-', ap.approverUsername);
              set('semail-', ap.secondaryEmail);
              set('sname-', ap.secondaryName);
              set('susername-', ap.secondaryUsername);
              const clrBadge = (bid) => { const b = document.getElementById(bid + id); if (b) { b.className = 'uname-badge'; b.textContent = ''; } };
              const setBadgeOk = (bid) => { const b = document.getElementById(bid + id); if (b) { b.className = 'uname-badge uname-badge--ok'; b.textContent = '✓ from AD'; } };
              clrBadge('uname-badge-');
              clrBadge('suname-badge-');
              clrBadge('email-badge-');
              clrBadge('semail-badge-');
              // Restore AD badges for fields that were previously verified and saved.
              if (ap.approverUsername) { setBadgeOk('uname-badge-'); if (ap.approverEmail) setBadgeOk('email-badge-'); }
              if (ap.secondaryUsername) { setBadgeOk('suname-badge-'); if (ap.secondaryEmail) setBadgeOk('semail-badge-'); }

              const act = document.getElementById('active-' + id);
              if (act && typeof ap.isActive === 'boolean') {
                act.checked = ap.isActive;
                const pill = document.getElementById('pill-' + id);
                const lbl = document.getElementById('pill-lbl-' + id);
                if (pill) pill.classList.toggle('a-pill--on', ap.isActive);
                if (lbl) lbl.textContent = ap.isActive ? 'Active' : 'Inactive';
              }

              const badge = document.getElementById('scope-' + id);
              if (badge) {
                if (isDefault) { badge.className = 'wf-scope-badge is-default'; badge.textContent = 'Default'; }
                else if (isOverride) { badge.className = 'wf-scope-badge is-override'; badge.textContent = 'Override'; }
                else { badge.className = 'wf-scope-badge is-default'; badge.textContent = 'Inherits default'; }
              }

              const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
              if (card) {
                const saveBtn = card.querySelector('.btn.btn-primary');
                if (saveBtn) saveBtn.textContent = isDefault ? 'Save' : (isOverride ? 'Update Override' : 'Save Override');

                let clearBtn = card.querySelector('.a-clear-override-btn');
                if (!isDefault && isOverride) {
                  if (!clearBtn) {
                    clearBtn = document.createElement('button');
                    clearBtn.type = 'button';
                    clearBtn.className = 'a-clear-override-btn';
                    clearBtn.textContent = 'Clear Override';
                    clearBtn.onclick = () => clearLocOverride(id, card.dataset.rolekey);
                    const st = document.getElementById('st-' + id);
                    if (st && st.parentNode) st.parentNode.insertBefore(clearBtn, st);
                  }
                } else if (clearBtn) {
                  clearBtn.remove();
                }
              }

              const emailEl = document.getElementById('email-' + id);
              if (emailEl) emailEl.classList.toggle('a-input--warn', !ap.approverEmail);
            }

            async function onLocChange(id, roleKey) {
              const sel = document.getElementById('loc-' + id);
              const location = sel ? sel.value.trim() : '';
              if (!locSnapshot[id]) locSnapshot[id] = snapCard(id);
              locScope[id] = location;
              if (!location) {
                applyCardData(id, locSnapshot[id], { isOverride: false, isDefault: true });
                return;
              }
              await loadForLocation(id, roleKey, location);
            }

            async function loadForLocation(id, roleKey, location) {
              setStatus(id, 'ing', 'Loading…');
              try {
                const r = await window.iflFetch('/admin/workflow-approvers/by-location?location=' + encodeURIComponent(location));
                const j = await r.json();
                if (!j.success || !Array.isArray(j.data)) { showToast('err', j.error || 'Load failed'); return; }
                const row = j.data.find(x => x.roleKey === roleKey);
                if (!row) { showToast('err', roleKey + ' not found for this location'); return; }
                applyCardData(id, row, { isOverride: !!row.isOverride, isDefault: false });
                setStatus(id, '', '');
              } catch (e) {
                console.error(e);
                showToast('err', 'Network error');
                setStatus(id, 'err', 'Load failed');
              }
            }

            async function saveLocCard(id, roleKey) {
              const location = locScope[id] || '';
              const email = document.getElementById('email-' + id)?.value?.trim() || '';
              const name = document.getElementById('name-' + id)?.value?.trim() || '';
              const username = document.getElementById('username-' + id)?.value?.trim().toLowerCase() || '';
              const secondaryEmail = document.getElementById('semail-' + id)?.value?.trim() || '';
              const secondaryName = document.getElementById('sname-' + id)?.value?.trim() || '';
              const secondaryUsername = document.getElementById('susername-' + id)?.value?.trim().toLowerCase() || '';
              const active = document.getElementById('active-' + id)?.checked ?? true;

              const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid email'); return; }
              if (secondaryEmail && !emailRe.test(secondaryEmail)) { setStatus(id, 'err', 'Invalid secondary email'); return; }

              const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
              const btn = card && card.querySelector('.btn.btn-primary');
              if (btn) btn.disabled = true;
              setStatus(id, 'ing', 'Saving…');

              try {
                let res;
                if (location) {
                  res = await window.iflFetch('/admin/workflow-approvers/by-location', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roleKey, location, approverEmail: email, approverName: name, approverUsername: username, secondaryEmail, secondaryName, secondaryUsername, isActive: active })
                  });
                } else {
                  res = await window.iflFetch('/admin/workflow-approvers/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ approverEmail: email || null, approverName: name || null, approverUsername: username || null, secondaryEmail: secondaryEmail || null, secondaryName: secondaryName || null, secondaryUsername: secondaryUsername || null, isActive: active })
                  });
                }
                const data = await res.json();
                if (data.success) {
                  setStatus(id, 'ok', 'Saved ✓');
                  showToast('ok', data.message || 'Saved');
                  if (location) await loadForLocation(id, roleKey, location);
                  else locSnapshot[id] = snapCard(id);
                } else {
                  setStatus(id, 'err', data.error || 'Failed');
                  showToast('err', data.error || 'Save failed');
                }
              } catch {
                setStatus(id, 'err', 'Network error');
                showToast('err', 'Network error. Please retry.');
              } finally {
                if (btn) btn.disabled = false;
              }
            }

            async function clearLocOverride(id, roleKey) {
              const location = locScope[id];
              if (!location) return;
              const ok = await IflDialog.confirm(
                `Clear the "${roleKey}" override for "${location}"? Future requests from this location will use the Default config.`,
                { title: 'Clear override', okText: 'Clear Override', danger: true }
              );
              if (!ok) return;
              try {
                const res = await window.iflFetch('/admin/workflow-approvers/by-location', {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ roleKey, location, approverEmail: '', approverName: '', approverUsername: '', secondaryEmail: '', secondaryName: '', secondaryUsername: '', isActive: true })
                });
                const data = await res.json();
                if (data.success) {
                  showToast('ok', data.message || 'Override cleared');
                  await loadForLocation(id, roleKey, location);
                } else {
                  showToast('err', data.error || 'Failed to clear');
                }
              } catch {
                showToast('err', 'Network error.');
              }
            }

            /* ================================================================
               DELEGATION CARDS (IT_HOD, DCI_MANAGER)
            ================================================================ */
            function updateDtypeNote(id, val) {
              const note = document.getElementById('dtype-note-' + id);
              if (!note) return;
              note.textContent = val === 'temporary'
                ? "Covering temporarily. Previous person's email links will show they've been delegated to this person."
                : "This person permanently holds the role. No expectation of reverting.";
            }

            async function saveDelegation(id) {
              const email = document.getElementById('email-' + id)?.value?.trim() || '';
              const name = document.getElementById('name-' + id)?.value?.trim() || '';
              const username = document.getElementById('username-' + id)?.value?.trim().toLowerCase() || '';
              const active = document.getElementById('active-' + id)?.checked ?? true;
              const dtype = document.querySelector(`input[name="dtype-${id}"]:checked`)?.value || 'permanent';

              const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid email'); return; }

              const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
              const btn = card && card.querySelector('.btn.btn-primary');
              if (btn) btn.disabled = true;
              setStatus(id, 'ing', 'Saving…');

              try {
                const res = await window.iflFetch('/admin/workflow-approvers/' + id, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    approverEmail: email || null,
                    approverName: name || null,
                    approverUsername: username || null,
                    secondaryEmail: null,
                    secondaryName: null,
                    secondaryUsername: null,
                    isActive: active,
                    delegationType: dtype
                  })
                });
                const data = await res.json();
                if (data.success) {
                  setStatus(id, 'ok', 'Updated ✓');
                  showToast('ok', data.message || 'Assignee updated');
                  document.getElementById('email-' + id)?.classList.toggle('a-input--warn', !email);
                  // Reload the card area so the temp-delegation banner and revert button appear/disappear.
                  setTimeout(() => location.reload(), 1200);
                } else {
                  setStatus(id, 'err', data.error || 'Failed');
                  showToast('err', data.error || 'Save failed');
                }
              } catch {
                setStatus(id, 'err', 'Network error');
                showToast('err', 'Network error. Please retry.');
              } finally {
                if (btn) btn.disabled = false;
              }
            }

            async function revertDelegation(id) {
              if (!confirm('Revert the temporary delegation and restore the original holder?')) return;
              setStatus(id, 'ing', 'Reverting…');
              try {
                const res = await window.iflFetch('/admin/workflow-approvers/' + id + '/revert', { method: 'PUT' });
                const data = await res.json();
                if (data.success) {
                  showToast('ok', data.message || 'Delegation reverted');
                  setTimeout(() => location.reload(), 1200);
                } else {
                  setStatus(id, 'err', data.error || 'Failed');
                  showToast('err', data.error || 'Revert failed');
                }
              } catch {
                setStatus(id, 'err', 'Network error');
                showToast('err', 'Network error. Please retry.');
              }
            }

            /* ================================================================
               2-DAY FALLBACK CARDS (DCI_TEAM, DCI_IMPLEMENTER)
            ================================================================ */
            async function saveFallback(id) {
              const email = document.getElementById('email-' + id)?.value?.trim() || '';
              const name = document.getElementById('name-' + id)?.value?.trim() || '';
              const username = document.getElementById('username-' + id)?.value?.trim().toLowerCase() || '';
              const secondaryEmail = document.getElementById('semail-' + id)?.value?.trim() || '';
              const secondaryName = document.getElementById('sname-' + id)?.value?.trim() || '';
              const secondaryUsername = document.getElementById('susername-' + id)?.value?.trim().toLowerCase() || '';
              const active = document.getElementById('active-' + id)?.checked ?? true;

              const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid primary email'); return; }
              if (secondaryEmail && !emailRe.test(secondaryEmail)) { setStatus(id, 'err', 'Invalid secondary email'); return; }

              const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
              const btn = card && card.querySelector('.btn.btn-primary');
              if (btn) btn.disabled = true;
              setStatus(id, 'ing', 'Saving…');

              try {
                const res = await window.iflFetch('/admin/workflow-approvers/' + id, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ approverEmail: email || null, approverName: name || null, approverUsername: username || null, secondaryEmail: secondaryEmail || null, secondaryName: secondaryName || null, secondaryUsername: secondaryUsername || null, isActive: active })
                });
                const data = await res.json();
                if (data.success) {
                  setStatus(id, 'ok', 'Saved ✓');
                  showToast('ok', data.message || 'Approver updated');
                  document.getElementById('email-' + id)?.classList.toggle('a-input--warn', !email);
                } else {
                  setStatus(id, 'err', data.error || 'Failed');
                  showToast('err', data.error || 'Save failed');
                }
              } catch {
                setStatus(id, 'err', 'Network error');
                showToast('err', 'Network error. Please retry.');
              } finally {
                if (btn) btn.disabled = false;
              }
            }

            /* ================================================================
               STATUS / TOAST
            ================================================================ */
            function setStatus(id, cls, txt) {
              const el = document.getElementById('st-' + id);
              if (!el) return;
              el.className = 'a-save-status' + (cls ? ' a-save-status--' + cls : '');
              el.textContent = txt;
              if (cls === 'ok') setTimeout(() => { el.textContent = ''; el.className = 'a-save-status'; }, 3500);
            }

            let _toastTimer;
            function showToast(cls, msg) {
              const t = document.getElementById('toast');
              t.className = 'a-toast a-toast--' + cls + ' a-toast--show';
              t.textContent = msg;
              clearTimeout(_toastTimer);
              _toastTimer = setTimeout(() => t.classList.remove('a-toast--show'), 3500);
            }

            document.addEventListener('DOMContentLoaded', () => {
              FloatSuggest.init();
              if (typeof initLocationChips === 'function') initLocationChips();
            });
          </script>
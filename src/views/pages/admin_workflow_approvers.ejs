<%- include('../partials/admin_shell_top', { activeTab: 'approvers' }) %>

  <!-- Page header -->
  <div class="a-page-hd">
    <h1 class="a-page-hd__title">Workflow Approver Configuration</h1>
    <p class="a-page-hd__sub">Configure approvers globally (Default) or per-location. Onboarding requests automatically use the override matching the employee's location, falling back to the global default when no override exists.</p>
  </div>

  <!-- Info banner -->
  <div class="a-banner a-banner--info">
    <span class="a-banner__icon">ℹ</span>
    <div>
      <strong>Fallback:</strong> Primary first; after 2 days, Secondary takes over.
      <strong>Cross-backup:</strong> DCI Manager ↔ IT HOD cover each other.
      <strong>Per-location:</strong> only the <em>IT Operations</em> role supports location-based overrides
      (the IT Ops user who configures services in Step 2 also handles the OPS verification in Step 12).
      All other roles (DCI Team, DCI Manager, IT HOD, DCI Implementer) are configured globally and apply
      to every location.
    </div>
  </div>

  <!-- ── Card-scoped styles for the IT-Ops location picker ─────── -->
  <style>
    .itops-loc-row {
      display: flex; align-items: center; gap: 10px;
      background: var(--a-surface-2);
      border: 1px solid var(--a-border);
      border-radius: var(--a-radius-sm);
      padding: 10px 12px;
      margin-bottom: 14px;
    }
    .itops-loc-row__label {
      font-size: .72rem; font-weight: 700; color: var(--a-text-muted);
      letter-spacing: .04em; text-transform: uppercase; flex: 0 0 auto;
    }
    .itops-loc-select {
      flex: 1; min-width: 160px;
      padding: 7px 10px;
      border: 1px solid var(--a-border); border-radius: var(--a-radius-sm);
      background: #fff; color: var(--a-text); font-size: .88rem;
    }
    .itops-loc-select:focus { outline: 2px solid var(--a-brand); outline-offset: -1px; }
    .itops-scope-badge {
      display: inline-block; font-size: .68rem; font-weight: 700;
      padding: 2px 8px; border-radius: 999px;
      text-transform: uppercase; letter-spacing: .04em;
      margin-left: 8px; flex: 0 0 auto;
    }
    .itops-scope-badge.is-override { background: #dbeafe; color: #1d4ed8; }
    .itops-scope-badge.is-default  { background: #f1f5f9; color: #64748b; }
    .a-clear-override-btn {
      background: transparent; border: 1px solid var(--a-red);
      color: var(--a-red); padding: 6px 12px;
      border-radius: var(--a-radius-sm); cursor: pointer;
      font-size: .78rem; font-weight: 600;
    }
    .a-clear-override-btn:hover { background: var(--a-red-bg); }
  </style>

  <!-- Approver cards — one per role, server-rendered with the GLOBAL config.
       The IT Operations card has an extra in-card location dropdown that
       client-side switches between Default + per-location overrides. -->
  <div class="a-approver-grid" id="approverGrid">
    <% approvers.forEach(function(ap) { %>
    <div class="a-approver-card" data-id="<%= ap.id %>" data-rolekey="<%= ap.roleKey %>">

      <!-- Card header -->
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;">
        <div>
          <div style="font-weight:700;font-size:.95rem;color:var(--a-text);margin-bottom:5px;"><%= ap.label %></div>
          <% if (ap.workflowStage) { %>
          <span class="a-stage"><%= ap.workflowStage %></span>
          <% } %>
        </div>
        <label class="a-toggle" title="Enable / disable this role">
          <input type="checkbox" id="active-<%= ap.id %>"
                 <%= ap.isActive ? 'checked' : '' %>
                 style="display:none"
                 onchange="onToggle(<%= ap.id %>)">
          <div class="a-pill <%= ap.isActive ? 'a-pill--on' : '' %>" id="pill-<%= ap.id %>"></div>
          <span class="a-toggle__text" id="pill-lbl-<%= ap.id %>"><%= ap.isActive ? 'Active' : 'Inactive' %></span>
        </label>
      </div>

      <!-- Description -->
      <% if (ap.description) { %>
      <p style="font-size:.83rem;color:var(--a-text-muted);margin:0 0 16px;line-height:1.55;"><%= ap.description %></p>
      <% } %>

      <%
      // Only the IT Operations card gets the in-card location picker.
      // Selecting a location swaps Primary/Secondary fields to that
      // location's override (or shows the global default if none exists).
      %>
      <% if (ap.roleKey === 'IT_OPS' && typeof locations !== 'undefined' && locations.length) { %>
        <div class="itops-loc-row" data-itops-card-id="<%= ap.id %>">
          <span class="itops-loc-row__label">Configure for</span>
          <select id="itops-loc-<%= ap.id %>" class="itops-loc-select"
                  onchange="onItOpsLocationChange(<%= ap.id %>)">
            <option value="">★ Default (All Locations)</option>
            <% locations.forEach(function(loc) { %>
              <option value="<%= loc %>"><%= loc %></option>
            <% }); %>
          </select>
          <span id="itops-scope-<%= ap.id %>" class="itops-scope-badge is-default">Default</span>
        </div>
      <% } %>

      <!-- ── PRIMARY ── -->
      <div class="approver-section" style="margin-bottom:14px;">
        <div class="approver-section-label" style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-weight:700;font-size:.78rem;color:var(--a-brand);text-transform:uppercase;letter-spacing:.04em;">Primary Approver</span>
          <% if (ap.primaryExpiredAt) { %>
            <span style="font-size:.7rem;background:var(--a-red-bg);color:var(--a-red);padding:2px 8px;border-radius:var(--a-radius-sm);font-weight:600;">EXPIRED</span>
          <% } %>
        </div>

        <!-- Search -->
        <div class="a-field" style="margin-bottom:8px;">
          <input type="text"
                 id="psearch-<%= ap.id %>"
                 class="a-input"
                 placeholder="🔍 Search employee directory (auto-fills primary)…"
                 autocomplete="off"
                 oninput="onApproverSearch(<%= ap.id %>, 'primary', this.value)"
                 onkeydown="onApproverKey(event)"
                 onfocus="if(this.value.trim().length>=2) _approverSuggestFetch(<%= ap.id %>, 'primary', this.value.trim())">
        </div>

        <div class="a-field-row">
          <div class="a-field" style="margin:0;">
            <label class="a-label">Primary Email</label>
            <input type="email"
                   id="email-<%= ap.id %>"
                   class="a-input <%= (!ap.approverEmail) ? 'a-input--warn' : '' %>"
                   value="<%= ap.approverEmail || '' %>"
                   placeholder="primary@company.com"
                   oninput="onInput(<%= ap.id %>, this)">
          </div>
          <div class="a-field" style="margin:0;">
            <label class="a-label">Primary Name</label>
            <input type="text"
                   id="name-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.approverName || '' %>"
                   placeholder="Team / Person Name">
          </div>
        </div>
      </div>

      <!-- ── SECONDARY ── -->
      <div class="approver-section" style="padding-top:12px;border-top:1px dashed var(--a-border);">
        <div class="approver-section-label" style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-weight:700;font-size:.78rem;color:var(--a-text-muted);text-transform:uppercase;letter-spacing:.04em;">Secondary (Fallback)</span>
          <span style="font-size:.7rem;color:var(--a-text-muted);">Activates after 2 days</span>
        </div>

        <!-- Search -->
        <div class="a-field" style="margin-bottom:8px;">
          <input type="text"
                 id="ssearch-<%= ap.id %>"
                 class="a-input"
                 placeholder="🔍 Search employee directory (auto-fills secondary)…"
                 autocomplete="off"
                 oninput="onApproverSearch(<%= ap.id %>, 'secondary', this.value)"
                 onkeydown="onApproverKey(event)"
                 onfocus="if(this.value.trim().length>=2) _approverSuggestFetch(<%= ap.id %>, 'secondary', this.value.trim())">
        </div>

        <div class="a-field-row">
          <div class="a-field" style="margin:0;">
            <label class="a-label">Secondary Email</label>
            <input type="email"
                   id="semail-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.secondaryEmail || '' %>"
                   placeholder="secondary@company.com"
                   oninput="document.getElementById('st-' + <%= ap.id %>).textContent = '';">
          </div>
          <div class="a-field" style="margin:0;">
            <label class="a-label">Secondary Name</label>
            <input type="text"
                   id="sname-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.secondaryName || '' %>"
                   placeholder="Team / Person Name">
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:14px;border-top:1px solid var(--a-border);">
        <button class="btn btn-primary" style="padding:8px 22px;" onclick="save(<%= ap.id %>)">Save</button>
        <span class="a-save-status" id="st-<%= ap.id %>"></span>
      </div>

    </div>
    <% }); %>
  </div>

<!-- Toast -->
<div class="a-toast" id="toast"></div>

<%- include('../partials/admin_shell_bottom') %>

<script>
/* ================================================================
   FLOAT SUGGEST — single fixed overlay, escapes any overflow clipping
================================================================ */
const FloatSuggest = (() => {
  let el, activeInput = null, focusIdx = -1, items = [];

  function init() {
    el = document.createElement('div');
    el.className = 'a-float-suggest';
    document.body.appendChild(el);

    document.addEventListener('mousedown', e => {
      if (el.contains(e.target) || e.target === activeInput) return;
      close();
    });

    window.addEventListener('scroll', reposition, { passive: true, capture: true });
    window.addEventListener('resize', reposition, { passive: true });
  }

  function show(inputEl, html, onItemClick) {
    activeInput = inputEl;
    el.innerHTML = html;
    focusIdx = -1;
    items = [...el.querySelectorAll('.a-suggest-item')];
    items.forEach((item, i) => {
      item.addEventListener('mousedown', e => { e.preventDefault(); onItemClick(item, i); });
    });
    el.classList.add('open');
    reposition();
  }

  function close() {
    el.classList.remove('open');
    el.innerHTML = '';
    activeInput = null;
    focusIdx = -1;
    items = [];
  }

  function isOpen() { return el && el.classList.contains('open'); }

  function navigate(dir) {
    if (!items.length) return false;
    focusIdx = Math.max(-1, Math.min(items.length - 1, focusIdx + dir));
    items.forEach((it, i) => it.classList.toggle('a-suggest-item--focused', i === focusIdx));
    if (focusIdx >= 0) items[focusIdx].scrollIntoView({ block: 'nearest' });
    return true;
  }

  function selectFocused() {
    if (focusIdx >= 0 && items[focusIdx]) { items[focusIdx].dispatchEvent(new MouseEvent('mousedown')); return true; }
    return false;
  }

  function reposition() {
    if (!activeInput || !isOpen()) return;
    const r = activeInput.getBoundingClientRect();
    const spaceBelow = window.innerHeight - r.bottom;
    el.style.left  = r.left + 'px';
    el.style.width = Math.max(r.width, 280) + 'px';
    if (spaceBelow >= 150) {
      el.style.top = (r.bottom + 5) + 'px';
      el.style.bottom = 'auto';
      el.style.maxHeight = Math.min(320, spaceBelow - 12) + 'px';
    } else {
      el.style.bottom = (window.innerHeight - r.top + 5) + 'px';
      el.style.top = 'auto';
      el.style.maxHeight = Math.min(320, r.top - 12) + 'px';
    }
  }

  return { init, show, close, isOpen, navigate, selectFocused };
})();

/* ================================================================
   HELPERS
================================================================ */
function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

function highlight(text, q) {
  if (!q || !text) return text || '';
  const esc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return String(text).replace(new RegExp(`(${esc})`, 'gi'), '<mark>$1</mark>');
}

function suggestLoading() {
  return '<div class="a-suggest-loading"><div class="a-spinner"></div>Searching…</div>';
}

function suggestEmpty(q) {
  return `<div class="a-suggest-empty">No results for "<strong>${q}</strong>"</div>`;
}

function empHTML(emp, q) {
  return `
    <div class="a-suggest-item">
      <div class="a-suggest-item__avatar">${(emp.name || '?').charAt(0).toUpperCase()}</div>
      <div class="a-suggest-item__body">
        <div class="a-suggest-item__name">${highlight(emp.name, q)}</div>
        <div class="a-suggest-item__meta">
          <strong>${emp.employeeId}</strong>
          ${emp.department ? ' · ' + highlight(emp.department, q) : ''}
          ${emp.designation ? ' · ' + emp.designation : ''}
          ${emp.email ? ' · ' + highlight(emp.email, q) : ''}
        </div>
      </div>
      <span class="a-suggest-item__badge" style="background:var(--a-brand-light);color:var(--a-brand);">Select</span>
    </div>`;
}

/* ================================================================
   APPROVER CARD SEARCH (Primary OR Secondary)
================================================================ */
const _approverDebouncers = {}; // key: `${id}-${which}`

async function _approverSuggestFetch(id, which, q) {
  const inpId = (which === 'primary' ? 'psearch-' : 'ssearch-') + id;
  const inp = document.getElementById(inpId);
  if (q.length < 2) { FloatSuggest.close(); return; }

  FloatSuggest.show(inp, suggestLoading(), () => {});
  try {
    const res  = await fetch(`/admin/employees?q=${encodeURIComponent(q)}&page=1&limit=8`);
    const json = await res.json();

    if (!json.success || !json.data.length) {
      FloatSuggest.show(inp, suggestEmpty(q), () => {});
      return;
    }

    const html = json.data.map(emp => empHTML(emp, q)).join('');

    FloatSuggest.show(inp, html, (item, i) => {
      const emp = json.data[i];
      const emailId = (which === 'primary' ? 'email-' : 'semail-') + id;
      const nameId  = (which === 'primary' ? 'name-'  : 'sname-')  + id;
      const emailInp = document.getElementById(emailId);
      const nameInp  = document.getElementById(nameId);
      if (emp.email) {
        emailInp.value = emp.email;
        emailInp.classList.remove('a-input--warn');
      }
      if (emp.name) nameInp.value = emp.name;
      inp.value = '';
      FloatSuggest.close();
      setStatus(id, 'ing', 'Unsaved changes');
    });
  } catch {
    FloatSuggest.show(inp, '<div class="a-suggest-empty" style="color:var(--a-red);">Error fetching results</div>', () => {});
  }
}

function _getDebouncer(id, which) {
  const key = `${id}-${which}`;
  if (!_approverDebouncers[key]) {
    _approverDebouncers[key] = debounce((q) => _approverSuggestFetch(id, which, q), 280);
  }
  return _approverDebouncers[key];
}

function onApproverSearch(id, which, val) {
  _getDebouncer(id, which)(val.trim());
}

function onApproverKey(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); FloatSuggest.navigate(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); FloatSuggest.navigate(-1); }
  else if (e.key === 'Enter') { e.preventDefault(); FloatSuggest.selectFocused(); }
  else if (e.key === 'Escape') FloatSuggest.close();
}

/* ================================================================
   TOGGLE / INPUT / SAVE
================================================================ */
function onToggle(id) {
  const cb   = document.getElementById('active-' + id);
  const pill = document.getElementById('pill-' + id);
  const lbl  = document.getElementById('pill-lbl-' + id);
  pill.classList.toggle('a-pill--on', cb.checked);
  lbl.textContent = cb.checked ? 'Active' : 'Inactive';
}

function onInput(id, el) {
  el.classList.toggle('a-input--warn', !el.value.trim());
  document.getElementById('st-' + id).textContent = '';
}

// ── In-card scope (IT Operations only) ─────────────────────────
// itOpsScope[id] holds the location string currently being edited for that
// IT_OPS card. Empty string === "Default" (global config). DCI/HOD/etc. cards
// don't track scope at all — they're always global.
const itOpsScope = {};
// Global-config snapshot per IT_OPS card so we can restore the defaults when
// the user flips back to "Default" without re-fetching.
const itOpsGlobalSnapshot = {};

function escapeHTML(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// Single entry-point for the Save button on every card. IT_OPS cards branch
// on the per-card scope; all other roles always save globally.
async function save(id) {
  const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
  const roleKey = card && card.dataset.rolekey;
  const scope = itOpsScope[id] || '';
  if (roleKey === 'IT_OPS' && scope) return saveItOpsOverride(id, scope);
  return saveGlobal(id);
}

async function saveGlobal(id) {
  const email          = document.getElementById('email-'  + id).value.trim();
  const name           = document.getElementById('name-'   + id).value.trim();
  const secondaryEmail = document.getElementById('semail-' + id).value.trim();
  const secondaryName  = document.getElementById('sname-'  + id).value.trim();
  const active         = document.getElementById('active-' + id).checked;
  const btn            = document.querySelector(`.a-approver-card[data-id="${id}"] .btn`);

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid primary email'); return; }
  if (secondaryEmail && !emailRe.test(secondaryEmail)) { setStatus(id, 'err', 'Invalid secondary email'); return; }

  btn.disabled = true;
  setStatus(id, 'ing', 'Saving…');

  try {
    const res = await fetch('/admin/workflow-approvers/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        approverEmail:  email || null,
        approverName:   name || null,
        secondaryEmail: secondaryEmail || null,
        secondaryName:  secondaryName || null,
        isActive: active
      })
    });
    const data = await res.json();
    if (data.success) {
      setStatus(id, 'ok', 'Saved ✓');
      showToast('ok', data.message || 'Approver updated successfully');
      document.getElementById('email-' + id).classList.toggle('a-input--warn', !email);
      // Refresh the IT-Ops global snapshot so the "Default" view is current.
      const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
      if (card && card.dataset.rolekey === 'IT_OPS') {
        itOpsGlobalSnapshot[id] = { approverEmail: email, approverName: name, secondaryEmail, secondaryName, isActive: active };
      }
    } else {
      setStatus(id, 'err', data.error || 'Failed');
      showToast('err', data.error || 'Save failed');
    }
  } catch {
    setStatus(id, 'err', 'Network error');
    showToast('err', 'Network error. Please retry.');
  } finally {
    btn.disabled = false;
  }
}

// Save an IT_OPS override for a specific location.
async function saveItOpsOverride(id, location) {
  const email          = document.getElementById('email-'  + id).value.trim();
  const name           = document.getElementById('name-'   + id).value.trim();
  const secondaryEmail = document.getElementById('semail-' + id).value.trim();
  const secondaryName  = document.getElementById('sname-'  + id).value.trim();
  const active         = document.getElementById('active-' + id).checked;
  const btn            = document.querySelector(`.a-approver-card[data-id="${id}"] .btn`);

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid primary email'); return; }
  if (secondaryEmail && !emailRe.test(secondaryEmail)) { setStatus(id, 'err', 'Invalid secondary email'); return; }

  btn.disabled = true;
  setStatus(id, 'ing', 'Saving…');

  try {
    const res = await fetch('/admin/workflow-approvers/by-location', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        roleKey: 'IT_OPS',
        location,
        approverEmail:  email,
        approverName:   name,
        secondaryEmail: secondaryEmail,
        secondaryName:  secondaryName,
        isActive: active
      })
    });
    const data = await res.json();
    if (data.success) {
      setStatus(id, 'ok', 'Saved ✓');
      showToast('ok', data.message || 'Override saved');
      // Re-load to refresh the scope badge ("Override" instead of "Inherits default").
      await loadItOpsForLocation(id, location);
    } else {
      setStatus(id, 'err', data.error || 'Failed');
      showToast('err', data.error || 'Save failed');
    }
  } catch {
    setStatus(id, 'err', 'Network error');
    showToast('err', 'Network error. Please retry.');
  } finally {
    btn.disabled = false;
  }
}

// Clear an IT_OPS override (revert this location to the global default).
async function clearItOpsOverride(id) {
  const location = itOpsScope[id];
  if (!location) return;
  const ok = await IflDialog.confirm(
    `Clear the IT Operations override for "${location}"? Future requests from this location will use the Default config.`,
    { title: 'Clear override', okText: 'Clear Override', danger: true }
  );
  if (!ok) return;
  try {
    const res = await fetch('/admin/workflow-approvers/by-location', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        roleKey: 'IT_OPS', location,
        approverEmail: '', approverName: '', secondaryEmail: '', secondaryName: '',
        isActive: true
      })
    });
    const data = await res.json();
    if (data.success) {
      showToast('ok', data.message || 'Override cleared');
      await loadItOpsForLocation(id, location);
    } else {
      showToast('err', data.error || 'Failed to clear');
    }
  } catch {
    showToast('err', 'Network error.');
  }
}

// Triggered when the in-card location dropdown changes.
async function onItOpsLocationChange(id) {
  const sel = document.getElementById('itops-loc-' + id);
  if (!sel) return;
  const location = sel.value || '';

  // Cache the global snapshot the first time we leave Default so we can
  // restore it cheaply if the user picks Default again.
  if (!itOpsGlobalSnapshot[id]) {
    itOpsGlobalSnapshot[id] = {
      approverEmail:  document.getElementById('email-'  + id).value,
      approverName:   document.getElementById('name-'   + id).value,
      secondaryEmail: document.getElementById('semail-' + id).value,
      secondaryName:  document.getElementById('sname-'  + id).value,
      isActive:       document.getElementById('active-' + id).checked
    };
  }

  itOpsScope[id] = location;

  if (!location) {
    // Default — restore the global snapshot, no fetch needed.
    applyItOpsCardData(id, itOpsGlobalSnapshot[id], { isOverride: false, isDefault: true });
    return;
  }
  await loadItOpsForLocation(id, location);
}

async function loadItOpsForLocation(id, location) {
  setStatus(id, 'ing', 'Loading…');
  try {
    const r = await fetch('/admin/workflow-approvers/by-location?location=' + encodeURIComponent(location));
    const j = await r.json();
    if (!j.success || !Array.isArray(j.data)) {
      showToast('err', j.error || 'Failed to load location config');
      return;
    }
    const itOps = j.data.find(x => x.roleKey === 'IT_OPS');
    if (!itOps) {
      showToast('err', 'IT Operations row not found in response');
      return;
    }
    applyItOpsCardData(id, itOps, { isOverride: !!itOps.isOverride, isDefault: false });
    setStatus(id, '', '');
  } catch (e) {
    console.error(e);
    showToast('err', 'Network error.');
    setStatus(id, 'err', 'Load failed');
  }
}

// Push a data object into the IT_OPS card's input fields and update its
// scope badge / save-button label / clear-button visibility.
function applyItOpsCardData(id, ap, { isOverride, isDefault }) {
  if (!ap) return;
  document.getElementById('email-'  + id).value = ap.approverEmail  || '';
  document.getElementById('name-'   + id).value = ap.approverName   || '';
  document.getElementById('semail-' + id).value = ap.secondaryEmail || '';
  document.getElementById('sname-'  + id).value = ap.secondaryName  || '';
  // Active toggle reflects the live row's state
  const active = document.getElementById('active-' + id);
  if (active && typeof ap.isActive === 'boolean') {
    active.checked = ap.isActive;
    document.getElementById('pill-' + id).classList.toggle('a-pill--on', ap.isActive);
    document.getElementById('pill-lbl-' + id).textContent = ap.isActive ? 'Active' : 'Inactive';
  }
  // Scope badge
  const badge = document.getElementById('itops-scope-' + id);
  if (badge) {
    if (isDefault) {
      badge.className = 'itops-scope-badge is-default';
      badge.textContent = 'Default';
    } else if (isOverride) {
      badge.className = 'itops-scope-badge is-override';
      badge.textContent = 'Override';
    } else {
      badge.className = 'itops-scope-badge is-default';
      badge.textContent = 'Inherits default';
    }
  }
  // Save button label + Clear-Override button
  const card = document.querySelector(`.a-approver-card[data-id="${id}"]`);
  if (card) {
    const saveBtn = card.querySelector('.btn.btn-primary');
    if (saveBtn) {
      const span = saveBtn.querySelector('.ifl-btn-original') || saveBtn;
      const txt = isDefault ? 'Save' : (isOverride ? 'Update Override' : 'Save Override');
      span.textContent = txt;
    }
    let clearBtn = card.querySelector('.a-clear-override-btn');
    if (!isDefault && isOverride) {
      if (!clearBtn) {
        const stEl = document.getElementById('st-' + id);
        clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'a-clear-override-btn';
        clearBtn.textContent = 'Clear Override';
        clearBtn.onclick = () => clearItOpsOverride(id);
        if (stEl && stEl.parentNode) stEl.parentNode.insertBefore(clearBtn, stEl);
      }
    } else if (clearBtn) {
      clearBtn.remove();
    }
  }
  // Reset the warn ring on email
  document.getElementById('email-' + id).classList.toggle('a-input--warn', !ap.approverEmail);
}

function setStatus(id, cls, txt) {
  const el = document.getElementById('st-' + id);
  el.className = 'a-save-status a-save-status--' + cls;
  el.textContent = txt;
  if (cls === 'ok') setTimeout(() => { el.textContent = ''; el.className = 'a-save-status'; }, 3500);
}

let _toastTimer;
function showToast(cls, msg) {
  const t = document.getElementById('toast');
  t.className = 'a-toast a-toast--' + cls + ' a-toast--show';
  t.textContent = msg;
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => t.classList.remove('a-toast--show'), 3500);
}

document.addEventListener('DOMContentLoaded', () => {
  FloatSuggest.init();
  initLocationChips();
});
</script>

<%- include('../partials/admin_shell_top', { activeTab: 'approvers' }) %>

  <!-- Page header -->
  <div class="a-page-hd">
    <h1 class="a-page-hd__title">Workflow Approver Configuration</h1>
    <p class="a-page-hd__sub">Set Primary & Secondary approvers for each workflow step. If Primary doesn't respond within 2 days, notifications route to Secondary automatically.</p>
  </div>

  <!-- Info banner -->
  <div class="a-banner a-banner--info">
    <span class="a-banner__icon">ℹ</span>
    <div>
      <strong>Fallback:</strong> Primary is used first. After 2 days without response, Secondary takes over and Primary is marked expired.
      <strong>Cross-backup:</strong> DCI Manager ↔ IT HOD cover each other when their own slots are blank.
      The <strong>HOD</strong> is resolved per-employee from HRMS and is not listed here.
    </div>
  </div>

  <!-- Approver cards -->
  <div class="a-approver-grid">
    <% approvers.forEach(function(ap) { %>
    <div class="a-approver-card" data-id="<%= ap.id %>">

      <!-- Card header -->
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;">
        <div>
          <div style="font-weight:700;font-size:.95rem;color:var(--a-text);margin-bottom:5px;"><%= ap.label %></div>
          <% if (ap.workflowStage) { %>
          <span class="a-stage"><%= ap.workflowStage %></span>
          <% } %>
        </div>
        <label class="a-toggle" title="Enable / disable this role">
          <input type="checkbox" id="active-<%= ap.id %>"
                 <%= ap.isActive ? 'checked' : '' %>
                 style="display:none"
                 onchange="onToggle(<%= ap.id %>)">
          <div class="a-pill <%= ap.isActive ? 'a-pill--on' : '' %>" id="pill-<%= ap.id %>"></div>
          <span class="a-toggle__text" id="pill-lbl-<%= ap.id %>"><%= ap.isActive ? 'Active' : 'Inactive' %></span>
        </label>
      </div>

      <!-- Description -->
      <% if (ap.description) { %>
      <p style="font-size:.83rem;color:var(--a-text-muted);margin:0 0 16px;line-height:1.55;"><%= ap.description %></p>
      <% } %>

      <!-- ── PRIMARY ── -->
      <div class="approver-section" style="margin-bottom:14px;">
        <div class="approver-section-label" style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-weight:700;font-size:.78rem;color:var(--a-brand);text-transform:uppercase;letter-spacing:.04em;">Primary Approver</span>
          <% if (ap.primaryExpiredAt) { %>
            <span style="font-size:.7rem;background:var(--a-red-bg);color:var(--a-red);padding:2px 8px;border-radius:var(--a-radius-sm);font-weight:600;">EXPIRED</span>
          <% } %>
        </div>

        <!-- Search -->
        <div class="a-field" style="margin-bottom:8px;">
          <input type="text"
                 id="psearch-<%= ap.id %>"
                 class="a-input"
                 placeholder="🔍 Search employee directory (auto-fills primary)…"
                 autocomplete="off"
                 oninput="onApproverSearch(<%= ap.id %>, 'primary', this.value)"
                 onkeydown="onApproverKey(event)"
                 onfocus="if(this.value.trim().length>=2) _approverSuggestFetch(<%= ap.id %>, 'primary', this.value.trim())">
        </div>

        <div class="a-field-row">
          <div class="a-field" style="margin:0;">
            <label class="a-label">Primary Email</label>
            <input type="email"
                   id="email-<%= ap.id %>"
                   class="a-input <%= (!ap.approverEmail) ? 'a-input--warn' : '' %>"
                   value="<%= ap.approverEmail || '' %>"
                   placeholder="primary@company.com"
                   oninput="onInput(<%= ap.id %>, this)">
          </div>
          <div class="a-field" style="margin:0;">
            <label class="a-label">Primary Name</label>
            <input type="text"
                   id="name-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.approverName || '' %>"
                   placeholder="Team / Person Name">
          </div>
        </div>
      </div>

      <!-- ── SECONDARY ── -->
      <div class="approver-section" style="padding-top:12px;border-top:1px dashed var(--a-border);">
        <div class="approver-section-label" style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-weight:700;font-size:.78rem;color:var(--a-text-muted);text-transform:uppercase;letter-spacing:.04em;">Secondary (Fallback)</span>
          <span style="font-size:.7rem;color:var(--a-text-muted);">Activates after 2 days</span>
        </div>

        <!-- Search -->
        <div class="a-field" style="margin-bottom:8px;">
          <input type="text"
                 id="ssearch-<%= ap.id %>"
                 class="a-input"
                 placeholder="🔍 Search employee directory (auto-fills secondary)…"
                 autocomplete="off"
                 oninput="onApproverSearch(<%= ap.id %>, 'secondary', this.value)"
                 onkeydown="onApproverKey(event)"
                 onfocus="if(this.value.trim().length>=2) _approverSuggestFetch(<%= ap.id %>, 'secondary', this.value.trim())">
        </div>

        <div class="a-field-row">
          <div class="a-field" style="margin:0;">
            <label class="a-label">Secondary Email</label>
            <input type="email"
                   id="semail-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.secondaryEmail || '' %>"
                   placeholder="secondary@company.com"
                   oninput="document.getElementById('st-' + <%= ap.id %>).textContent = '';">
          </div>
          <div class="a-field" style="margin:0;">
            <label class="a-label">Secondary Name</label>
            <input type="text"
                   id="sname-<%= ap.id %>"
                   class="a-input"
                   value="<%= ap.secondaryName || '' %>"
                   placeholder="Team / Person Name">
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:14px;border-top:1px solid var(--a-border);">
        <button class="btn btn-primary" style="padding:8px 22px;" onclick="save(<%= ap.id %>)">Save</button>
        <span class="a-save-status" id="st-<%= ap.id %>"></span>
      </div>

    </div>
    <% }); %>
  </div>

<!-- Toast -->
<div class="a-toast" id="toast"></div>

<%- include('../partials/admin_shell_bottom') %>

<script>
/* ================================================================
   FLOAT SUGGEST — single fixed overlay, escapes any overflow clipping
================================================================ */
const FloatSuggest = (() => {
  let el, activeInput = null, focusIdx = -1, items = [];

  function init() {
    el = document.createElement('div');
    el.className = 'a-float-suggest';
    document.body.appendChild(el);

    document.addEventListener('mousedown', e => {
      if (el.contains(e.target) || e.target === activeInput) return;
      close();
    });

    window.addEventListener('scroll', reposition, { passive: true, capture: true });
    window.addEventListener('resize', reposition, { passive: true });
  }

  function show(inputEl, html, onItemClick) {
    activeInput = inputEl;
    el.innerHTML = html;
    focusIdx = -1;
    items = [...el.querySelectorAll('.a-suggest-item')];
    items.forEach((item, i) => {
      item.addEventListener('mousedown', e => { e.preventDefault(); onItemClick(item, i); });
    });
    el.classList.add('open');
    reposition();
  }

  function close() {
    el.classList.remove('open');
    el.innerHTML = '';
    activeInput = null;
    focusIdx = -1;
    items = [];
  }

  function isOpen() { return el && el.classList.contains('open'); }

  function navigate(dir) {
    if (!items.length) return false;
    focusIdx = Math.max(-1, Math.min(items.length - 1, focusIdx + dir));
    items.forEach((it, i) => it.classList.toggle('a-suggest-item--focused', i === focusIdx));
    if (focusIdx >= 0) items[focusIdx].scrollIntoView({ block: 'nearest' });
    return true;
  }

  function selectFocused() {
    if (focusIdx >= 0 && items[focusIdx]) { items[focusIdx].dispatchEvent(new MouseEvent('mousedown')); return true; }
    return false;
  }

  function reposition() {
    if (!activeInput || !isOpen()) return;
    const r = activeInput.getBoundingClientRect();
    const spaceBelow = window.innerHeight - r.bottom;
    el.style.left  = r.left + 'px';
    el.style.width = Math.max(r.width, 280) + 'px';
    if (spaceBelow >= 150) {
      el.style.top = (r.bottom + 5) + 'px';
      el.style.bottom = 'auto';
      el.style.maxHeight = Math.min(320, spaceBelow - 12) + 'px';
    } else {
      el.style.bottom = (window.innerHeight - r.top + 5) + 'px';
      el.style.top = 'auto';
      el.style.maxHeight = Math.min(320, r.top - 12) + 'px';
    }
  }

  return { init, show, close, isOpen, navigate, selectFocused };
})();

/* ================================================================
   HELPERS
================================================================ */
function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

function highlight(text, q) {
  if (!q || !text) return text || '';
  const esc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return String(text).replace(new RegExp(`(${esc})`, 'gi'), '<mark>$1</mark>');
}

function suggestLoading() {
  return '<div class="a-suggest-loading"><div class="a-spinner"></div>Searching…</div>';
}

function suggestEmpty(q) {
  return `<div class="a-suggest-empty">No results for "<strong>${q}</strong>"</div>`;
}

function empHTML(emp, q) {
  return `
    <div class="a-suggest-item">
      <div class="a-suggest-item__avatar">${(emp.name || '?').charAt(0).toUpperCase()}</div>
      <div class="a-suggest-item__body">
        <div class="a-suggest-item__name">${highlight(emp.name, q)}</div>
        <div class="a-suggest-item__meta">
          <strong>${emp.employeeId}</strong>
          ${emp.department ? ' · ' + highlight(emp.department, q) : ''}
          ${emp.designation ? ' · ' + emp.designation : ''}
          ${emp.email ? ' · ' + highlight(emp.email, q) : ''}
        </div>
      </div>
      <span class="a-suggest-item__badge" style="background:var(--a-brand-light);color:var(--a-brand);">Select</span>
    </div>`;
}

/* ================================================================
   APPROVER CARD SEARCH (Primary OR Secondary)
================================================================ */
const _approverDebouncers = {}; // key: `${id}-${which}`

async function _approverSuggestFetch(id, which, q) {
  const inpId = (which === 'primary' ? 'psearch-' : 'ssearch-') + id;
  const inp = document.getElementById(inpId);
  if (q.length < 2) { FloatSuggest.close(); return; }

  FloatSuggest.show(inp, suggestLoading(), () => {});
  try {
    const res  = await fetch(`/admin/employees?q=${encodeURIComponent(q)}&page=1&limit=8`);
    const json = await res.json();

    if (!json.success || !json.data.length) {
      FloatSuggest.show(inp, suggestEmpty(q), () => {});
      return;
    }

    const html = json.data.map(emp => empHTML(emp, q)).join('');

    FloatSuggest.show(inp, html, (item, i) => {
      const emp = json.data[i];
      const emailId = (which === 'primary' ? 'email-' : 'semail-') + id;
      const nameId  = (which === 'primary' ? 'name-'  : 'sname-')  + id;
      const emailInp = document.getElementById(emailId);
      const nameInp  = document.getElementById(nameId);
      if (emp.email) {
        emailInp.value = emp.email;
        emailInp.classList.remove('a-input--warn');
      }
      if (emp.name) nameInp.value = emp.name;
      inp.value = '';
      FloatSuggest.close();
      setStatus(id, 'ing', 'Unsaved changes');
    });
  } catch {
    FloatSuggest.show(inp, '<div class="a-suggest-empty" style="color:var(--a-red);">Error fetching results</div>', () => {});
  }
}

function _getDebouncer(id, which) {
  const key = `${id}-${which}`;
  if (!_approverDebouncers[key]) {
    _approverDebouncers[key] = debounce((q) => _approverSuggestFetch(id, which, q), 280);
  }
  return _approverDebouncers[key];
}

function onApproverSearch(id, which, val) {
  _getDebouncer(id, which)(val.trim());
}

function onApproverKey(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); FloatSuggest.navigate(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); FloatSuggest.navigate(-1); }
  else if (e.key === 'Enter') { e.preventDefault(); FloatSuggest.selectFocused(); }
  else if (e.key === 'Escape') FloatSuggest.close();
}

/* ================================================================
   TOGGLE / INPUT / SAVE
================================================================ */
function onToggle(id) {
  const cb   = document.getElementById('active-' + id);
  const pill = document.getElementById('pill-' + id);
  const lbl  = document.getElementById('pill-lbl-' + id);
  pill.classList.toggle('a-pill--on', cb.checked);
  lbl.textContent = cb.checked ? 'Active' : 'Inactive';
}

function onInput(id, el) {
  el.classList.toggle('a-input--warn', !el.value.trim());
  document.getElementById('st-' + id).textContent = '';
}

async function save(id) {
  const email          = document.getElementById('email-'  + id).value.trim();
  const name           = document.getElementById('name-'   + id).value.trim();
  const secondaryEmail = document.getElementById('semail-' + id).value.trim();
  const secondaryName  = document.getElementById('sname-'  + id).value.trim();
  const active         = document.getElementById('active-' + id).checked;
  const btn            = document.querySelector(`.a-approver-card[data-id="${id}"] .btn`);

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (email && !emailRe.test(email)) { setStatus(id, 'err', 'Invalid primary email'); return; }
  if (secondaryEmail && !emailRe.test(secondaryEmail)) { setStatus(id, 'err', 'Invalid secondary email'); return; }

  btn.disabled = true;
  setStatus(id, 'ing', 'Saving…');

  try {
    const res  = await fetch('/admin/workflow-approvers/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        approverEmail:  email || null,
        approverName:   name || null,
        secondaryEmail: secondaryEmail || null,
        secondaryName:  secondaryName || null,
        isActive: active
      })
    });
    const data = await res.json();
    if (data.success) {
      setStatus(id, 'ok', 'Saved ✓');
      showToast('ok', data.message || 'Approver updated successfully');
      document.getElementById('email-' + id).classList.toggle('a-input--warn', !email);
    } else {
      setStatus(id, 'err', data.error || 'Failed');
      showToast('err', data.error || 'Save failed');
    }
  } catch {
    setStatus(id, 'err', 'Network error');
    showToast('err', 'Network error. Please retry.');
  } finally {
    btn.disabled = false;
  }
}

function setStatus(id, cls, txt) {
  const el = document.getElementById('st-' + id);
  el.className = 'a-save-status a-save-status--' + cls;
  el.textContent = txt;
  if (cls === 'ok') setTimeout(() => { el.textContent = ''; el.className = 'a-save-status'; }, 3500);
}

let _toastTimer;
function showToast(cls, msg) {
  const t = document.getElementById('toast');
  t.className = 'a-toast a-toast--' + cls + ' a-toast--show';
  t.textContent = msg;
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => t.classList.remove('a-toast--show'), 3500);
}

document.addEventListener('DOMContentLoaded', () => {
  FloatSuggest.init();
});
</script>

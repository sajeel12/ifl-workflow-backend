<%- include('../partials/admin_shell_top', { activeTab: 'approvers' }) %>

  <div class="a-page-hd">
    <h1 class="a-page-hd__title">Workflow Approver Configuration</h1>
    <p class="a-page-hd__sub">Manage who handles each stage of the onboarding workflow. Three models apply depending on
      the role.</p>
  </div>

  <div class="a-banner a-banner--info" style="margin-bottom:24px;">
    <span class="a-banner__icon">ℹ</span>
    <div style="display:flex;flex-direction:column;gap:6px;font-size:.84rem;">
      <div><strong>2-Day Fallback</strong> (IT Operations, DCI Team, DCI Implementer) — Primary handles the stage; if no
        action after 2 days, emails automatically fall to Secondary.</div>
      <div><strong>Parallel Seats</strong> (HR Initiator) — Seat A and Seat B are equal. Either person can initiate a
        request. No timer or fallback applies.</div>
      <div><strong>Delegation</strong> (IT HOD, DCI Manager) — One person holds the role at a time. When you reassign,
        the new person immediately takes over all pending portal actions. Previous email links are blocked and name the
        new delegate.</div>
    </div>
  </div>

  <style>
    .wf-section-hd {
      margin: 32px 0 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .wf-section-hd::before {
      content: '';
      flex: 0 0 3px;
      height: 20px;
      background: var(--a-brand);
      border-radius: 2px;
    }

    .wf-section-hd__title {
      font-size: .95rem;
      font-weight: 700;
      color: var(--a-text);
    }

    .wf-section-hd__sub {
      font-size: .77rem;
      color: var(--a-text-muted);
    }

    .wf-badge {
      display: inline-flex;
      align-items: center;
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      padding: 3px 9px;
      border-radius: 999px;
    }

    .wf-badge--fallback {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .wf-badge--parallel {
      background: #dcfce7;
      color: #16a34a;
    }

    .wf-badge--delegation {
      background: #fef3c7;
      color: #d97706;
    }

    .wf-loc-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--a-surface-2);
      border: 1px solid var(--a-border);
      border-radius: var(--a-radius-sm);
      padding: 8px 12px;
      margin-bottom: 14px;
    }

    .wf-loc-lbl {
      font-size: .7rem;
      font-weight: 700;
      color: var(--a-text-muted);
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .wf-loc-sel {
      flex: 1;
      min-width: 130px;
      padding: 6px 10px;
      border: 1px solid var(--a-border);
      border-radius: var(--a-radius-sm);
      background: #fff;
      color: var(--a-text);
      font-size: .85rem;
    }

    .wf-loc-sel:focus {
      outline: 2px solid var(--a-brand);
      outline-offset: -1px;
    }

    .wf-scope-badge {
      font-size: .65rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .wf-scope-badge.is-override {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .wf-scope-badge.is-default {
      background: #f1f5f9;
      color: #64748b;
    }

    .wf-callout {
      font-size: .75rem;
      color: var(--a-text-muted);
      border-radius: var(--a-radius-sm);
      padding: 8px 10px;
      margin-bottom: 12px;
      line-height: 1.45;
      border: 1px solid;
    }

    .wf-callout--green {
      background: #f0fdf4;
      border-color: #bbf7d0;
    }

    .wf-callout--yellow {
      background: #fffbeb;
      border-color: #fde68a;
    }

    .wf-callout--orange {
      background: #fff7ed;
      border-color: #fed7aa;
      color: #92400E;
    }

    .wf-revert-btn {
      background: #fff7ed;
      border: 1px solid #F97316;
      color: #C2410C;
      padding: 6px 14px;
      border-radius: var(--a-radius-sm);
      cursor: pointer;
      font-size: .78rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .wf-revert-btn:hover {
      background: #FFEDD5;
    }

    .wf-dtype-box {
      background: var(--a-surface-2);
      border: 1px solid var(--a-border);
      border-radius: var(--a-radius-sm);
      padding: 10px 12px;
      margin-bottom: 12px;
    }

    .wf-dtype-lbl {
      font-size: .7rem;
      font-weight: 700;
      color: var(--a-text-muted);
      text-transform: uppercase;
      letter-spacing: .04em;
      margin-bottom: 8px;
    }

    .wf-dtype-note {
      font-size: .73rem;
      color: var(--a-text-muted);
      margin-top: 6px;
      line-height: 1.4;
    }

    .a-clear-override-btn {
      background: transparent;
      border: 1px solid var(--a-red);
      color: var(--a-red);
      padding: 5px 12px;
      border-radius: var(--a-radius-sm);
      cursor: pointer;
      font-size: .75rem;
      font-weight: 600;
    }

    .a-clear-override-btn:hover {
      background: var(--a-red-bg);
    }

    .a-input--mono {
      font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
      font-size: .83rem;
    }

    .a-label-hint {
      font-size: .62rem;
      font-weight: 400;
      color: var(--a-text-muted);
      margin-left: 3px;
    }

    .uname-badge {
      display: inline-flex;
      align-items: center;
      font-size: .64rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .uname-badge--ok {
      background: #dcfce7;
      color: #16a34a;
    }

    .uname-badge--warn {
      background: #fef3c7;
      color: #b45309;
    }

    .uname-badge--loading {
      background: #f1f5f9;
      color: #64748b;
    }

    .uname-badge--err {
      background: #fee2e2;
      color: #dc2626;
    }
  </style>

  <% const itOps=approvers.find(a=> a.roleKey === 'IT_OPS');
    const hrInit = approvers.find(a => a.roleKey === 'HR_INITIATOR');
    const delegationKeys = ['IT_HOD', 'DCI_MANAGER', 'IT_OPS_MGR'];
    // NETWORK_VALIDATOR + NETWORK_IMPLEMENTER are the two IBR teams. Same
    // 2-day primary/secondary fallback semantics as DCI_TEAM + DCI_IMPLEMENTER,
    // so they get rendered in the same Fallback Roles section below.
    const fallbackKeys = ['DCI_TEAM', 'DCI_IMPLEMENTER', 'NETWORK_VALIDATOR', 'NETWORK_IMPLEMENTER'];
    const knownKeys = new
    Set(['IT_OPS','HR_INITIATOR','IT_HOD','DCI_MANAGER','DCI_TEAM','DCI_IMPLEMENTER','IT_OPS_MGR','NETWORK_VALIDATOR','NETWORK_IMPLEMENTER']);
    %>

    <!-- ══════════════════════════════════════════════════════════════════════
     SECTION 1 — Location-Scoped Roles
══════════════════════════════════════════════════════════════════════ -->
    <div class="wf-section-hd">
      <span class="wf-section-hd__title">Location-Scoped Roles</span>
      <span class="wf-section-hd__sub">Each location group can have its own configuration. Select a location to edit or
        leave on Default.</span>
    </div>

    <div class="a-approver-grid">

      <!-- ── IT Operations ──────────────────────────────────────────────── -->
      <% if (itOps) { %>
        <div class="a-approver-card" data-id="<%= itOps.id %>" data-rolekey="IT_OPS">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;">
            <div>
              <div style="font-weight:700;font-size:.95rem;color:var(--a-text);margin-bottom:5px;">
                <%= itOps.label %>
              </div>
              <% if (itOps.workflowStage) { %><span class="a-stage">
                  <%= itOps.workflowStage %>
                </span>
                <% } %>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="wf-badge wf-badge--fallback">2-Day Fallback</span>
              <label class="a-toggle" title="Enable / disable">
                <input type="checkbox" id="active-<%= itOps.id %>" <%=itOps.isActive ? 'checked' : '' %>
                style="display:none" onchange="onToggle(<%= itOps.id %>)">
                  <div class="a-pill <%= itOps.isActive ? 'a-pill--on' : '' %>" id="pill-<%= itOps.id %>"></div>
                  <span class="a-toggle__text" id="pill-lbl-<%= itOps.id %>">
                    <%= itOps.isActive ? 'Active' : 'Inactive' %>
                  </span>
              </label>
            </div>
          </div>
          <% if (itOps.description) { %>
            <p style="font-size:.82rem;color:var(--a-text-muted);margin:0 0 10px;line-height:1.5;">
              <%= itOps.description %>
            </p>
            <% } %>

              <div class="wf-loc-row">
                <span class="wf-loc-lbl">Location</span>
                <select id="loc-<%= itOps.id %>" class="wf-loc-sel" onchange="onLocChange('<%= itOps.id %>', 'IT_OPS')">
                  <option value="">Default (All Locations)</option>
                  <% locations.forEach(loc=> { %><option value="<%= loc %>">
                      <%= locationLabels[loc] || loc %>
                    </option>
                    <% }); %>
                </select>
                <span id="scope-<%= itOps.id %>" class="wf-scope-badge is-default">Default</span>
              </div>

              <div class="approver-section" style="margin-bottom:12px;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                  <span
                    style="font-weight:700;font-size:.75rem;color:var(--a-brand);text-transform:uppercase;letter-spacing:.04em;">Primary</span>
                  <% if (itOps.primaryExpiredAt) { %><span
                      style="font-size:.68rem;background:var(--a-red-bg);color:var(--a-red);padding:2px 7px;border-radius:var(--a-radius-sm);font-weight:600;">EXPIRED</span>
                    <% } %>
                </div>
                <div class="a-field" style="margin-bottom:6px;">
                  <input type="text" id="psearch-<%= itOps.id %>" class="a-input"
                    placeholder="Search employee directory…" autocomplete="off"
                    oninput="onApproverSearch(<%= itOps.id %>, 'primary', this.value)" onkeydown="onApproverKey(event)">
                </div>
                <div class="a-field-row">
                  <div class="a-field" style="margin:0;"><label class="a-label">Email</label>
                    <div style="display:flex;gap:5px;align-items:center;">
                      <input type="email" id="email-<%= itOps.id %>"
                        class="a-input <%= !itOps.approverEmail ? 'a-input--warn' : '' %>" style="flex:1;"
                        value="<%= itOps.approverEmail || '' %>" placeholder="primary@company.com"
                        oninput="onInput(<%= itOps.id %>, this)">
                      <span id="email-badge-<%= itOps.id %>" class="uname-badge"></span>
                    </div>
                  </div>
                  <div class="a-field" style="margin:0;"><label class="a-label">Name</label>
                    <input type="text" id="name-<%= itOps.id %>" class="a-input" value="<%= itOps.approverName || '' %>"
                      placeholder="Person name">
                  </div>
                </div>
                <div class="a-field" style="margin-top:4px;">
                  <label class="a-label">AD Login Name<span class="a-label-hint">sAMAccountName — required for portal
                      access</span></label>
                  <div style="display:flex;gap:6px;align-items:center;">
                    <input type="text" id="username-<%= itOps.id %>" class="a-input a-input--mono"
                      value="<%= itOps.approverUsername || '' %>" placeholder="e.g. first.last" autocomplete="off">
                    <span id="uname-badge-<%= itOps.id %>" class="uname-badge"></span>
                  </div>
                </div>
              </div>

              <div class="approver-section" style="padding-top:10px;border-top:1px dashed var(--a-border);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                  <span
                    style="font-weight:700;font-size:.75rem;color:var(--a-text-muted);text-transform:uppercase;letter-spacing:.04em;">Secondary</span>
                  <span style="font-size:.68rem;color:var(--a-text-muted);">Takes over after 2 days of no action</span>
                </div>
                <div class="a-field" style="margin-bottom:6px;">
                  <input type="text" id="ssearch-<%= itOps.id %>" class="a-input"
                    placeholder="Search employee directory…" autocomplete="off"
                    oninput="onApproverSearch(<%= itOps.id %>, 'secondary', this.value)"
                    onkeydown="onApproverKey(event)">
                </div>
                <div class="a-field-row">
                  <div class="a-field" style="margin:0;"><label class="a-label">Email</label>
                    <div style="display:flex;gap:5px;align-items:center;">
                      <input type="email" id="semail-<%= itOps.id %>" class="a-input" style="flex:1;"
                        value="<%= itOps.secondaryEmail || '' %>" placeholder="secondary@company.com"
                        oninput="onSEmailInput(<%= itOps.id %>, this)">
                      <span id="semail-badge-<%= itOps.id %>" class="uname-badge"></span>
                    </div>
                  </div>
                  <div class="a-field" style="margin:0;"><label class="a-label">Name</label>
                    <input type="text" id="sname-<%= itOps.id %>" class="a-input"
                      value="<%= itOps.secondaryName || '' %>" placeholder="Person name">
                  </div>
                </div>
                <div class="a-field" style="margin-top:4px;">
                  <label class="a-label">AD Login Name<span class="a-label-hint">sAMAccountName</span></label>
                  <div style="display:flex;gap:6px;align-items:center;">
                    <input type="text" id="susername-<%= itOps.id %>" class="a-input a-input--mono"
                      value="<%= itOps.secondaryUsername || '' %>" placeholder="e.g. first.last" autocomplete="off">
                    <span id="suname-badge-<%= itOps.id %>" class="uname-badge"></span>
                  </div>
                </div>
              </div>

              <div
                style="display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;border-top:1px solid var(--a-border);">
                <button class="btn btn-primary" style="padding:7px 20px;"
                  onclick="saveLocCard('<%= itOps.id %>', 'IT_OPS')">Save</button>
                <span class="a-save-status" id="st-<%= itOps.id %>"></span>
              </div>
        </div>
        <% } %>

          <!-- ── HR Initiator ────────────────────────────────────────────────── -->
          <% if (hrInit) { %>
            <div class="a-approver-card" data-id="<%= hrInit.id %>" data-rolekey="HR_INITIATOR">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;">
                <div>
                  <div style="font-weight:700;font-size:.95rem;color:var(--a-text);margin-bottom:5px;">
                    <%= hrInit.label %>
                  </div>
                  <% if (hrInit.workflowStage) { %><span class="a-stage">
                      <%= hrInit.workflowStage %>
                    </span>
                    <% } %>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span class="wf-badge wf-badge--parallel">Parallel Seats</span>
                  <label class="a-toggle" title="Enable / disable">
                    <input type="checkbox" id="active-<%= hrInit.id %>" <%=hrInit.isActive ? 'checked' : '' %>
                    style="display:none" onchange="onToggle(<%= hrInit.id %>)">
                      <div class="a-pill <%= hrInit.isActive ? 'a-pill--on' : '' %>" id="pill-<%= hrInit.id %>"></div>
                      <span class="a-toggle__text" id="pill-lbl-<%= hrInit.id %>">
                        <%= hrInit.isActive ? 'Active' : 'Inactive' %>
                      </span>
                  </label>
                </div>
              </div>

              <div class="wf-callout wf-callout--green">
                Both seats are equal — either person can independently initiate a request. No fallback timer. Both are
                blocked from initiating for an employee who already has an active workflow.
              </div>

              <div class="wf-loc-row">
                <span class="wf-loc-lbl">Location</span>
                <select id="loc-<%= hrInit.id %>" class="wf-loc-sel"
                  onchange="onLocChange('<%= hrInit.id %>', 'HR_INITIATOR')">
                  <option value="">Default (All Locations)</option>
                  <% locations.forEach(loc=> { %><option value="<%= loc %>">
                      <%= locationLabels[loc] || loc %>
                    </option>
                    <% }); %>
                </select>
                <span id="scope-<%= hrInit.id %>" class="wf-scope-badge is-default">Default</span>
              </div>

              <div class="approver-section" style="margin-bottom:12px;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                  <span
                    style="font-weight:700;font-size:.75rem;color:var(--a-brand);text-transform:uppercase;letter-spacing:.04em;">Seat
                    A</span>
                </div>
                <div class="a-field" style="margin-bottom:6px;">
                  <input type="text" id="psearch-<%= hrInit.id %>" class="a-input"
                    placeholder="Search employee directory…" autocomplete="off"
                    oninput="onApproverSearch(<%= hrInit.id %>, 'primary', this.value)"
                    onkeydown="onApproverKey(event)">
                </div>
                <div class="a-field-row">
                  <div class="a-field" style="margin:0;"><label class="a-label">Email</label>
                    <div style="display:flex;gap:5px;align-items:center;">
                      <input type="email" id="email-<%= hrInit.id %>" class="a-input" style="flex:1;"
                        value="<%= hrInit.approverEmail || '' %>" placeholder="seat-a@company.com"
                        oninput="onInput(<%= hrInit.id %>, this)">
                      <span id="email-badge-<%= hrInit.id %>" class="uname-badge"></span>
                    </div>
                  </div>
                  <div class="a-field" style="margin:0;"><label class="a-label">Name</label>
                    <input type="text" id="name-<%= hrInit.id %>" class="a-input"
                      value="<%= hrInit.approverName || '' %>" placeholder="Person name">
                  </div>
                </div>
                <div class="a-field" style="margin-top:4px;">
                  <label class="a-label">AD Login Name<span class="a-label-hint">sAMAccountName — required for portal
                      access</span></label>
                  <div style="display:flex;gap:6px;align-items:center;">
                    <input type="text" id="username-<%= hrInit.id %>" class="a-input a-input--mono"
                      value="<%= hrInit.approverUsername || '' %>" placeholder="e.g. first.last" autocomplete="off">
                    <span id="uname-badge-<%= hrInit.id %>" class="uname-badge"></span>
                  </div>
                </div>
              </div>

              <div class="approver-section" style="padding-top:10px;border-top:1px dashed var(--a-border);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                  <span
                    style="font-weight:700;font-size:.75rem;color:var(--a-text-muted);text-transform:uppercase;letter-spacing:.04em;">Seat
                    B</span>
                </div>
                <div class="a-field" style="margin-bottom:6px;">
                  <input type="text" id="ssearch-<%= hrInit.id %>" class="a-input"
                    placeholder="Search employee directory…" autocomplete="off"
                    oninput="onApproverSearch(<%= hrInit.id %>, 'secondary', this.value)"
                    onkeydown="onApproverKey(event)">
                </div>
                <div class="a-field-row">
                  <div class="a-field" style="margin:0;"><label class="a-label">Email</label>
                    <div style="display:flex;gap:5px;align-items:center;">
                      <input type="email" id="semail-<%= hrInit.id %>" class="a-input" style="flex:1;"
                        value="<%= hrInit.secondaryEmail || '' %>" placeholder="seat-b@company.com"
                        oninput="onSEmailInput(<%= hrInit.id %>, this)">
                      <span id="semail-badge-<%= hrInit.id %>" class="uname-badge"></span>
                    </div>
                  </div>
                  <div class="a-field" style="margin:0;"><label class="a-label">Name</label>
                    <input type="text" id="sname-<%= hrInit.id %>" class="a-input"
                      value="<%= hrInit.secondaryName || '' %>" placeholder="Person name">
                  </div>
                </div>
                <div class="a-field" style="margin-top:4px;">
                  <label class="a-label">AD Login Name<span class="a-label-hint">sAMAccountName</span></label>
                  <div style="display:flex;gap:6px;align-items:center;">
                    <input type="text" id="susername-<%= hrInit.id %>" class="a-input a-input--mono"
                      value="<%= hrInit.secondaryUsername || '' %>" placeholder="e.g. first.last" autocomplete="off">
                    <span id="suname-badge-<%= hrInit.id %>" class="uname-badge"></span>
                  </div>
                </div>
              </div>

              <div
                style="display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;border-top:1px solid var(--a-border);">
                <button class="btn btn-primary" style="padding:7px 20px;"
                  onclick="saveLocCard('<%= hrInit.id %>', 'HR_INITIATOR')">Save</button>
                <span class="a-save-status" id="st-<%= hrInit.id %>"></span>
              </div>
            </div>
            <% } %>

    </div><!-- /location grid -->


    <!-- ══════════════════════════════════════════════════════════════════════
     SECTION 2 — Delegation Roles
══════════════════════════════════════════════════════════════════════ -->
    <div class="wf-section-hd">
      <span class="wf-section-hd__title">Delegation Roles</span>
      <span class="wf-section-hd__sub">Single assignee. Reassigning takes effect immediately across portal and email
        links.</span>
    </div>

    <div class="a-approver-grid">
      <% approvers.filter(a=> delegationKeys.includes(a.roleKey)).forEach(ap => { %>
        <div class="a-approver-card" data-id="<%= ap.id %>" data-rolekey="<%= ap.roleKey %>">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;">
            <div>
              <div style="font-weight:700;font-size:.95rem;color:var(--a-text);margin-bottom:5px;">
                <%= ap.label %>
              </div>
              <% if (ap.workflowStage) { %><span class="a-stage">
                  <%= ap.workflowStage %>
                </span>
                <% } %>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="wf-badge wf-badge--delegation">Delegation</span>
              <label class="a-toggle" title="Enable / disable">
                <input type="checkbox" id="active-<%= ap.id %>" <%=ap.isActive ? 'checked' : '' %> style="display:none"
                onchange="onToggle(<%= ap.id %>)">
                  <div class="a-pill <%= ap.isActive ? 'a-pill--on' : '' %>" id="pill-<%= ap.id %>"></div>
                  <span class="a-toggle__text" id="pill-lbl-<%= ap.id %>">
                    <%= ap.isActive ? 'Active' : 'Inactive' %>
                  </span>
              </label>
            </div>
          </div>
          <% if (ap.description) { %>
            <p style="font-size:.82rem;color:var(--a-text-muted);margin:0 0 10px;line-height:1.5;">
              <%= ap.description %>
            </p>
            <% } %>

              <% if (ap.isDelegatedTemporarily && ap.previousApproverEmail) { %>
                <div class="wf-callout wf-callout--orange"
                  style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
                  <div>
                    <strong>Temporarily delegated.</strong>

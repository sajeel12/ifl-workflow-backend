<%- include('../partials/admin_shell_top', { activeTab: 'history' }) %>

  <!-- Page header -->
  <div class="a-page-hd">
    <h1 class="a-page-hd__title">Onboarding History & Timeline</h1>
    <p class="a-page-hd__sub">View detailed onboarding workflow history and timeline for each employee.</p>
  </div>

  <!-- Main Content Card -->
  <div class="a-card">
    <!-- Search & Filter Section -->
    <div class="a-card__body" style="padding:20px; border-bottom:1px solid var(--a-border); background:var(--a-surface-2);">
      <div style="display:grid;grid-template-columns:1fr 180px;gap:16px;align-items:flex-end;">
        <div>
          <label class="a-label">Search Requests</label>
          <div style="position:relative;">
            <input type="text" id="searchInput" class="a-input" placeholder="Search by name, ID or department..." oninput="onSearchChange()" style="padding-left:38px;">
            <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--a-text-faint);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>
        <div>
          <label class="a-label">Status Filter</label>
          <select id="statusFilter" class="a-input" onchange="onFilterChange()">
            <option value="">All Statuses</option>
            <option value="Draft">Draft</option>
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
            <option value="Rejected">Rejected</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="a-card__hd" style="background:#fff; border-bottom:1px solid var(--a-border); padding:12px 20px;">
      <h3 class="a-card__title" style="font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--a-text-muted);">Request History</h3>
    </div>
    <div class="a-card__body" style="padding:0;">
      <div id="requestsList">
        <div style="text-align:center;padding:60px;color:var(--a-text-muted);">
          <div style="font-size:2rem;margin-bottom:10px;opacity:0.3;">⏳</div>
          Loading requests…
        </div>
      </div>
    </div>
  </div>

  <!-- Timeline Details Modal -->
  <div class="modal-overlay" id="timelineModal">
    <div class="modal a-modal--lg" style="max-width:800px;">
      <div class="modal-header">
        <div>
          <h2 id="modalTitle">Onboarding Timeline</h2>
          <p style="margin:4px 0 0;color:var(--a-text-muted);font-size:.85rem;" id="modalSubtitle"></p>
        </div>
        <button class="close-btn" onclick="closeModal()">×</button>
      </div>

      <!-- Admin Recovery Actions Bar -->
      <div id="adminActionsBar" style="display:none; padding:12px 24px; border-bottom:1px solid var(--a-border); background:#fffbeb; gap:10px; align-items:center; flex-wrap:wrap;">
        <div style="flex:1; min-width:240px;">
          <div style="font-size:.8rem; font-weight:600; color:#854d0e; margin-bottom:2px;">Recovery Action</div>
          <div style="font-size:.75rem; color:#a16207;" id="adminActionsHint">If the original recipient deleted their action email, re-send it using the same token.</div>
        </div>
        <input type="email" id="resendOverrideEmail" class="a-input" placeholder="Override email (optional)" style="max-width:240px;">
        <button id="btnResendEmail" class="a-btn" style="background:#0078D4; color:#fff; border:none; padding:8px 14px; border-radius:6px; cursor:pointer; font-weight:600;" onclick="resendStageEmail()">
          ✉ Resend Action Email
        </button>
      </div>

      <div style="padding:24px;">
        <div id="timelineContainer" style="position:relative;padding:12px 0;"></div>
      </div>
    </div>
  </div>

<%- include('../partials/admin_shell_bottom') %>

<style>
.request-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px;
  border-bottom:1px solid var(--a-border);
  cursor:pointer;
  transition:background 0.15s ease;
}

.request-row:hover {
  background:var(--a-bg-hover);
}

.request-row:last-child {
  border-bottom:none;
}

.request-info {
  flex:1;
  min-width:0;
}

.request-name {
  font-weight:600;
  font-size:.95rem;
  color:var(--a-text);
  margin-bottom:4px;
}

.request-meta {
  font-size:.8rem;
  color:var(--a-text-muted);
  display:flex;
  gap:12px;
}

.request-badge {
  display:inline-block;
  padding:4px 8px;
  border-radius:var(--a-radius-sm);
  font-size:.75rem;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.03em;
}

.request-badge.draft {
  background:#f0f0f0;
  color:#666;
}

.request-badge.pending {
  background:#fff3cd;
  color:#856404;
}

.request-badge.completed {
  background:var(--a-green-bg);
  color:var(--a-green);
}

.request-badge.rejected {
  background:var(--a-red-bg);
  color:var(--a-red);
}

/* Timeline styles — matched to the user-facing /history page */
#timelineContainer .timeline-item {
  position: relative;
  padding-left: 40px;
  padding-bottom: 24px;
  border-left: 2px solid #e2e8f0;
  margin-left: 12px;
}
#timelineContainer .timeline-item:last-child {
  border-left-color: transparent;
  padding-bottom: 0;
}
#timelineContainer .timeline-dot {
  position: absolute;
  left: -11px;
  top: 0;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #3b82f6;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 700;
  box-shadow: 0 0 0 4px #fff;
}
#timelineContainer .timeline-dot.approved { background: #16a34a; }
#timelineContainer .timeline-dot.rejected { background: #dc2626; }
#timelineContainer .timeline-dot.email    { background: #0078D4; }
#timelineContainer .timeline-dot.system   { background: #64748b; }

#timelineContainer .timeline-action {
  font-weight: 600;
  font-size: 0.95rem;
  color: #0f172a;
  margin-bottom: 2px;
}
#timelineContainer .timeline-meta {
  font-size: 0.8rem;
  color: #64748b;
  margin-bottom: 8px;
}
#timelineContainer .timeline-details {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 10px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  color: #334155;
  word-break: break-word;
}
#timelineContainer .timeline-details strong { color: #475569; font-weight: 600; }
</style>

<script>
let currentPage = 1;
let totalPages = 1;
let allRequests = [];

document.addEventListener('DOMContentLoaded', () => {
  loadRequests();
});

function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

const debouncedLoad = debounce(() => loadRequests(1), 300);

function onSearchChange() {
  debouncedLoad();
}

function onFilterChange() {
  loadRequests(1);
}

async function loadRequests(page = 1) {
  const search = document.getElementById('searchInput').value.trim();
  const status = document.getElementById('statusFilter').value;

  const params = new URLSearchParams({
    page,
    limit: 15,
    ...(search && { search }),
    ...(status && { status })
  });

  try {
    const res = await fetch(`/admin/onboarding-requests?${params}`);
    const json = await res.json();

    if (!json.success || !json.data.length) {
      document.getElementById('requestsList').innerHTML = '<div style="text-align:center;padding:40px;color:var(--a-text-muted);">No onboarding requests found.</div>';
      return;
    }

    allRequests = json.data;
    currentPage = json.pagination.page;
    totalPages = json.pagination.totalPages;

    renderRequests(json.data);
  } catch (e) {
    console.error(e);
    document.getElementById('requestsList').innerHTML = '<div style="text-align:center;padding:40px;color:var(--a-red);">Error loading requests</div>';
  }
}

function renderRequests(requests) {
  const html = requests.map(req => {
    const statusClass = req.status.toLowerCase();
    const empInfo = `${req.employeeId} · ${req.department}`;
    return `
      <div class="request-row" onclick="loadTimeline(${req.id}, '${req.fullName}', '${req.employeeId}')">
        <div class="request-info">
          <div class="request-name">${req.fullName}</div>
          <div class="request-meta">
            <span>${empInfo}</span>
            <span>${req.designation || '—'}</span>
            <span style="color:var(--a-text-muted);">${new Date(req.createdAt).toLocaleDateString()}</span>
          </div>
        </div>
        <span class="request-badge ${statusClass}">${req.status}</span>
      </div>`;
  }).join('');

  document.getElementById('requestsList').innerHTML = html;
}

// Track the request currently shown in the modal so the resend button knows its target
let currentModalRequestId = null;
let currentModalStatus = null;

async function loadTimeline(id, name, empId) {
  try {
    const res = await fetch(`/admin/onboarding-timeline/${id}`);
    const json = await res.json();

    if (!json.success) {
      IflDialog.error('Could not load the timeline for this request.');
      return;
    }

    const { request, timeline } = json;
    currentModalRequestId = request.id;
    currentModalStatus = request.status;

    document.getElementById('modalTitle').textContent = `${request.fullName}`;
    document.getElementById('modalSubtitle').textContent = `Employee ID: ${request.employeeId} · Department: ${request.department} · Status: ${request.status}`;

    // Show recovery bar only when the request is still in an active (token-bearing) stage
    const closedStates = ['Completed', 'Rejected', 'Draft'];
    const bar = document.getElementById('adminActionsBar');
    if (bar) {
      const canResend = !closedStates.includes(request.status);
      bar.style.display = canResend ? 'flex' : 'none';
      const hint = document.getElementById('adminActionsHint');
      if (hint) {
        hint.textContent = canResend
          ? `Stage: ${request.status}. The original action email can be re-sent — the existing token will be reused.`
          : `Request is ${request.status}; no active stage email to resend.`;
      }
    }

    renderTimeline(timeline, request);
    openModal();
  } catch (e) {
    console.error(e);
    IflDialog.error('Could not load the timeline for this request.');
  }
}

async function resendStageEmail() {
  if (!currentModalRequestId) return;
  const btn = document.getElementById('btnResendEmail');
  const overrideEl = document.getElementById('resendOverrideEmail');
  const overrideEmail = overrideEl ? overrideEl.value.trim() : '';
  const original = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = 'Sending…'; }

  try {
    const res = await fetch(`/admin/onboarding/${currentModalRequestId}/resend-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(overrideEmail ? { toEmail: overrideEmail } : {})
    });
    const json = await res.json();
    if (!res.ok || !json.success) {
      IflDialog.error(json.error || 'Failed to resend email.');
      return;
    }
    IflDialog.success(json.message || 'Action email re-sent successfully.');
    if (overrideEl) overrideEl.value = '';
    // Refresh the modal so the new "Email Regenerated" timeline event appears
    await loadTimeline(currentModalRequestId);
  } catch (e) {
    console.error(e);
    IflDialog.error('Network error while resending email.');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = original; }
  }
}

function renderTimeline(events, request) {
  const container = document.getElementById('timelineContainer');
  if (!events || !events.length) {
    container.innerHTML = '<div style="text-align:center;color:var(--a-text-muted);padding:20px;">No timeline events yet.</div>';
    return;
  }

  // Deduplicate legacy double-logged events (same action and actor within 5 seconds)
  const deduped = [];
  events.forEach(ev => {
    const last = deduped[deduped.length - 1];
    if (last && last.action === ev.action && last.actorRole === ev.actorRole) {
      const diff = Math.abs(new Date(ev.timestamp) - new Date(last.timestamp));
      if (diff < 5000) return;
    }
    deduped.push(ev);
  });

  const html = deduped.map((ev, i) => {
    const action = ev.action || '';
    const a = action.toLowerCase();
    let cls = '';
    if (a.includes('reject')) cls = 'rejected';
    else if (a.includes('approve') || a === 'completed' || a.includes('completed')) cls = 'approved';
    else if (a.includes('email')) cls = 'email';
    else if (ev.actorRole === 'System' || ev.actorRole === 'Admin') cls = 'system';

    const label = ev.actionLabel || ev.action || '';
    const time = new Date(ev.timestamp).toLocaleString();
    // Server-supplied detailsHTML already has SVG icons + value pills baked in
    const detailsBlock = ev.detailsHTML
      ? `<div class="timeline-details">${ev.detailsHTML}</div>`
      : '';

    return `
      <div class="timeline-item">
        <div class="timeline-dot ${cls}">${i + 1}</div>
        <div class="timeline-action">${escapeHtml(label)}</div>
        <div class="timeline-meta">By <strong>${escapeHtml(ev.actorRole || '—')}</strong> · ${time}</div>
        ${detailsBlock}
      </div>`;
  }).join('');

  container.innerHTML = html;
}

function escapeHtml(text) {
  const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
  return text.replace(/[&<>"']/g, m => map[m]);
}

function openModal() {
  document.getElementById('timelineModal').classList.add('active');
}

function closeModal() {
  document.getElementById('timelineModal').classList.remove('active');
}
</script>

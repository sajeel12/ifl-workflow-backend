<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/modern.css">
<header class="app-header">
    <div class="brand-section">
        <img src="/logo.png" alt="IFL Logo" class="logo" onerror="this.style.display='none'">
        <div class="app-title">
            <h1>Ibrahim Fibres Limited</h1>
            <p>Workflow System</p>
        </div>
    </div>
</header>

<%# Message page is reused for post-submit success + error screens. When the
    controller passes showPortal/roleKey/roleLabel, the include below renders
    the role-portal sidebar; otherwise the partial renders nothing. %>
<%- include('../partials/portal_shell') %>

<style>
    /* Resulting-status panel — shows what the request just transitioned to
       and who currently owns it. Mirrors the client's nomenclature table. */
    .next-stage-card {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 18px 20px;
        margin: 24px auto 0;
        max-width: 480px;
        text-align: left;
    }
    .next-stage-card .nsc-label {
        font-size: 0.72rem; font-weight: 700; color: #64748B;
        letter-spacing: 0.06em; text-transform: uppercase;
    }
    .next-stage-card .nsc-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 0; border-bottom: 1px solid #E2E8F0;
    }
    .next-stage-card .nsc-row:last-child { border-bottom: none; }
    .next-stage-card .nsc-value { font-weight: 600; color: #0F172A; font-size: 0.95rem; }

    .nsc-pill {
        display: inline-block; padding: 4px 12px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em;
    }
    .nsc-pill--warning { background: #FEF3C7; color: #B45309; }
    .nsc-pill--success { background: #DCFCE7; color: #15803D; }
    .nsc-pill--danger  { background: #FEE2E2; color: #B91C1C; }
    .nsc-pill--info    { background: #DBEAFE; color: #1D4ED8; }
    .nsc-pill--default { background: #F1F5F9; color: #475569; }
</style>

<div class="message-container">
    <% if (locals.icon) { %>
        <div class="message-icon <%= locals.iconClass ? iconClass : '' %>"><%- icon %></div>
    <% } %>

    <h2 class="message-title <%= locals.titleClass ? titleClass : '' %>">
        <%= heading %>
    </h2>
    <p class="message-text"><%- message %></p>

    <%
    // Resulting-status panel: shows the new status + the role that now owns
    // the request. Driven by `locals.nextStatus` and `locals.nextOwner` so
    // any controller call can pass these to surface the "what's next" info.
    %>
    <% if (locals.nextStatus) { %>
        <div class="next-stage-card">
            <div class="nsc-row">
                <span class="nsc-label">Resulting Status</span>
                <span class="nsc-pill nsc-pill--<%= locals.nextStatusColor || 'info' %>">
                    <%= locals.nextStatus %>
                </span>
            </div>
            <% if (locals.nextOwner) { %>
                <div class="nsc-row">
                    <span class="nsc-label">Currently With</span>
                    <span class="nsc-value"><%= locals.nextOwner %></span>
                </div>
            <% } %>
            <% if (locals.requestRef) { %>
                <div class="nsc-row">
                    <span class="nsc-label">Request</span>
                    <span class="nsc-value">#<%= locals.requestRef %></span>
                </div>
            <% } %>
        </div>
    <% } %>

    <% if (locals.metaHtml) { %>
        <%- metaHtml %>
    <% } %>

    <% if (locals.roleKey) {
        const slugMap = {
            HR_INITIATOR: 'hr-initiator',
            IT_OPS: 'it-ops', DCI_TEAM: 'dci-team', DCI_MANAGER: 'dci-manager',
            IT_HOD: 'it-hod', DCI_IMPLEMENTER: 'dci-implementer'
        };
        const portalSlug = slugMap[locals.roleKey];
    %>
    <% if (portalSlug) {
        const portalBackUrl = locals.portalToken
            ? '/portal/' + portalSlug + '/view?token=' + locals.portalToken
            : '/portal/' + portalSlug;
    %>
    <div style="margin-top:28px;text-align:center;">
        <a href="<%= portalBackUrl %>"
           style="display:inline-flex;align-items:center;gap:8px;
                  padding:11px 24px;background:#0078D4;color:#fff;
                  border-radius:8px;font-size:0.92rem;font-weight:600;
                  text-decoration:none;">
            &#8592; Return to <%= locals.roleLabel %> Portal
        </a>
        <% if (locals.titleClass === 'success') { %>
        <p id="ar-msg" style="font-size:0.8rem;color:#64748b;margin-top:10px;">
            Returning automatically in <span id="ar-countdown">10</span>s &nbsp;
            <a id="ar-cancel" href="#"
               style="color:#94a3b8;font-size:0.78rem;text-decoration:underline;">Cancel</a>
        </p>
        <script>
        (function () {
            var target  = '<%- portalBackUrl %>';
            var secs    = 10;
            var display = document.getElementById('ar-countdown');
            var msg     = document.getElementById('ar-msg');
            var cancel  = document.getElementById('ar-cancel');
            var timer   = setInterval(function () {
                secs--;
                if (display) display.textContent = secs;
                if (secs <= 0) { clearInterval(timer); window.location.replace(target); }
            }, 1000);
            if (cancel) {
                cancel.addEventListener('click', function (e) {
                    e.preventDefault();
                    clearInterval(timer);
                    if (msg) msg.style.display = 'none';
                });
            }
        })();
        </script>
        <% } %>
        <% if (!locals.portalToken) { %>
        <p style="font-size:0.78rem;color:#94a3b8;margin-top:10px;">
            You may need to sign in again on the next page.
        </p>
        <% } %>
    </div>
    <% } %>
    <% } %>
</div>

<%- include('../partials/portal_close') %>
<%- include('../partials/portal_scripts') %>
<%- include('../partials/footer') %>

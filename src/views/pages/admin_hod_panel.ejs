<%- include('../partials/admin_shell_top', { activeTab: 'hod' }) %>

  <!-- Page header -->
  <div class="a-page-hd a-page-hd--row">
    <div>
      <h1 class="a-page-hd__title">HOD Assignment</h1>
      <p class="a-page-hd__sub">Manage Head of Department assignments for individual employees or entire departments.</p>
    </div>
    <span class="a-chip" id="stats">Loading…</span>
  </div>

  <!-- Main card -->
  <div class="a-card">
    <div class="a-card__hd">
      <div class="a-tabs" style="border:none;margin:0;flex:1;">
        <button id="tab-individual" class="a-tab a-tab--active" onclick="switchTab('individual')">Individual Employees</button>
        <button id="tab-department" class="a-tab" onclick="switchTab('department')">By Department (Bulk)</button>
      </div>
    </div>

    <div class="a-card__body">

      <!-- ── Individual View ── -->
      <div id="view-individual">
        <div class="a-search" style="flex-wrap:wrap;">
          <!-- Main search: no wrapper div needed, FloatSuggest handles positioning -->
          <input type="text" id="searchInput" class="a-input"
                 placeholder="Search employees by name, ID, department or email…"
                 autocomplete="off"
                 oninput="onMainSearch(this.value)"
                 onkeydown="onMainKey(event)"
                 onfocus="if(!FloatSuggest.isOpen() && this.value.trim().length>=2) _mainSuggestFetch(this.value.trim())">
          <button class="btn btn-secondary" onclick="clearMainSearch()">Clear</button>
          <button class="btn btn-primary"   onclick="loadEmployees(1)">Search</button>
          <div style="display:flex;align-items:center;gap:6px;margin-left:auto;">
            <label style="font-size:.78rem;font-weight:600;color:var(--a-text-muted);white-space:nowrap;">Show</label>
            <select id="pageSizeSelect" class="a-input" style="width:auto;min-width:70px;padding:7px 10px;" onchange="onPageSizeChange()">
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
            <label style="font-size:.78rem;font-weight:600;color:var(--a-text-muted);white-space:nowrap;">per page</label>
          </div>
        </div>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Location</th><th>Email</th><th>HOD Status</th><th>Actions</th>
              </tr>
            </thead>
            <tbody id="employeeTableBody">
              <tr><td colspan="8" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading employees…</td></tr>
            </tbody>
          </table>
        </div>

        <div class="pagination-container">
          <div id="paginationInfo">Showing 0 of 0 employees</div>
          <div class="pagination-buttons" id="paginationButtons"></div>
        </div>
      </div>

      <!-- ── Department View ── -->
      <div id="view-department" style="display:none;">
        <div class="a-search">
          <input type="text" id="deptSearchInput" class="a-input"
                 placeholder="Search departments by name or HOD…"
                 autocomplete="off"
                 oninput="onDeptSearch(this.value)">
          <button class="btn btn-secondary" onclick="clearDeptSearch()">Clear</button>
        </div>

        <div class="table-container">
          <table>
            <thead>
              <tr><th>Department</th><th>Total Employees</th><th>Current HOD</th><th>Action</th></tr>
            </thead>
            <tbody id="departmentTableBody">
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading departments…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

<!-- ── Assign HOD Modal ── -->
<div class="modal-overlay" id="assignModal">
  <div class="modal">
    <div class="modal-header">
      <h2>Assign HOD</h2>
      <button class="close-btn" onclick="closeModal()">×</button>
    </div>
    <div style="padding:24px;">
      <div class="a-selected-box" style="margin-bottom:20px;">
        <div style="font-size:.72rem;font-weight:700;color:var(--a-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Assigning HOD for</div>
        <div style="font-weight:700;font-size:1rem;" id="targetEmployeeName"></div>
        <div style="font-size:.8rem;color:var(--a-text-muted);" id="targetEmployeeInfo"></div>
      </div>

      <div class="a-field">
        <label class="a-label">Search for HOD</label>
        <!-- No wrapper div — FloatSuggest appends to body, positions via getBoundingClientRect -->
        <input type="text" id="hodSearchInput" class="a-input"
               placeholder="Type name, ID or email…"
               autocomplete="off"
               oninput="onHodSearch(this.value)"
               onkeydown="onHodKey(event)">
      </div>

      <!-- Selected HOD confirmation card -->
      <div id="selectedHodCard"
           style="display:none;margin-top:14px;padding:12px 14px;background:var(--a-brand-light);border:1px solid var(--a-brand-mid);border-radius:var(--a-radius-sm);align-items:center;gap:12px;">
        <div class="a-avatar" id="selectedHodAvatar" style="width:36px;height:36px;font-size:.9rem;flex-shrink:0;"></div>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:700;font-size:.9rem;" id="selectedHodName"></div>
          <div style="font-size:.78rem;color:var(--a-brand);" id="selectedHodMeta"></div>
        </div>
        <button type="button" onclick="clearHodSelection()"
                style="background:none;border:none;color:var(--a-text-muted);cursor:pointer;font-size:1.1rem;line-height:1;flex-shrink:0;">×</button>
      </div>

      <form id="assignForm" onsubmit="submitAssignment(event)"
            style="display:none;margin-top:18px;padding-top:16px;border-top:1px solid var(--a-border);">
        <input type="hidden" id="selectedEmpId">
        <input type="hidden" id="selectedHodId">
        <div style="display:flex;gap:10px;justify-content:flex-end;">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary" id="btnConfirmAssign">Confirm Assignment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ── Employee Details Modal ── -->
<div class="modal-overlay" id="detailsModal">
  <div class="modal a-modal--lg" style="max-width:720px;">
    <div class="modal-header">
      <h2>Employee Details</h2>
      <div style="display:flex;gap:8px;align-items:center;">
        <button class="btn btn-primary" id="btnEditToggle" onclick="toggleEditMode()" style="font-size:.8rem;padding:6px 14px;">Edit</button>
        <button class="close-btn" onclick="closeDetailsModal()">×</button>
      </div>
    </div>
    <div style="padding:24px;">
      <form id="editEmployeeForm" onsubmit="saveEmployeeDetails(event)">
        <input type="hidden" id="editEmployeeId">
        <div id="detailsContent" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:.9rem;">Loading…</div>
        <div id="editActions" style="margin-top:20px;display:none;gap:10px;justify-content:flex-end;">
          <button type="button" class="btn btn-secondary" onclick="closeDetailsModal()">Cancel</button>
          <button type="submit" class="btn btn-primary" id="btnSaveDetails">Save Changes</button>
        </div>
      </form>
      <div id="viewActions" style="margin-top:20px;text-align:right;">
        <button class="btn btn-secondary" onclick="closeDetailsModal()">Close</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin_shell_bottom') %>

<script>
/* ================================================================
   FLOAT SUGGEST — single fixed overlay appended to <body>
   Escapes any modal / overflow clipping
================================================================ */
const FloatSuggest = (() => {
  let el, activeInput = null, focusIdx = -1, items = [];

  function init() {
    el = document.createElement('div');
    el.className = 'a-float-suggest';
    document.body.appendChild(el);

    document.addEventListener('mousedown', e => {
      if (el.contains(e.target) || e.target === activeInput) return;
      close();
    });

    // Reposition on any scroll in any ancestor
    window.addEventListener('scroll', reposition, { passive: true, capture: true });
    window.addEventListener('resize', reposition, { passive: true });
  }

  function show(inputEl, html, onItemClick) {
    activeInput = inputEl;
    el.innerHTML = html;
    focusIdx = -1;
    items = [...el.querySelectorAll('.a-suggest-item')];
    items.forEach((item, i) => {
      item.addEventListener('mousedown', e => { e.preventDefault(); onItemClick(item, i); });
    });
    el.classList.add('open');
    reposition();
  }

  function close() {
    el.classList.remove('open');
    el.innerHTML = '';
    activeInput = null;
    focusIdx = -1;
    items = [];
  }

  function isOpen() { return el && el.classList.contains('open'); }

  function navigate(dir) {
    if (!items.length) return false;
    focusIdx = Math.max(-1, Math.min(items.length - 1, focusIdx + dir));
    items.forEach((it, i) => it.classList.toggle('a-suggest-item--focused', i === focusIdx));
    if (focusIdx >= 0) items[focusIdx].scrollIntoView({ block: 'nearest' });
    return true;
  }

  function selectFocused() {
    if (focusIdx >= 0 && items[focusIdx]) { items[focusIdx].dispatchEvent(new MouseEvent('mousedown')); return true; }
    return false;
  }

  function reposition() {
    if (!activeInput || !isOpen()) return;
    const r = activeInput.getBoundingClientRect();
    const spaceBelow = window.innerHeight - r.bottom;

    el.style.left  = r.left + 'px';
    el.style.width = Math.max(r.width, 260) + 'px';

    if (spaceBelow >= 150) {
      el.style.top    = (r.bottom + 5) + 'px';
      el.style.bottom = 'auto';
      el.style.maxHeight = Math.min(320, spaceBelow - 12) + 'px';
    } else {
      const spaceAbove = r.top;
      el.style.bottom = (window.innerHeight - r.top + 5) + 'px';
      el.style.top    = 'auto';
      el.style.maxHeight = Math.min(320, spaceAbove - 12) + 'px';
    }
  }

  return { init, show, close, isOpen, navigate, selectFocused };
})();

/* ================================================================
   HELPERS
================================================================ */
function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

function highlight(text, q) {
  if (!q || !text) return text || '';
  const esc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return String(text).replace(new RegExp(`(${esc})`, 'gi'), '<mark>$1</mark>');
}

function suggestLoading() {
  return '<div class="a-suggest-loading"><div class="a-spinner"></div>Searching…</div>';
}

function suggestEmpty(q) {
  return `<div class="a-suggest-empty">No results for "<strong>${q}</strong>"</div>`;
}

function empHTML(emp, q, badgeHTML) {
  return `
    <div class="a-suggest-item">
      <div class="a-suggest-item__avatar">${(emp.name||'?').charAt(0).toUpperCase()}</div>
      <div class="a-suggest-item__body">
        <div class="a-suggest-item__name">${highlight(emp.name, q)}</div>
        <div class="a-suggest-item__meta">
          <strong>${emp.employeeId}</strong>
          ${emp.department ? ' · ' + highlight(emp.department, q) : ''}
          ${emp.designation ? ' · ' + emp.designation : ''}
          ${emp.email ? ' · ' + highlight(emp.email, q) : ''}
        </div>
      </div>
      ${badgeHTML || ''}
    </div>`;
}

/* ================================================================
   STATE
================================================================ */
let currentEmployees = [];
let pagination = { page: 1, limit: 10, total: 0, totalPages: 0 };
let isDepartmentView = false;
let currentDepartments = [];
let assignmentContext = { type: 'individual', targetId: null };
let currentViewedEmployee = null;
let isEditMode = false;
let _hodExcludeId = null;

/* ================================================================
   INIT
================================================================ */
document.addEventListener('DOMContentLoaded', () => {
  FloatSuggest.init();
  loadEmployees();
});

/* ================================================================
   TABS
================================================================ */
function switchTab(name) {
  isDepartmentView = name === 'department';
  document.getElementById('tab-individual').className = isDepartmentView ? 'a-tab' : 'a-tab a-tab--active';
  document.getElementById('tab-department').className = isDepartmentView ? 'a-tab a-tab--active' : 'a-tab';
  document.getElementById('view-individual').style.display = isDepartmentView ? 'none' : 'block';
  document.getElementById('view-department').style.display = isDepartmentView ? 'block' : 'none';
  isDepartmentView ? loadDepartments() : loadEmployees(pagination.page);
}

/* ================================================================
   MAIN SEARCH BAR SUGGESTIONS
================================================================ */
let _mainLoadingTimer;
async function _mainSuggestFetch(q) {
  const inp = document.getElementById('searchInput');
  if (q.length < 2) { FloatSuggest.close(); return; }

  clearTimeout(_mainLoadingTimer);
  _mainLoadingTimer = setTimeout(() => {
    if (q.length >= 2) FloatSuggest.show(inp, suggestLoading(), () => {});
  }, 150);

  try {
    const res  = await window.iflFetch(`/admin/employees?q=${encodeURIComponent(q)}&page=1&limit=8`);
    const json = await res.json();
    clearTimeout(_mainLoadingTimer);

    if (!json.success || !json.data.length) {
      FloatSuggest.show(inp, suggestEmpty(q), () => {});
      return;
    }
    const html = json.data.map(emp => {
      const hod = emp.hodId
        ? `<span class="a-suggest-item__badge" style="background:var(--a-green-bg);color:var(--a-green);">HOD ✓</span>`
        : `<span class="a-suggest-item__badge" style="background:var(--a-red-bg);color:var(--a-red);">No HOD</span>`;
      return empHTML(emp, q, hod);
    }).join('');

    FloatSuggest.show(inp, html, (item, i) => {
      const emp = json.data[i];
      inp.value = emp.name;
      FloatSuggest.close();
      loadEmployees(1);
    });
  } catch {
    clearTimeout(_mainLoadingTimer);
    FloatSuggest.show(inp, '<div class="a-suggest-empty" style="color:var(--a-red);">Error fetching results</div>', () => {});
  }
}

const _mainSuggestDebounced = debounce(_mainSuggestFetch, 280);
const _mainTableDebounced   = debounce(() => loadEmployees(1), 450);

function onMainSearch(val) {
  _mainSuggestDebounced(val.trim());
  _mainTableDebounced();
}

function onMainKey(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); FloatSuggest.navigate(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); FloatSuggest.navigate(-1); }
  else if (e.key === 'Enter') {
    if (!FloatSuggest.selectFocused()) { FloatSuggest.close(); loadEmployees(1); }
  }
  else if (e.key === 'Escape') FloatSuggest.close();
}

function clearMainSearch() {
  document.getElementById('searchInput').value = '';
  FloatSuggest.close();
  loadEmployees(1);
}

/* ================================================================
   HOD MODAL SEARCH SUGGESTIONS
================================================================ */
let _hodLoadingTimer;
async function _hodSuggestFetch(q) {
  const inp = document.getElementById('hodSearchInput');
  if (q.length < 2) { FloatSuggest.close(); return; }

  clearTimeout(_hodLoadingTimer);
  _hodLoadingTimer = setTimeout(() => {
    if (q.length >= 2) FloatSuggest.show(inp, suggestLoading(), () => {});
  }, 150);

  try {
    const res  = await window.iflFetch(`/admin/employees?q=${encodeURIComponent(q)}&page=1&limit=10`);
    const json = await res.json();
    clearTimeout(_hodLoadingTimer);
    const results = (json.data || []).filter(e => e.employeeId !== _hodExcludeId);

    if (!results.length) {
      FloatSuggest.show(inp, suggestEmpty(q), () => {});
      return;
    }

    const badge = `<span class="a-suggest-item__badge" style="background:var(--a-brand-light);color:var(--a-brand);">Select</span>`;
    const html  = results.map(emp => empHTML(emp, q, badge)).join('');

    FloatSuggest.show(inp, html, (item, i) => {
      const emp = results[i];
      selectHod(emp.employeeId, emp.name, emp.designation || '', emp.department || '', emp.email || '');
    });
  } catch {
    clearTimeout(_hodLoadingTimer);
    FloatSuggest.show(inp, '<div class="a-suggest-empty" style="color:var(--a-red);">Error</div>', () => {});
  }
}

const _hodSuggestDebounced = debounce(_hodSuggestFetch, 280);

function onHodSearch(val) {
  clearHodSelection(false);
  _hodSuggestDebounced(val.trim());
}

function onHodKey(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); FloatSuggest.navigate(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); FloatSuggest.navigate(-1); }
  else if (e.key === 'Enter') { e.preventDefault(); FloatSuggest.selectFocused(); }
  else if (e.key === 'Escape') FloatSuggest.close();
}

function selectHod(hodId, hodName, designation, dept, email) {
  document.getElementById('selectedHodId').value = hodId;
  document.getElementById('hodSearchInput').value = hodName;

  document.getElementById('selectedHodAvatar').textContent = hodName.charAt(0).toUpperCase();
  document.getElementById('selectedHodName').textContent   = hodName;
  document.getElementById('selectedHodMeta').textContent   =
    [hodId, dept, designation, email].filter(Boolean).join(' · ');
  document.getElementById('selectedHodCard').style.display = 'flex';
  document.getElementById('assignForm').style.display      = 'block';

  FloatSuggest.close();
}

function clearHodSelection(clearInput = true) {
  document.getElementById('selectedHodId').value           = '';
  document.getElementById('selectedHodCard').style.display = 'none';
  document.getElementById('assignForm').style.display      = 'none';
  if (clearInput) document.getElementById('hodSearchInput').value = '';
}

/* ================================================================
   DEPARTMENTS
================================================================ */
async function loadDepartments() {
  const tbody = document.getElementById('departmentTableBody');
  tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading…</td></tr>';
  try {
    const json = await window.iflFetch('/admin/departments').then(r => r.json());
    if (json.success) {
      currentDepartments = json.data;
      document.getElementById('stats').innerText = `${json.data.length} departments`;
      const q = (document.getElementById('deptSearchInput')?.value || '').trim();
      renderDepartmentTable(filterDepartments(q), q);
    } else tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--a-red);">${json.error}</td></tr>`;
  } catch { tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--a-red);">Network Error</td></tr>`; }
}

function filterDepartments(q) {
  if (!q) return currentDepartments;
  const needle = q.toLowerCase();
  return currentDepartments.filter(d =>
    (d.departmentName || '').toLowerCase().includes(needle) ||
    (d.currentHodName || '').toLowerCase().includes(needle)
  );
}

const _deptSearchDebounced = debounce(() => {
  const q = document.getElementById('deptSearchInput').value.trim();
  renderDepartmentTable(filterDepartments(q), q);
  document.getElementById('stats').innerText =
    `${filterDepartments(q).length} of ${currentDepartments.length} departments`;
}, 180);

function onDeptSearch(val) { _deptSearchDebounced(val); }

function clearDeptSearch() {
  const inp = document.getElementById('deptSearchInput');
  if (inp) inp.value = '';
  renderDepartmentTable(currentDepartments, '');
  document.getElementById('stats').innerText = `${currentDepartments.length} departments`;
}

function renderDepartmentTable(departments, q = '') {
  const tbody = document.getElementById('departmentTableBody');
  if (!departments.length) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:40px;color:var(--a-text-muted);">No departments found.</td></tr>'; return; }
  tbody.innerHTML = departments.map(d => {
    const badge = d.currentHodId
      ? `<span class="badge assigned" title="${d.currentHodId}">${highlight(d.currentHodName, q)}</span>`
      : `<span class="badge unassigned">${highlight(d.currentHodName, q)}</span>`;
    const safe = (d.originalDeptName || '').replace(/'/g, "\\'");
    return `<tr>
      <td><strong>${highlight(d.departmentName, q)}</strong></td>
      <td>${d.employeeCount} employees</td>
      <td>${badge}</td>
      <td><button class="btn btn-primary" style="padding:5px 12px;font-size:.8rem;" onclick="openAssignModal(null,'${safe}','${d.departmentName}')">Assign HOD</button></td>
    </tr>`;
  }).join('');
}

/* ================================================================
   EMPLOYEES TABLE
================================================================ */
function onPageSizeChange() {
  const sel = document.getElementById('pageSizeSelect');
  pagination.limit = parseInt(sel.value, 10);
  loadEmployees(1);
}

async function loadEmployees(page = 1) {
  const query = document.getElementById('searchInput').value;
  const tbody = document.getElementById('employeeTableBody');
  tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:32px;color:var(--a-text-muted);">Searching…</td></tr>';
  try {
    const res  = await window.iflFetch(`/admin/employees?q=${encodeURIComponent(query)}&page=${page}&limit=${pagination.limit}`);
    const json = await res.json();
    if (json.success) {
      currentEmployees = json.data;
      pagination = { ...json.pagination, limit: pagination.limit };
      renderTable(json.data, query);
      renderPagination();
    } else tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:var(--a-red);">${json.error}</td></tr>`;
  } catch { tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:var(--a-red);">Network Error</td></tr>`; }
}

function renderTable(employees, q = '') {
  const tbody = document.getElementById('employeeTableBody');
  if (!employees.length) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--a-text-muted);">No employees found.</td></tr>'; return; }
  tbody.innerHTML = employees.map(emp => {
    const badge = emp.hodId
      ? `<span class="badge assigned" title="${emp.hodId}">${emp.hodName || emp.hodId}</span>`
      : `<span class="badge unassigned">Unassigned</span>`;
    const actions = emp.hodId
      ? `<button class="btn btn-secondary" style="padding:5px 10px;font-size:.78rem;background:var(--a-red-bg);color:var(--a-red);border-color:#fca5a5;" onclick="removeHod('${emp.employeeId}','${emp.name}')">Remove</button>
         <button class="btn btn-secondary" style="padding:5px 10px;font-size:.78rem;" onclick="openAssignModal('${emp.employeeId}')">Update</button>
         <button class="btn btn-secondary" style="padding:5px 10px;font-size:.78rem;" onclick="viewEmployeeDetails('${emp.employeeId}')">View</button>`
      : `<button class="btn btn-primary" style="padding:5px 10px;font-size:.78rem;" onclick="openAssignModal('${emp.employeeId}')">Assign HOD</button>
         <button class="btn btn-secondary" style="padding:5px 10px;font-size:.78rem;" onclick="viewEmployeeDetails('${emp.employeeId}')">View</button>`;
    return `<tr>
      <td><strong>${emp.employeeId}</strong></td>
      <td>${highlight(emp.name, q)}</td>
      <td>${highlight(emp.department || '—', q)}</td>
      <td>${emp.designation || '—'}</td>
      <td>${emp.location || '—'}</td>
      <td style="color:var(--a-text-muted);">${highlight(emp.email || '—', q)}</td>
      <td>${badge}</td>
      <td><div style="display:flex;gap:5px;flex-wrap:wrap;">${actions}</div></td>
    </tr>`;
  }).join('');
}

function renderPagination() {
  const info  = document.getElementById('paginationInfo');
  const btns  = document.getElementById('paginationButtons');

  // Sync the page-size dropdown to match current limit
  const sel = document.getElementById('pageSizeSelect');
  if (sel) sel.value = String(pagination.limit);

  if (!pagination.total) {
    info.innerText = 'No records found';
    document.getElementById('stats').innerText = '0 employees';
    btns.innerHTML = '';
    return;
  }

  const start = (pagination.page - 1) * pagination.limit + 1;
  const end   = Math.min(pagination.page * pagination.limit, pagination.total);
  const tp    = pagination.totalPages || 1;

  info.innerText = `Showing ${start}–${end} of ${pagination.total} employees  ·  Page ${pagination.page} of ${tp}`;
  document.getElementById('stats').innerText = `${pagination.total} employees`;

  let html = `<button class="page-btn" ${pagination.page <= 1 ? 'disabled' : ''} onclick="loadEmployees(1)" title="First page">«</button>`;
  html += `<button class="page-btn" ${pagination.page <= 1 ? 'disabled' : ''} onclick="loadEmployees(${pagination.page - 1})">← Prev</button>`;

  const s = Math.max(1, pagination.page - 2);
  const e = Math.min(tp, s + 4);
  for (let i = s; i <= e; i++) {
    html += `<button class="page-btn ${i === pagination.page ? 'active' : ''}" onclick="loadEmployees(${i})">${i}</button>`;
  }

  html += `<button class="page-btn" ${pagination.page >= tp ? 'disabled' : ''} onclick="loadEmployees(${pagination.page + 1})">Next →</button>`;
  html += `<button class="page-btn" ${pagination.page >= tp ? 'disabled' : ''} onclick="loadEmployees(${tp})" title="Last page">»</button>`;

  btns.innerHTML = html;
}

/* ================================================================
   ASSIGN HOD MODAL
================================================================ */
function openAssignModal(empId, deptOriginal = null, deptDisplay = null) {
  clearHodSelection(true);
  FloatSuggest.close();

  if (empId) {
    assignmentContext = { type: 'individual', targetId: empId };
    const emp = currentEmployees.find(e => e.employeeId === empId);
    if (!emp) return;
    _hodExcludeId = emp.employeeId;
    document.getElementById('selectedEmpId').value = emp.employeeId;
    document.getElementById('targetEmployeeName').innerText = emp.name;
    document.getElementById('targetEmployeeInfo').innerText = `${emp.employeeId} · ${emp.department || 'No Dept'} · ${emp.designation || ''}`;
  } else {
    assignmentContext = { type: 'department', targetId: deptOriginal };
    _hodExcludeId = null;
    document.getElementById('selectedEmpId').value = deptOriginal;
    document.getElementById('targetEmployeeName').innerText = `Department: ${deptDisplay}`;
    document.getElementById('targetEmployeeInfo').innerText = 'Applies to all employees in this group';
  }

  document.getElementById('assignModal').classList.add('active');
  setTimeout(() => document.getElementById('hodSearchInput').focus(), 80);
}

function closeModal() {
  document.getElementById('assignModal').classList.remove('active');
  FloatSuggest.close();
}

async function submitAssignment(e) {
  e.preventDefault();
  const targetVal = document.getElementById('selectedEmpId').value;
  const hodId     = document.getElementById('selectedHodId').value;
  if (!hodId) { IflDialog.warning('Please select an HOD from the suggestions.'); return; }
  const btn = document.getElementById('btnConfirmAssign');
  btn.disabled = true; btn.innerText = 'Assigning…';
  const endpoint = assignmentContext.type === 'department' ? '/admin/assign-department-hod' : '/admin/assign-hod';
  const payload  = assignmentContext.type === 'department'
    ? { departmentName: (!targetVal || targetVal === 'null') ? null : targetVal, hodId }
    : { employeeId: targetVal, hodId };
  try {
    const res  = await window.iflFetch(endpoint, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const json = await res.json();
    if (json.success) { closeModal(); assignmentContext.type === 'department' ? loadDepartments() : loadEmployees(pagination.page); }
    else IflDialog.error(json.error || 'Failed to assign HOD.');
  } catch { IflDialog.error('Network error. Please retry.'); }
  finally { btn.disabled = false; btn.innerText = 'Confirm Assignment'; }
}

async function removeHod(empId, empName) {
  const ok = await IflDialog.confirm(`Remove HOD assignment from ${empName}?`, {
    title: 'Remove HOD',
    okText: 'Remove',
    danger: true
  });
  if (!ok) return;
  try {
    const res  = await window.iflFetch('/admin/remove-hod', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ employeeId: empId }) });
    const json = await res.json();
    if (json.success) {
      loadEmployees();
      IflDialog.success(`HOD assignment removed from ${empName}.`);
    } else {
      IflDialog.error(json.error || 'Could not remove HOD assignment.');
    }
  } catch { IflDialog.error('Network error. Please retry.'); }
}

/* ================================================================
   EMPLOYEE DETAILS MODAL
================================================================ */
async function viewEmployeeDetails(empId) {
  document.getElementById('detailsContent').innerHTML = 'Loading details…';
  document.getElementById('detailsModal').classList.add('active');
  document.getElementById('editEmployeeId').value = empId;
  isEditMode = false;
  document.getElementById('btnEditToggle').innerText = 'Edit';
  document.getElementById('editActions').style.display = 'none';
  document.getElementById('viewActions').style.display = 'block';
  try {
    const res  = await window.iflFetch(`/admin/employee/${empId}`);
    const json = await res.json();
    json.success ? (currentViewedEmployee = json.data, renderDetailsContent(false))
      : (document.getElementById('detailsContent').innerHTML = `<div style="color:var(--a-red);">${json.error}</div>`);
  } catch { document.getElementById('detailsContent').innerHTML = '<div style="color:var(--a-red);">Network error.</div>'; }
}

function toggleEditMode() {
  if (!currentViewedEmployee) return;
  isEditMode = !isEditMode;
  document.getElementById('btnEditToggle').innerText = isEditMode ? 'Cancel' : 'Edit';
  document.getElementById('editActions').style.display = isEditMode ? 'flex' : 'none';
  document.getElementById('viewActions').style.display = isEditMode ? 'none' : 'block';
  renderDetailsContent(isEditMode);
}

function renderDetailsContent(editMode) {
  const emp = currentViewedEmployee;
  const readonlyKeys = ['employeeId','createdAt','updatedAt'];
  const groups = [
    { title:'Basic Information',      keys:['employeeId','name','fatherName','email','mobile','gender','dateOfBirth','cnic','bloodGroup'] },
    { title:'Employment Details',     keys:['designation','mainDept','status','joiningDate','location','unit','employeeType','assignmentCategory','employmentCategory','payroll'] },
    { title:'Organization Structure', keys:['managerName','managerId','managerDesignation','managerEmail','hodId','orgElementName','assignmentNumber'] },
    { title:'System & Other',         keys:['personId','extension','rfid','erpUser','pposDateStart','lastResignedDate','actualTerminationDate','createdAt','updatedAt'] }
  ];
  let html = [];
  html.push(`
    <div style="grid-column:1/-1;display:flex;align-items:center;gap:14px;margin-bottom:8px;padding-bottom:16px;border-bottom:1px solid var(--a-border);">
      <div class="a-avatar">${(emp.name||'?').charAt(0).toUpperCase()}</div>
      <div><div style="font-size:1.1rem;font-weight:700;">${emp.name||'Unknown'}</div>
      <div style="font-size:.8rem;color:var(--a-text-muted);">${emp.designation||'No Designation'} · ${emp.mainDept||'No Department'}${emp.location ? ' · ' + emp.location : ''}</div></div>
    </div>`);
  const alwaysShowKeys = ['employeeId','name','email','designation','mainDept','location','status','hodId'];
  groups.forEach(g => {
    const visible = g.keys.filter(k => alwaysShowKeys.includes(k) || (emp[k] != null && emp[k] !== '') || editMode);
    if (!visible.length) return;
    html.push(`<div style="grid-column:1/-1;font-size:.7rem;font-weight:700;color:var(--a-text-faint);text-transform:uppercase;letter-spacing:.08em;margin-top:10px;margin-bottom:4px;">${g.title}</div>`);
    visible.forEach(key => {
      const isRO = readonlyKeys.includes(key);
      const val  = emp[key] ?? '';
      const label = key.replace(/([A-Z])/g,' $1').replace(/^./,s=>s.toUpperCase());
      const field = editMode
        ? `<div style="margin-top:4px;"><input type="text" name="${key}" value="${val}" ${isRO?'readonly':''} style="width:100%;padding:7px 10px;border:1px solid ${isRO?'var(--a-border)':'var(--a-border-dark)'};border-radius:var(--a-radius-sm);background:${isRO?'var(--a-surface-2)':'#fff'};font-family:var(--a-font);box-sizing:border-box;"></div>`
        : `<div style="margin-top:3px;font-weight:500;min-height:18px;">${val||'—'}</div>`;
      html.push(`<div style="padding:10px 12px;background:${editMode&&!isRO?'#fff':'var(--a-surface-2)'};border-radius:var(--a-radius-sm);border:1px solid ${editMode&&!isRO?'var(--a-border-dark)':'transparent'};">
        <div style="font-size:.68rem;font-weight:700;color:var(--a-text-faint);text-transform:uppercase;letter-spacing:.05em;">${label}</div>
        ${field}</div>`);
    });
  });
  document.getElementById('detailsContent').innerHTML = html.join('');
}

async function saveEmployeeDetails(e) {
  e.preventDefault();
  const btn = document.getElementById('btnSaveDetails');
  const empId = document.getElementById('editEmployeeId').value;
  const formData = new FormData(document.getElementById('editEmployeeForm'));
  const payload = {};
  formData.forEach((v, k) => { if (k !== 'employeeId') payload[k] = v || null; });
  btn.disabled = true; btn.innerText = 'Saving…';
  try {
    const res  = await window.iflFetch(`/admin/employee/${empId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
    const json = await res.json();
    if (json.success) {
      closeDetailsModal();
      loadEmployees();
      IflDialog.success('Employee details saved.');
    } else {
      IflDialog.error(json.error || 'Could not save employee details.');
    }
  } catch { IflDialog.error('Network error. Please retry.'); }
  finally { btn.disabled = false; btn.innerText = 'Save Changes'; }
}

function closeDetailsModal() { document.getElementById('detailsModal').classList.remove('active'); }
</script>

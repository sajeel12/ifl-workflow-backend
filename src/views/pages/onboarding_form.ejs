    <%- include('../partials/portal_close') %>

    <style>
        /* Loading spinner animation for submit buttons */
        @keyframes ifl-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
    <script>
        /* Toggle collapsible form sections */
        function iflToggleSection(hd) {
            hd.closest('.form-section').classList.toggle('is-collapsed');
        }
    </script>
    <style>
        .ifl-spinner { animation: ifl-spin 0.7s linear infinite; vertical-align: -3px; margin-right: 6px; }
        button.is-loading { opacity: 0.75; cursor: wait; pointer-events: none; }
        button.is-loading > .ifl-btn-original { display: none; }
        button:disabled { cursor: not-allowed; }
    </style>
    <script>
        /* ─── SSO pre-fill: populate requester name/email from /api/auth/me ─
             on page load. Uses window.iflGetUser() exposed by the SSO badge
             script in header.ejs. Only fills empty fields so we never clobber
             values the server already rendered (token-bearing stages). */
        document.addEventListener('DOMContentLoaded', async () => {
            const expected = <%- JSON.stringify(typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail ? expectedAssigneeEmail : null) %>;
            const overlay  = document.getElementById('iflVerifyOverlay');

            // Local-part comparison: same person can be ali.khan@ifl.net in
            // HRMS and ali.khan@igc.com.pk in AD — domain varies, local-part
            // stays consistent. Mirror of src/utils/emailMatch.js.
            const emailLocalPart = (e) => {
                if (!e || typeof e !== 'string') return '';
                const at = e.indexOf('@');
                if (at <= 0) return '';
                return e.slice(0, at).toLowerCase().trim();
            };
            const emailsMatch = (a, b) => {
                const la = emailLocalPart(a);
                const lb = emailLocalPart(b);
                return !!la && la === lb;
            };

            // Helper: dismiss the verification cloak (only present when expected != null)
            const liftCloak = () => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) {
                    overlay.classList.add('is-fading-out');
                    setTimeout(() => overlay.remove(), 260);
                }
            };

            // Helper: replace the entire page with the rejection card
            const showRejection = (expectedEmail, actualLabel) => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) overlay.remove();
                document.body.innerHTML = `
                  <div style="max-width:560px;margin:80px auto;padding:36px;background:#fff;border:1px solid #fee2e2;border-radius:14px;text-align:center;font-family:'Segoe UI',sans-serif;box-shadow:0 12px 40px -8px rgba(220,38,38,.18);">
                    <div style="width:72px;height:72px;border-radius:50%;background:#fee2e2;color:#b91c1c;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 18px;">⛔</div>
                    <h2 style="color:#b91c1c;margin:0 0 14px;font-size:1.15rem;">This page is authorized only for the intended recipient</h2>
                    <p style="color:#475569;line-height:1.55;margin:0 0 14px;">
                      This action link was sent to <strong>${expectedEmail}</strong>.<br>
                      You are signed in as <strong>${actualLabel}</strong>, so you cannot act on this request.
                    </p>
                    <p style="color:#64748b;font-size:.9rem;">If you need to handle it on someone's behalf, please contact your administrator.</p>
                  </div>`;
            };

            // Hydrate any input marked data-ifl-sso-name="1" (DCI Implementer's
            // "Implementer Name", OPS Verifier's "Verifier Name", etc.) with
            // the SSO display name. These inputs are rendered `disabled`, so
            // they're informational only — the server uses req.user to record
            // the actor identity, never the form value.
            const fillSsoNameFields = (u) => {
                const v = (u && (u.displayName || u.username)) || '';
                if (!v) return;
                document.querySelectorAll('input[data-ifl-sso-name="1"]').forEach(el => {
                    if (!el.value) el.value = v;
                });
            };

            // No expected email → not an SSO-gated stage (e.g. HR initiate). Lift any cloak and exit.
            if (!expected) {
                liftCloak();
                // Still attempt the standard pre-fill below
                try {
                    if (typeof window.iflGetUser === 'function') {
                        const u = await window.iflGetUser();
                        if (u) {
                            const nameEl  = document.querySelector('input[name="requesterName"]');
                            const emailEl = document.querySelector('input[name="requesterEmail"]');
                            if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                            if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                            fillSsoNameFields(u);
                            // Hydrate location group — the GET render can't pre-fill it
                            // when IIS hasn't authenticated the user yet (fresh navigation).
                            // Call the SSO-gated endpoint now that we have a sidecar token.
                            try {
                                const locInput = document.querySelector('input[data-ifl-location="1"]');
                                if (locInput && !locInput.value && typeof window.iflFetch === 'function') {
                                    const lkRes = await window.iflFetch('/api/onboarding/my-hr-location');
                                    if (lkRes && lkRes.ok) {
                                        const lkJson = await lkRes.json();
                                        if (lkJson.label) locInput.value = lkJson.label;
                                    }
                                }
                            } catch (_) {}
                        }
                    }
                } catch (_) {}
                return;
            }

            // Expected email present → mandatory SSO verification
            if (typeof window.iflGetUser !== 'function') {
                showRejection(expected, 'an unverified user (SSO not available on this device)');
                return;
            }
            try {
                const u = await window.iflGetUser();
                if (!u || !u.email) {
                    showRejection(expected, 'an unverified user');
                    return;
                }
                if (!emailsMatch(u.email, expected)) {
                    showRejection(expected, u.email || u.username);
                    return;
                }
                // Verified! Pre-fill any empty requester fields and reveal the form.
                const nameEl  = document.querySelector('input[name="requesterName"]');
                const emailEl = document.querySelector('input[name="requesterEmail"]');
                if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                fillSsoNameFields(u);
                liftCloak();
            } catch (e) {
                // SSO call failed for some reason (token.aspx unreachable, network, etc.)
                showRejection(expected, 'an unverified user (SSO check failed)');
            }
        });

        /* Wrap the action-bar form so any submit click attaches the SSO
           sidecar token, shows a spinner and locks the buttons. */
        (function setupSubmitLoaders() {
            const SPINNER_SVG = '<svg class="ifl-spinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>';

            // Add a hidden field to the form holding the latest sidecar token,
            // so server-side ssoMiddleware can authenticate the POST.
            const ensureTokenField = async (form) => {
                if (typeof window.iflGetToken !== 'function') return;
                let hidden = form.querySelector('input[name="x-sidecar-token"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'x-sidecar-token';
                    form.appendChild(hidden);
                }
                try {
                    hidden.value = await window.iflGetToken();
                } catch (_) { /* leave value empty; server will return a clear 401 */ }
            };

            // Re-submit the form preserving the original submitter button so its
            // name=value pair is included in the POST body.
            // form.requestSubmit(btn) is spec-correct and always sets e.submitter.
            // Fall back to btn.click() for very old browsers (pre-2020).
            function reSubmit(form, submitter) {
                if (submitter && typeof form.requestSubmit === 'function') {
                    try { form.requestSubmit(submitter); return; } catch (_) {}
                }
                if (submitter && typeof submitter.click === 'function') {
                    submitter.click();
                } else {
                    form.submit();
                }
            }

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('form').forEach(form => {
                    form.addEventListener('submit', async (e) => {
                        // Run native validation first; if it fails, don't lock the buttons.
                        if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;

                        const submitter = e.submitter || form.querySelector('button[type="submit"]:focus') || form.querySelector('button[type="submit"]');

                        // Pin the action value into a hidden mirror field immediately — before any
                        // async operation or button disabling. Browsers serialize form data AFTER
                        // the event handler returns, at which point disabled buttons are excluded.
                        // The mirror field ensures the action value always reaches the server even
                        // when the submitter button is disabled to prevent double-clicks.
                        if (submitter && submitter.name) {
                            let mirror = form.querySelector('input[data-ifl-action-mirror]');
                            if (!mirror) {
                                mirror = document.createElement('input');
                                mirror.type = 'hidden';
                                mirror.dataset.iflActionMirror = '1';
                                form.appendChild(mirror);
                            }
                            mirror.name = submitter.name;
                            mirror.value = submitter.value;
                        }

                        // If the submitter declares a confirm prompt via data-attrs,
                        // run our custom IflDialog.confirm BEFORE doing any other work.
                        const confirmMsg = submitter && submitter.dataset.iflConfirm;
                        if (confirmMsg && !form.dataset.iflConfirmed) {
                            e.preventDefault();
                            const ok = await IflDialog.confirm(confirmMsg, {
                                title:   submitter.dataset.iflConfirmTitle  || undefined,
                                okText:  submitter.dataset.iflConfirmOk     || 'Confirm',
                                danger:  submitter.dataset.iflConfirmDanger === '1'
                            });
                            if (!ok) return;
                            form.dataset.iflConfirmed = '1';
                            reSubmit(form, submitter);
                            return;
                        }

                        // We need the sidecar token attached to the body BEFORE
                        // the browser POSTs. Block the native submit, fetch the
                        // token, then re-trigger submission.
                        if (!form.dataset.iflTokenAttached) {
                            e.preventDefault();
                            await ensureTokenField(form);
                            form.dataset.iflTokenAttached = '1';
                            // Re-fire preserving the original submitter so action
                            // button name=value pairs (Approve/Reject/RequestChanges) survive.
                            reSubmit(form, submitter);
                            return;
                        }

                        // Second pass — confirm passed, token attached, real submit proceeds.
                        // (`submitter` was captured at the top of this handler.)

                        // Disable every submit button and strip its name so the mirror field is
                        // the sole source of the action value — no duplicate or missing POST fields.
                        form.querySelectorAll('button[type="submit"]').forEach(btn => {
                            // Preserve the original label inside a span so we can restore it later
                            if (!btn.querySelector('.ifl-btn-original')) {
                                const span = document.createElement('span');
                                span.className = 'ifl-btn-original';
                                while (btn.firstChild) span.appendChild(btn.firstChild);
                                btn.appendChild(span);
                            }
                            if (btn.name) btn.dataset.iflBtnName = btn.name; // save for restore
                            btn.removeAttribute('name'); // mirror field carries the value; avoid duplicates
                            btn.disabled = true;
                            btn.classList.add('is-loading');

                            // The clicked button gets the spinner inline
                            if (btn === submitter) {
                                const indicator = document.createElement('span');
                                indicator.className = 'ifl-btn-loading-text';
                                indicator.innerHTML = SPINNER_SVG + 'Working…';
                                btn.appendChild(indicator);
                            }
                        });

                        // Safety net: if the page hasn't navigated within 30s (server stall), restore the buttons
                        setTimeout(() => {
                            form.querySelectorAll('button[type="submit"]').forEach(btn => {
                                if (btn.dataset.iflBtnName) { btn.setAttribute('name', btn.dataset.iflBtnName); delete btn.dataset.iflBtnName; }
                                btn.disabled = false;
                                btn.classList.remove('is-loading');
                                const ind = btn.querySelector('.ifl-btn-loading-text');
                                if (ind) ind.remove();
                            });
                            // Allow a future submission to re-fetch a fresh token and a fresh action mirror
                            delete form.dataset.iflTokenAttached;
                            delete form.dataset.iflConfirmed;
                            const mirror = form.querySelector('input[data-ifl-action-mirror]');
                            if (mirror) mirror.remove();
                        }, 30000);
                    });
                });
            });
        })();

        /* Toggle printer location dropdown/input based on checkbox */
        function togglePrinterLocation(type) {
            const chk = document.getElementById('chk-' + type);
            const loc = document.getElementById('loc-' + type);
            if (chk && loc) {
                loc.disabled = !chk.checked;
                if (!chk.checked) loc.value = '';
                loc.style.opacity = chk.checked ? '1' : '0.5';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Set initial state for printer location fields
            togglePrinterLocation('laser');
            togglePrinterLocation('dotmatrix');

            // ── Employee ID auto-fill + state guard ────────────────────────
            // Runs on both "Get Employee Data" button click AND on field blur,
            // so HR doesn't have to manually press the button every time.
            const empIdInput   = document.getElementById('employeeIdInput');
            const btn          = document.getElementById('btnGetEmployee');
            const requestModeEl = document.querySelector('select[name="requestMode"]');

            // Remove any previously injected state banner
            const clearStateBanner = () => {
                const prev = document.getElementById('empStateBanner');
                if (prev) prev.remove();
            };

            // Inject an info/warning banner just below the Employee ID block
            const showStateBanner = (message, type) => {
                clearStateBanner();
                // empIdInput lives two levels inside the Employee ID container div
                const empBlock = empIdInput && empIdInput.parentElement && empIdInput.parentElement.parentElement;
                if (!empBlock) return;
                const div = document.createElement('div');
                div.id = 'empStateBanner';
                const colors = {
                    info:    { bg: '#eff6ff', border: '#93c5fd', text: '#1d4ed8' },
                    warning: { bg: '#fff7ed', border: '#fdba74', text: '#c2410c' },
                };
                const c = colors[type] || colors.info;
                div.style.cssText = `background:${c.bg};border:1px solid ${c.border};border-radius:8px;padding:10px 14px;margin-top:10px;color:${c.text};font-size:0.86rem;font-weight:500;`;
                div.textContent = message;
                empBlock.insertAdjacentElement('afterend', div);
            };

            // Lock the Request Mode select to a fixed value so HR can't override it.
            // disabled selects don't submit — mirror the value via a hidden input.
            const lockRequestMode = (value) => {
                if (!requestModeEl) return;
                requestModeEl.value = value;
                requestModeEl.disabled = true;
                let hidden = document.querySelector('input[name="requestMode"][type="hidden"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'requestMode';
                    requestModeEl.parentNode.appendChild(hidden);
                }
                hidden.value = value;
            };

            // Unlock the Request Mode select and remove any hidden mirror field.
            // Also re-enables the submit button if a previous lookup had blocked it.
            // Called at the start of every employee lookup so switching employees
            // always re-evaluates the correct mode — never inherits the previous state.
            const unlockRequestMode = () => {
                if (!requestModeEl) return;
                requestModeEl.disabled = false;
                requestModeEl.value = 'New';
                const hidden = document.querySelector('input[name="requestMode"][type="hidden"]');
                if (hidden) hidden.remove();
                const submitBtn = document.querySelector('.action-bar button[type="submit"][data-ifl-lookup-blocked]');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.removeAttribute('data-ifl-lookup-blocked');
                }
            };

            const lookupAndFill = async () => {
                const empId = empIdInput ? empIdInput.value.trim() : '';
                if (!empId) return;

                // Reset mode and banners before each lookup — never inherit state
                // from the previously fetched employee.
                unlockRequestMode();
                clearStateBanner();

                if (btn) { btn.textContent = 'Fetching…'; btn.disabled = true; }

                try {
                    // 1 — HRMS data fill
                    const hrmsRes = await fetch('/api/hrms/employee/' + encodeURIComponent(empId));
                    if (!hrmsRes.ok) throw new Error('Employee not found in HRMS');
                    const data = await hrmsRes.json();

                    const setVal = (name, val) => {
                        const el = document.querySelector('[name="' + name + '"]');
                        if (el && val != null && val !== '') el.value = val;
                    };
                    setVal('fullName',      data.fullName);
                    setVal('department',    data.department);
                    setVal('subDepartment', data.subDepartment);
                    setVal('designation',   data.designation);
                    setVal('hod',           data.hod);
                    if (data.joiningDate) {
                        const d = new Date(data.joiningDate);
                        if (!isNaN(d.getTime())) setVal('joiningDate', d.toISOString().split('T')[0]);
                    }

                    // Lock all HRMS-sourced fields — readonly so they still submit
                    ['fullName', 'department', 'subDepartment', 'designation', 'hod', 'joiningDate'].forEach(name => {
                        const el = document.querySelector('[name="' + name + '"]');
                        if (el) { el.readOnly = true; el.style.background = '#f1f5f9'; el.style.cursor = 'not-allowed'; }
                    });

                    // 2 — Existing request check
                    try {
                        const lkRes  = await fetch('/api/onboarding/lookup?employeeId=' + encodeURIComponent(empId));
                        const lkData = lkRes.ok ? await lkRes.json() : {};

                        if (lkData.state === 'active') {
                            // In-flight — block submission entirely. The request is already
                            // moving through the workflow; neither New nor Change can be
                            // initiated until it reaches Completed or Rejected.
                            showStateBanner(
                                'This employee already has an onboarding request in progress. No new request can be submitted until the existing one is completed or rejected.',
                                'warning'
                            );
                            const submitBtn = document.querySelector('.action-bar button[type="submit"]');
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.setAttribute('data-ifl-lookup-blocked', '1');
                            }
                        } else if (lkData.state === 'completed') {
                            // Completed — only Change / Modification is allowed.
                            lockRequestMode('Change');
                            showStateBanner(
                                'This employee already has a completed onboarding record. Request mode has been locked to "Change / Modification".',
                                'info'
                            );
                        }
                        // state === null → new employee, leave requestMode as New Hiring (default)
                    } catch (_) { /* non-fatal — lookup failure doesn't block submission */ }

                } catch (err) {
                    IflDialog.error(err.message || 'Could not look up the employee.');
                } finally {
                    if (btn) { btn.textContent = 'Get Employee Data'; btn.disabled = false; }
                }
            };

            if (btn)        btn.addEventListener('click', lookupAndFill);
            if (empIdInput) empIdInput.addEventListener('blur', () => { if (empIdInput.value.trim()) lookupAndFill(); });
        });
    </script>

    <script>
        /* ─── DCI Configuration: NT-name auto-derive + AD check + group multi-select ───
           Runs only when the DCI section is present. Auto-fills NT login, alias,
           Exchange display name, SMTP, title and department from the HR-entered
           employee data; lets the DCI member verify the NT name against AD and
           pick AD groups for "Member Of". */
        (function dciFormSetup() {
            const CFG = window.IFL_DCI;
            if (!CFG) return; // DCI section not rendered on this page

            // Derivations from the employee full name
            const stripSpaces = (s) => (s || '').replace(/\s+/g, '');
            const toDots      = (s) => (s || '').trim().toLowerCase().replace(/\s+/g, '.');
            const normName    = (s) => (s || '').trim().replace(/\s+/g, ' ');

            const $ = (id) => document.getElementById(id);
            const ntEl      = $('dciNtName');
            const dispEl    = $('dciDisplayName');
            const aliasEl   = $('dciAlias');
            const domainEl  = $('dciSmtpDomain');
            const smtpEl    = $('dciSmtp');
            const titleEl   = $('dciTitle');
            const deptEl    = $('dciDept');
            const memberHidden = $('dciMemberOf');
            const chipsEl   = $('dciGroupChips');

            // ── Member Of: chip state (works read-only too) ───────────────────────
            let selectedGroups = (CFG.existing.memberOf || '')
                .split(',').map(s => s.trim()).filter(Boolean);

            const syncMemberHidden = () => {
                if (memberHidden) memberHidden.value = selectedGroups.join(', ');
            };
            const renderChips = () => {
                if (!chipsEl) return;
                if (!selectedGroups.length) {
                    chipsEl.innerHTML = CFG.editable
                        ? '<span style="font-size:0.8rem;color:#94a3b8;">No groups selected yet.</span>'
                        : '<span style="font-size:0.8rem;color:#94a3b8;">—</span>';
                    return;
                }
                chipsEl.innerHTML = selectedGroups.map((g, i) => `
                    <span style="display:inline-flex;align-items:center;gap:6px;background:#ede9fe;color:#5b21b6;border:1px solid #ddd6fe;border-radius:14px;padding:3px 10px;font-size:0.8rem;font-weight:500;">
                        ${g.replace(/</g, '&lt;')}
                        ${CFG.editable ? `<span data-rm="${i}" style="cursor:pointer;font-weight:700;line-height:1;">×</span>` : ''}
                    </span>`).join('');
                if (CFG.editable) {
                    chipsEl.querySelectorAll('[data-rm]').forEach(x => {
                        x.addEventListener('click', () => {
                            selectedGroups.splice(parseInt(x.dataset.rm, 10), 1);
                            onGroupSelectionChanged();
                        });
                    });
                }
            };
            renderChips();

            // Preselect the domain matching an existing stored SMTP (runs for all
            // roles so reviewers see the right domain), else default to first.
            if (domainEl) {
                const existingSmtp = CFG.existing.smtpAddress || '';
                const at = existingSmtp.indexOf('@');
                if (at >= 0) {
                    const dom = existingSmtp.slice(at);
                    const opt = [...domainEl.options].find(o => o.value.toLowerCase() === dom.toLowerCase());
                    if (opt) domainEl.value = opt.value;
                }
            }

            // Non-editable roles only display the stored values — stop here.
            if (!CFG.editable) return;

            // ── SMTP composition (alias + domain) ─────────────────────────────────
            const composeSmtp = () => {
                const local = (aliasEl.value || '').trim();
                if (!local) { smtpEl.value = ''; return; }
                smtpEl.value = local + (domainEl.value || '');
            };

            // ── Prefill on first arrival at DCI stage (empty fields only) ─────────
            if (!ntEl.value)    ntEl.value    = stripSpaces(CFG.fullName);
            if (!aliasEl.value) aliasEl.value = toDots(CFG.fullName);
            if (!dispEl.value)  dispEl.value  = normName(CFG.fullName);
            if (!titleEl.value) titleEl.value = CFG.designation || '';
            if (!deptEl.value)  deptEl.value  = CFG.department || '';
            if (!smtpEl.value)  composeSmtp();

            aliasEl.addEventListener('input', composeSmtp);
            domainEl.addEventListener('change', composeSmtp);

            // ── NT name AD availability check ─────────────────────────────────────
            const statusEl = $('dciNtStatus');
            const checkBtn = $('dciCheckNtBtn');
            const setStatus = (html, color) => {
                if (statusEl) { statusEl.innerHTML = html; statusEl.style.color = color || '#64748b'; }
            };
            const runNtCheck = async () => {
                const name = (ntEl.value || '').trim();
                if (!name) { setStatus('Enter an NT name to check.', '#b45309'); return; }
                setStatus('Checking AD…', '#64748b');
                if (checkBtn) { checkBtn.disabled = true; checkBtn.textContent = 'Checking…'; }
                try {
                    const res  = await fetch('/api/onboarding/check-ntname?name=' + encodeURIComponent(name));
                    const data = await res.json();
                    if (data.available) {
                        setStatus('✓ Available — this NT name is free to use.', '#16a34a');
                    } else {
                        const who = data.match && (data.match.displayName || data.match.sAMAccountName);
                        setStatus('✕ Name already exists' + (who ? ' (' + who + ')' : '') + ' — please change it and check again.', '#dc2626');
                    }
                } catch (_) {
                    setStatus('Could not reach AD to verify. Try again.', '#b45309');
                } finally {
                    if (checkBtn) { checkBtn.disabled = false; checkBtn.textContent = 'Check'; }
                }
            };
            if (checkBtn) checkBtn.addEventListener('click', runNtCheck);
            // Re-derive display name spaces hint when NT changes (display keeps spaces; left to DCI)
            ntEl.addEventListener('input', () => setStatus('', '#64748b'));

            // ── Member Of: load-once AD group dropdown (multi-select) ─────────────
            const toggleBtn   = $('dciGroupToggle');
            const toggleLabel = $('dciGroupToggleLabel');
            const panelEl     = $('dciGroupPanel');
            const filterEl    = $('dciGroupFilter');
            const listEl      = $('dciGroupList');
            let allGroups = [];        // [{ name, sAMAccountName, mail }]
            let groupsLoaded = false;

            // Hoisted so the chip-removal handler (defined earlier) can call it.
            function updateGroupToggleLabel() {
                if (!toggleLabel) return;
                const n = selectedGroups.length;
                toggleLabel.textContent = n ? (n + ' group' + (n > 1 ? 's' : '') + ' selected') : 'Select groups…';
                toggleLabel.style.color = n ? '#0f172a' : '#64748b';
            }
            function refreshGroupChecklist() {
                if (!listEl) return;
                const sel = new Set(selectedGroups.map(g => g.toLowerCase()));
                listEl.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                    cb.checked = sel.has((cb.value || '').toLowerCase());
                });
            }
            function onGroupSelectionChanged() {
                syncMemberHidden();
                renderChips();
                refreshGroupChecklist();
                updateGroupToggleLabel();
            }

            const renderGroupList = (filterText) => {
                if (!listEl) return;
                if (!allGroups.length) {
                    listEl.innerHTML = '<div style="padding:10px 12px;color:#dc2626;font-size:0.82rem;">No groups available — the AD groups service may not be reachable.</div>';
                    return;
                }
                const ft = (filterText || '').trim().toLowerCase();
                const rows = allGroups.filter(g => !ft ||
                    (g.name || '').toLowerCase().includes(ft) ||
                    (g.sAMAccountName || '').toLowerCase().includes(ft));
                if (!rows.length) {
                    listEl.innerHTML = '<div style="padding:10px 12px;color:#94a3b8;font-size:0.82rem;">No groups match the filter.</div>';
                    return;
                }
                const sel = new Set(selectedGroups.map(g => g.toLowerCase()));
                listEl.innerHTML = rows.map(g => {
                    const nm  = (g.name || g.sAMAccountName || '');
                    const esc = nm.replace(/"/g, '&quot;');
                    const checked = sel.has(nm.toLowerCase()) ? 'checked' : '';
                    const sub = [g.sAMAccountName, g.mail].filter(Boolean).join(' · ');
                    return `<label style="display:flex;gap:8px;align-items:flex-start;padding:7px 12px;cursor:pointer;">
                        <input type="checkbox" value="${esc}" ${checked} style="margin-top:2px;flex-shrink:0;">
                        <span style="min-width:0;">
                            <span style="display:block;font-size:0.85rem;color:#0f172a;">${nm.replace(/</g, '&lt;')}</span>
                            ${sub ? `<span style="display:block;font-size:0.72rem;color:#94a3b8;">${sub.replace(/</g, '&lt;')}</span>` : ''}
                        </span>
                    </label>`;
                }).join('');
                listEl.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                    cb.addEventListener('change', () => {
                        const name = cb.value;
                        const idx = selectedGroups.findIndex(g => g.toLowerCase() === name.toLowerCase());
                        if (cb.checked && idx < 0) selectedGroups.push(name);
                        else if (!cb.checked && idx >= 0) selectedGroups.splice(idx, 1);
                        syncMemberHidden(); renderChips(); updateGroupToggleLabel();
                    });
                });
            };

            const loadAllGroups = async () => {
                if (groupsLoaded) return;
                if (listEl) listEl.innerHTML = '<div style="padding:10px 12px;color:#94a3b8;font-size:0.82rem;">Loading groups…</div>';
                try {
                    const res  = await fetch('/api/onboarding/ad-groups?all=1');
                    const data = await res.json();
                    let list = (data && data.results) || [];
                    const seen = new Set();
                    list = list.filter(g => {
                        const k = (g.name || g.sAMAccountName || '').toLowerCase();
                        if (!k || seen.has(k)) return false;
                        seen.add(k); return true;
                    }).sort((a, b) => (a.name || '').localeCompare(b.name || ''));
                    allGroups = list;
                } catch (_) {
                    allGroups = [];
                } finally {
                    groupsLoaded = true;
                    renderGroupList(filterEl ? filterEl.value : '');
                }
            };

            const openPanel  = () => { if (panelEl) { panelEl.style.display = 'block'; loadAllGroups(); if (filterEl) setTimeout(() => filterEl.focus(), 30); } };
            const closePanel = () => { if (panelEl) panelEl.style.display = 'none'; };

            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    if (panelEl && panelEl.style.display === 'block') closePanel(); else openPanel();
                });
            }
            if (filterEl) filterEl.addEventListener('input', () => renderGroupList(filterEl.value));
            // Close when clicking outside the control
            document.addEventListener('mousedown', (e) => {
                if (!panelEl || panelEl.style.display !== 'block') return;
                const wrap = toggleBtn && toggleBtn.parentElement;
                if (wrap && !wrap.contains(e.target)) closePanel();
            });

            updateGroupToggleLabel();
        })();
    </script>


<%- include('../partials/header', { title: 'IT Onboarding Workflow' }) %>
    <link rel="stylesheet" href="/css/modern.css">

    <%
    // When an action token is present (email-link click), the form must be
    // hidden until the SSO email is verified against the expected approver.
    // The body starts in "is-verifying" state; the verification JS lifts
    // this once the check passes — or the rejection screen replaces it.
    %>
    <% if (token && typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail) { %>
    <style>
        body.ifl-is-verifying > *:not(#iflVerifyOverlay) { visibility: hidden !important; }
        #iflVerifyOverlay {
            position: fixed; inset: 0;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            z-index: 9999;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: opacity 0.25s ease;
        }
        #iflVerifyOverlay.is-fading-out { opacity: 0; pointer-events: none; }
        #iflVerifyOverlay .iflv-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px 48px;
            box-shadow: 0 12px 40px -8px rgba(15, 76, 129, 0.18);
            display: flex; flex-direction: column; align-items: center; gap: 18px;
            min-width: 320px;
        }
        #iflVerifyOverlay .iflv-spinner {
            width: 56px; height: 56px;
            border: 4px solid #e0f2fe;
            border-top-color: #0078D4;
            border-radius: 50%;
            animation: iflv-spin 0.8s linear infinite;
        }
        @keyframes iflv-spin { to { transform: rotate(360deg); } }
        #iflVerifyOverlay .iflv-title { font-size: 1.05rem; font-weight: 700; color: #0F172A; margin: 0; }
        #iflVerifyOverlay .iflv-sub   { font-size: 0.88rem; color: #64748B; margin: 0; line-height: 1.5; text-align: center; max-width: 320px; }
        #iflVerifyOverlay .iflv-logo  { height: 44px; opacity: 0.92; margin-bottom: 4px; }
    </style>
    <script>
        // Apply the cloak immediately (before DOM parses further) so the form
        // never paints for an unauthorized viewer.
        document.documentElement.style.background = 'linear-gradient(135deg,#f8fafc,#e0f2fe)';
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('ifl-is-verifying');
        });
    </script>
    <div id="iflVerifyOverlay">
        <div class="iflv-card">
            <img src="/logo.png" alt="IFL" class="iflv-logo" onerror="this.style.display='none'">
            <div class="iflv-spinner"></div>
            <h3 class="iflv-title">Verifying your access…</h3>
            <p class="iflv-sub">Please wait while we confirm you are the intended recipient of this action.</p>
        </div>
    </div>
    <% } %>

    <!-- Header is now outside the constrained container to allow full width -->
    <header class="app-header">
        <div class="brand-section">
            <img src="/logo.png" alt="IFL" class="logo" onerror="this.style.display='none'">
            <div class="app-title">
                <h1>IT Onboarding Workflow</h1>
                <p>Ibrahim Fibers Limited</p>
            </div>
        </div>
        <div class="status-section">
            <% if (token) { %>
                <div class="status-badge">REQ #<%= request.id || 'NEW' %> | <%= role %>
                </div>
                <% } %>
        </div>
    </header>

    <%
    // Portal layout — when an approver opens the form via an email link (any
    // role except HR/read-only with a workflow token), we wrap the form in a
    // shell with a left sidebar that shows the role's pending tasks + history.
    // The sidebar fetches /api/onboarding/queue and renders rows the user
    // can click to switch between their workitems without going back to email.
    %>
    <% const showPortal = !!(token && roleKey); %>
    <% if (showPortal) { %>
    <style>
        /* Sidebar sticks to the left edge of the viewport.
           Main area takes the rest and keeps the form's original centered
           layout (the existing .app-container max-width is preserved). */
        .portal-shell {
            display: flex;
            min-height: calc(100vh - 90px);
            background: #f8fafc;
        }
        .portal-sidebar {
            width: 280px; flex-shrink: 0;
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            box-shadow: 1px 0 0 rgba(15,23,42,0.02);
            display: flex; flex-direction: column;
            position: sticky; top: 0; align-self: flex-start;
            height: calc(100vh - 90px); overflow: hidden;
        }
        .portal-side-head {
            padding: 22px 22px 14px;
            border-bottom: 1px solid #f1f5f9;
        }
        .portal-side-head .ps-role {
            font-size: 0.72rem; font-weight: 700; color: #64748b;
            text-transform: uppercase; letter-spacing: 0.06em;
        }
        .portal-side-head .ps-title {
            font-size: 1.05rem; font-weight: 700; color: #0f172a;
            margin-top: 2px;
        }
        .portal-side-head .ps-sub {
            font-size: 0.78rem; color: #94a3b8; margin-top: 4px;
        }
        .portal-tabs {
            display: flex;
            padding: 12px 16px 0;
            gap: 6px;
            border-bottom: 1px solid #f1f5f9;
        }
        .portal-tab {
            flex: 1;
            background: transparent; border: none;
            padding: 8px 4px 10px;
            font-size: 0.82rem; font-weight: 600; color: #64748b;
            cursor: pointer; position: relative;
            border-bottom: 2px solid transparent;
            transition: color 0.12s, border-color 0.12s;
            font-family: inherit;
        }
        .portal-tab:hover { color: #0f172a; }
        .portal-tab.is-active {
            color: #0078D4;
            border-bottom-color: #0078D4;
        }
        .portal-tab .ps-count {
            display: inline-block;
            background: #e0f2fe; color: #0369a1;
            padding: 1px 7px; border-radius: 999px;
            font-size: 0.7rem; margin-left: 4px;
        }
        .portal-tab.is-active .ps-count { background: #0078D4; color: #fff; }

        .portal-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 0 24px;
        }
        .portal-list-state {
            padding: 32px 22px;
            text-align: center;
            color: #94a3b8; font-size: 0.85rem;
        }
        .portal-list-state .pls-spin {
            width: 22px; height: 22px;
            border: 2.5px solid #e2e8f0;
            border-top-color: #0078D4;
            border-radius: 50%;
            animation: ps-spin 0.8s linear infinite;
            display: inline-block; margin-bottom: 8px;
        }
        @keyframes ps-spin { to { transform: rotate(360deg); } }

        .portal-row {
            display: block;
            padding: 12px 22px;
            border-left: 3px solid transparent;
            text-decoration: none; color: inherit;
            transition: background 0.12s, border-color 0.12s;
        }
        .portal-row:hover { background: #f8fafc; }
        .portal-row.is-active {
            background: #eff6ff;
            border-left-color: #0078D4;
        }
        .portal-row .pr-top {
            display: flex; align-items: center; justify-content: space-between;
            gap: 8px;
        }
        .portal-row .pr-name {
            font-size: 0.9rem; font-weight: 600; color: #0f172a;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
            flex: 1;
        }
        .portal-row .pr-badge {
            font-size: 0.65rem; font-weight: 700;
            padding: 2px 7px; border-radius: 999px;
            text-transform: uppercase; letter-spacing: 0.04em;
            flex-shrink: 0;
        }
        .portal-row .pr-badge.is-now { background: #fef3c7; color: #b45309; }
        .portal-row .pr-badge.is-done { background: #f1f5f9; color: #64748b; }
        .portal-row .pr-meta {
            font-size: 0.74rem; color: #64748b;
            margin-top: 4px; line-height: 1.4;
        }
        .portal-row .pr-meta strong { color: #475569; font-weight: 600; }
        .portal-row.is-current {
            background: linear-gradient(90deg, #dbeafe 0%, #eff6ff 100%);
            border-left-color: #0078D4;
        }
        .portal-row.is-current .pr-current-dot {
            display: inline-block;
            width: 6px; height: 6px; border-radius: 50%;
            background: #0078D4;
            box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.2);
            margin-right: 6px;
            animation: ps-pulse 1.6s ease-in-out infinite;
        }
        @keyframes ps-pulse {
            0%, 100% { box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.2); }
            50%      { box-shadow: 0 0 0 6px rgba(0, 120, 212, 0.05); }
        }

        .portal-main {
            flex: 1; min-width: 0;
            padding: 0;
        }
        /* Inside the portal, the existing .app-container keeps its own
           max-width and auto-centers within the main area — so the form
           looks the same width as before, just shifted right of the sidebar. */

        @media (max-width: 1000px) {
            .portal-shell { flex-direction: column; }
            .portal-sidebar {
                width: 100%; max-height: none;
                position: static; border-right: none;
                border-bottom: 1px solid #e2e8f0;
            }
            .portal-list { max-height: 280px; }
        }

        /* Row date line — small, secondary */
        .portal-row .pr-time {
            font-size: 0.72rem; color: #94a3b8;
            margin-top: 4px; line-height: 1.3;
        }
        /* History rows: secondary "who" line under the action verb */
        .portal-row .pr-sub-name {
            font-size: 0.8rem; color: #475569;
            margin-top: 2px; line-height: 1.4;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        /* Tone-coloured action badges */
        .pr-badge.tone-success { background: #dcfce7; color: #15803d; }
        .pr-badge.tone-danger  { background: #fee2e2; color: #b91c1c; }
        .pr-badge.tone-warning { background: #fef3c7; color: #b45309; }
        .pr-badge.tone-info    { background: #dbeafe; color: #1d4ed8; }

        /* ─── Detail popup ─────────────────────────────────────── */
        .ifl-detail-backdrop {
            position: fixed; inset: 0;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            display: flex; align-items: center; justify-content: center;
            z-index: 5000;
            opacity: 0; pointer-events: none;
            transition: opacity 0.18s ease;
        }
        .ifl-detail-backdrop.is-open { opacity: 1; pointer-events: auto; }
        .ifl-detail-card {
            background: #fff;
            border-radius: 14px;
            width: min(640px, calc(100vw - 32px));
            max-height: calc(100vh - 80px);
            box-shadow: 0 20px 60px -16px rgba(0, 0, 0, 0.35);
            transform: translateY(8px) scale(0.97);
            transition: transform 0.18s ease;
            display: flex; flex-direction: column;
            overflow: hidden;
        }
        .ifl-detail-backdrop.is-open .ifl-detail-card { transform: translateY(0) scale(1); }

        .ifl-detail-header {
            padding: 22px 26px;
            background: linear-gradient(120deg, #0078D4 0%, #005fa8 100%);
            color: #fff;
            display: flex; align-items: center; justify-content: space-between;
            gap: 12px;
            flex-shrink: 0;
        }
        .ifl-detail-header .idh-name { font-size: 1.05rem; font-weight: 700; line-height: 1.3; }
        .ifl-detail-header .idh-sub { font-size: 0.82rem; opacity: 0.88; margin-top: 2px; }
        .ifl-detail-close {
            background: rgba(255,255,255,0.18);
            border: none; color: #fff;
            width: 32px; height: 32px; border-radius: 50%;
            cursor: pointer; font-size: 18px; line-height: 1;
            flex-shrink: 0;
        }
        .ifl-detail-close:hover { background: rgba(255,255,255,0.32); }

        .ifl-detail-body {
            padding: 22px 26px;
            overflow-y: auto; flex: 1;
        }
        .ifl-detail-state {
            text-align: center; padding: 32px 0;
            color: #64748b; font-size: 0.9rem;
        }
        .ifl-detail-state .idsp {
            width: 26px; height: 26px;
            border: 3px solid #e2e8f0;
            border-top-color: #0078D4;
            border-radius: 50%;
            animation: ps-spin 0.8s linear infinite;
            display: inline-block; margin-bottom: 8px;
        }

        .ifl-detail-section {
            margin-bottom: 18px;
        }
        .ifl-detail-section:last-child { margin-bottom: 0; }
        .ifl-detail-section h4 {
            font-size: 0.72rem; font-weight: 700; color: #64748b;
            letter-spacing: 0.06em; text-transform: uppercase;
            margin: 0 0 10px;
            padding-bottom: 6px;
            border-bottom: 1px solid #f1f5f9;
        }
        .ifl-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px 18px;
        }
        .ifl-detail-grid .idg-label {
            font-size: 0.7rem; font-weight: 600;
            color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;
            margin-bottom: 2px;
        }
        .ifl-detail-grid .idg-value {
            font-size: 0.92rem; color: #0f172a; font-weight: 500;
            word-break: break-word;
        }
        .ifl-detail-pill {
            display: inline-block; padding: 3px 10px; border-radius: 999px;
            font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.04em;
        }
        .ifl-detail-pill.is-pending { background: #fef3c7; color: #b45309; }
        .ifl-detail-pill.is-done    { background: #dcfce7; color: #15803d; }
        .ifl-detail-pill.is-rejected{ background: #fee2e2; color: #b91c1c; }

        /* Timeline within modal */
        .ifl-detail-timeline { padding-left: 0; list-style: none; margin: 0; }
        .ifl-detail-timeline li {
            position: relative;
            padding: 0 0 16px 28px;
            border-left: 2px solid #e2e8f0;
            margin-left: 9px;
        }
        .ifl-detail-timeline li:last-child { border-left-color: transparent; padding-bottom: 0; }
        .ifl-detail-timeline .idt-dot {
            position: absolute; left: -9px; top: 0;
            width: 18px; height: 18px; border-radius: 50%;
            background: #0078D4; color: #fff;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 0.65rem; font-weight: 700;
            box-shadow: 0 0 0 3px #fff;
        }
        .ifl-detail-timeline .idt-dot.is-done { background: #16a34a; }
        .ifl-detail-timeline .idt-dot.is-rejected { background: #dc2626; }
        .ifl-detail-timeline .idt-action { font-size: 0.88rem; color: #0f172a; font-weight: 500; line-height: 1.4; }
        .ifl-detail-timeline .idt-meta { font-size: 0.72rem; color: #94a3b8; margin-top: 3px; }
        .ifl-detail-timeline .idt-role { font-weight: 700; color: #475569; margin-right: 6px; }
    </style>
    <div class="portal-shell">
        <aside class="portal-sidebar">
            <div class="portal-side-head">
                <div class="ps-role"><%= roleLabel %></div>
                <div class="ps-title">My Queue</div>
                <div class="ps-sub">Tasks routed to your role</div>
            </div>
            <div class="portal-tabs">
                <button type="button" class="portal-tab is-active" data-tab="pending" onclick="iflPortal.switchTab('pending')">
                    Pending <span class="ps-count" id="ps-count-pending"></span>
                </button>
                <button type="button" class="portal-tab" data-tab="history" onclick="iflPortal.switchTab('history')">
                    History <span class="ps-count" id="ps-count-history"></span>
                </button>
            </div>
            <div class="portal-list" id="portalList">
                <div class="portal-list-state">
                    <div class="pls-spin"></div>
                    <div>Loading your tasks…</div>
                </div>
            </div>
        </aside>

        <!-- Detail popup (history-row click target) -->
        <div id="iflDetailBackdrop" class="ifl-detail-backdrop" aria-hidden="true">
          <div class="ifl-detail-card" role="dialog" aria-labelledby="iflDetailName">
            <div class="ifl-detail-header">
              <div>
                <div class="idh-name" id="iflDetailName">Request</div>
                <div class="idh-sub" id="iflDetailSub"></div>
              </div>
              <button class="ifl-detail-close" type="button" onclick="iflPortalDetail.close()" aria-label="Close">×</button>
            </div>
            <div class="ifl-detail-body" id="iflDetailBody">
              <div class="ifl-detail-state"><div class="idsp"></div><div>Loading details…</div></div>
            </div>
          </div>
        </div>

        <main class="portal-main">
    <% } %>

    <div class="app-container">

        <div class="steps-container">
            <div class="steps">
                <% steps.forEach((s, i)=> { %>
                    <div class="step-item <%= s.status %>">
                        <div class="step-circle">
                            <%= i + 1 %>
                        </div>
                        <div class="step-label">
                            <%= s.label %>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>

        <form method="POST" action="<%- formAction %>" <%- formEnctype %>>
            <% if (role==='DCIImplementer' ) { %>
                <input type="hidden" name="token" value="<%= token %>">
                <% } %>

                    <div class="form-content">

                        <!-- Section 1: Requestor Information -->
                        <div class="section-title">
                            <span>Employee Details</span>
                            <span class="section-tag">HR</span>
                        </div>

                        <!-- Requester block — auto-filled from logged-in initiator -->
                        <div class="grid-2" style="margin-bottom:16px;">
                            <div class="form-group">
                                <label>Requester Name <span style="color:#64748b; font-weight:400; font-size:0.8rem;">(auto-filled)</span></label>
                                <input type="text" name="requesterName" value="<%= val('requesterName') %>" readonly style="background:#f1f5f9;">
                            </div>
                            <div class="form-group">
                                <label>Requester Email</label>
                                <input type="text" name="requesterEmail" value="<%= val('requesterEmail') %>" readonly style="background:#f1f5f9;">
                            </div>
                        </div>

                        <!-- Details / Purpose explainer -->
                        <div class="form-group full-width" style="background:#fefce8; border:1px solid #fde68a; border-radius:8px; padding:12px 16px; margin-bottom:20px;">
                            <label style="font-weight:600; color:#854d0e;">Request Details</label>
                            <p style="margin:4px 0 0; color:#713f12; font-size:0.85rem;">
                                Please clearly describe <strong>what needs to be configured</strong> for this employee —
                                e.g. services required, access levels, email setup, printer assignments, and any special permissions.
                            </p>
                        </div>

                        <div class="form-group full-width"
                            style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
                            <label style="font-weight: 700; color: #0f172a; font-size: 1rem;">Employee ID</label>
                            <div style="display: flex; gap: 12px; align-items: center;">
                                <input type="text" id="employeeIdInput" name="employeeId"
                                    value="<%= val('employeeId') %>" <%=hrDisabled %> required style="flex: 1;
                                font-size: 1.1rem; padding: 12px; max-width: 300px;">
                                <% if (role==='HR' ) { %>
                                    <button type="button" id="btnGetEmployee" class="btn btn-primary"
                                        style="height: 48px; display: flex; align-items: center; gap: 8px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                            fill="currentColor" viewBox="0 0 16 16">
                                            <path
                                                d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                        </svg>
                                        Get Employee Data
                                    </button>
                                    <% } %>
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="fullName" value="<%= val('fullName') %>" <%=hrDisabled %>
                                required>
                            </div>
                            <div class="form-group">
                                <label>Request Mode</label>
                                <select name="requestMode" <%=hrDisabled %>>
                                    <option value="New" <%=val('requestMode')==='New' ? 'selected' : '' %>>New Hiring
                                    </option>
                                    <option value="Change" <%=val('requestMode')==='Change' ? 'selected' : '' %>>Change
                                        / Modification</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid-3">
                            <div class="form-group"><label>Department</label><input type="text" name="department"
                                    value="<%= val('department') %>" <%=hrDisabled %>></div>
                            <div class="form-group"><label>Sub-Department</label><input type="text" name="subDepartment"
                                    value="<%= val('subDepartment') %>" <%=hrDisabled %>></div>
                            <div class="form-group"><label>Designation</label><input type="text" name="designation"
                                    value="<%= val('designation') %>" <%=hrDisabled %>></div>
                        </div>
                        <div class="grid-2">
                            <div class="form-group"><label>Location</label><input type="text" name="location"
                                    value="<%= val('location') %>" <%=hrDisabled %>></div>
                        </div>
                        <div class="grid-3">
                            <div class="form-group"><label>HOD Name</label><input type="text" name="hod"
                                    value="<%= val('hod') %>" <%=hrDisabled %>></div>
                            <div class="form-group">
                                <label>Joining Date</label>
                                <input type="date" name="joiningDate"
                                    value="<%= (function(){ if(!val('joiningDate')) return ''; const d = new Date(val('joiningDate')); return isNaN(d.getTime()) ? '' : d.toISOString().split('T')[0]; })() %>"
                                    <%=hrDisabled %>>
                            </div>
                            <div class="form-group"><label>Office Extension</label><input type="text"
                                    name="officeExtension" value="<%= val('officeExtension') %>" <%=hrDisabled %>></div>
                        </div>

                        <% if (role !=='HR' || request.id) { %>
                            <!-- Section 2: IT Services -->
                            <div class="it-services-box">
                                <div class="section-title">
                                    <span>IT Services Configuration</span>
                                    <span class="section-tag">IT Operations</span>
                                </div>

                                <div class="checkbox-card-group">
                                    <label class="checkbox-card">
                                        <input type="checkbox" name="intranetAccess"
                                            <%= (request.intranetAccess === false) ? '' : 'checked' %>
                                            <%= servicesDisabled %>>
                                            <span>Intranet Access <small style="color:#64748b;">(default)</small></span>
                                    </label>
                                </div>

                                <div style="margin-top: 20px;">
                                    <label style="margin-bottom: 8px; display:block; font-weight:600;">Email
                                        Services</label>
                                    <div class="checkbox-card-group">
                                        <label class="checkbox-card">
                                            <input type="checkbox" name="emailIncoming" <%=chk('emailIncoming') %>
                                            <%= servicesDisabled %>>
                                                <span>Incoming Email</span>
                                        </label>
                                        <label class="checkbox-card">
                                            <input type="checkbox" name="emailOutgoing" <%=chk('emailOutgoing') %>
                                            <%= servicesDisabled %>>
                                                <span>Outgoing Email</span>
                                        </label>

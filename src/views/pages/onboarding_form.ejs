<%- include('../partials/header', { title: 'IT Onboarding Workflow' }) %>
    <link rel="stylesheet" href="/css/modern.css">

    <%
    // When an action token is present (email-link click), the form must be
    // hidden until the SSO email is verified against the expected approver.
    // The body starts in "is-verifying" state; the verification JS lifts
    // this once the check passes — or the rejection screen replaces it.
    %>
    <% if (token && typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail) { %>
    <style>
        body.ifl-is-verifying > *:not(#iflVerifyOverlay) { visibility: hidden !important; }
        #iflVerifyOverlay {
            position: fixed; inset: 0;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            z-index: 9999;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: opacity 0.25s ease;
        }
        #iflVerifyOverlay.is-fading-out { opacity: 0; pointer-events: none; }
        #iflVerifyOverlay .iflv-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px 48px;
            box-shadow: 0 12px 40px -8px rgba(15, 76, 129, 0.18);
            display: flex; flex-direction: column; align-items: center; gap: 18px;
            min-width: 320px;
        }
        #iflVerifyOverlay .iflv-spinner {
            width: 56px; height: 56px;
            border: 4px solid #e0f2fe;
            border-top-color: #0078D4;
            border-radius: 50%;
            animation: iflv-spin 0.8s linear infinite;
        }
        @keyframes iflv-spin { to { transform: rotate(360deg); } }
        #iflVerifyOverlay .iflv-title { font-size: 1.05rem; font-weight: 700; color: #0F172A; margin: 0; }
        #iflVerifyOverlay .iflv-sub   { font-size: 0.88rem; color: #64748B; margin: 0; line-height: 1.5; text-align: center; max-width: 320px; }
        #iflVerifyOverlay .iflv-logo  { height: 44px; opacity: 0.92; margin-bottom: 4px; }
    </style>
    <script>
        // Apply the cloak immediately (before DOM parses further) so the form
        // never paints for an unauthorized viewer.
        document.documentElement.style.background = 'linear-gradient(135deg,#f8fafc,#e0f2fe)';
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('ifl-is-verifying');
        });
    </script>
    <div id="iflVerifyOverlay">
        <div class="iflv-card">
            <img src="/logo.png" alt="IFL" class="iflv-logo" onerror="this.style.display='none'">
            <div class="iflv-spinner"></div>
            <h3 class="iflv-title">Verifying your access…</h3>
            <p class="iflv-sub">Please wait while we confirm you are the intended recipient of this action.</p>
        </div>
    </div>
    <% } %>

    <!-- Header is now outside the constrained container to allow full width -->
    <header class="app-header">
        <div class="brand-section">
            <img src="/logo.png" alt="IFL" class="logo" onerror="this.style.display='none'">
            <div class="app-title">
                <h1>IT Onboarding Workflow</h1>
                <p>Ibrahim Fibers Limited</p>
            </div>
        </div>
        <div class="status-section">
            <% if (token) { %>
                <div class="status-badge">REQ #<%= request.id || 'NEW' %> | <%= role %>
                </div>
                <% } %>
        </div>
    </header>

    <%
    // Portal layout — when an approver opens the form via an email link (any
    // role except HR/read-only with a workflow token), we wrap the form in a
    // shell with a left sidebar that shows the role's pending tasks + history.
    // The sidebar fetches /api/onboarding/queue and renders rows the user
    // can click to switch between their workitems without going back to email.
    %>
    <%- include('../partials/portal_shell') %>

    <div class="app-container">

        <div class="steps-container">
            <div class="steps">
                <% steps.forEach((s, i)=> { %>
                    <div class="step-item <%= s.status %>">
                        <div class="step-circle">
                            <%= i + 1 %>
                        </div>
                        <div class="step-label">
                            <%= s.label %>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>

        <form method="POST" action="<%- formAction %>" <%- formEnctype %>>
            <% if (role==='DCIImplementer' ) { %>
                <input type="hidden" name="token" value="<%= token %>">
                <% } %>

                    <div class="form-content">

                        <!-- Section 1: Requestor Information -->
                        <div class="section-title">
                            <span>Employee Details</span>
                            <span class="section-tag">HR</span>
                        </div>

                        <!-- Requester block — auto-filled from logged-in initiator -->
                        <div class="grid-2" style="margin-bottom:16px;">
                            <div class="form-group">
                                <label>Requester Name <span style="color:#64748b; font-weight:400; font-size:0.8rem;">(auto-filled)</span></label>
                                <input type="text" name="requesterName" value="<%= val('requesterName') %>" readonly style="background:#f1f5f9;">
                            </div>
                            <div class="form-group">
                                <label>Requester Email</label>
                                <input type="text" name="requesterEmail" value="<%= val('requesterEmail') %>" readonly style="background:#f1f5f9;">
                            </div>
                        </div>

                        <!-- Details / Purpose explainer -->
                        <div class="form-group full-width" style="background:#fefce8; border:1px solid #fde68a; border-radius:8px; padding:12px 16px; margin-bottom:20px;">
                            <label style="font-weight:600; color:#854d0e;">Request Details</label>
                            <p style="margin:4px 0 0; color:#713f12; font-size:0.85rem;">
                                Please clearly describe <strong>what needs to be configured</strong> for this employee —
                                e.g. services required, access levels, email setup, printer assignments, and any special permissions.
                            </p>
                        </div>

                        <div class="form-group full-width"
                            style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
                            <label style="font-weight: 700; color: #0f172a; font-size: 1rem;">Employee ID</label>
                            <div style="display: flex; gap: 12px; align-items: center;">
                                <input type="text" id="employeeIdInput" name="employeeId"
                                    value="<%= val('employeeId') %>" <%=hrDisabled %> required style="flex: 1;
                                font-size: 1.1rem; padding: 12px; max-width: 300px;">
                                <% if (role==='HR' ) { %>
                                    <button type="button" id="btnGetEmployee" class="btn btn-primary"
                                        style="height: 48px; display: flex; align-items: center; gap: 8px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                            fill="currentColor" viewBox="0 0 16 16">
                                            <path
                                                d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                        </svg>
                                        Get Employee Data
                                    </button>
                                    <% } %>
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="fullName" value="<%= val('fullName') %>" <%=hrDisabled %>
                                required>
                            </div>
                            <div class="form-group">
                                <label>Request Mode</label>
                                <select name="requestMode" <%=hrDisabled %>>
                                    <option value="New" <%=val('requestMode')==='New' ? 'selected' : '' %>>New Hiring
                                    </option>
                                    <option value="Change" <%=val('requestMode')==='Change' ? 'selected' : '' %>>Change
                                        / Modification</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid-3">
                            <div class="form-group"><label>Department</label><input type="text" name="department"
                                    value="<%= val('department') %>" <%=hrDisabled %>></div>
                            <div class="form-group"><label>Sub-Department</label><input type="text" name="subDepartment"
                                    value="<%= val('subDepartment') %>" <%=hrDisabled %>></div>
                            <div class="form-group"><label>Designation</label><input type="text" name="designation"
                                    value="<%= val('designation') %>" <%=hrDisabled %>></div>
                        </div>
                        <div class="grid-2">
                            <div class="form-group">
                                <label>Location Group
                                    <span style="color:#64748b; font-weight:400; font-size:0.8rem;">
                                        (derived from your HR assignment)
                                    </span>
                                </label>
                                <%
                                    // For HR initiate: location is server-derived from the HR's
                                    // configured group at submit time, so we render it readonly with
                                    // a friendly label here. For all later stages the request already
                                    // carries `request.location` (a group key) — display its label.
                                    let locDisplay = val('location') || '';
                                    try {
                                        const _locModule = locDisplay && typeof locationGroupLabels !== 'undefined'
                                            ? locationGroupLabels[locDisplay] : null;
                                        if (_locModule) locDisplay = _locModule;
                                    } catch(_) {}
                                %>
                                <input type="text" name="location" value="<%= locDisplay %>"
                                       readonly style="background:#f1f5f9;">
                            </div>
                        </div>
                        <div class="grid-3">
                            <div class="form-group"><label>HOD Name</label><input type="text" name="hod"
                                    value="<%= val('hod') %>" <%=hrDisabled %>></div>
                            <div class="form-group">
                                <label>Joining Date</label>
                                <input type="date" name="joiningDate"
                                    value="<%= (function(){ if(!val('joiningDate')) return ''; const d = new Date(val('joiningDate')); return isNaN(d.getTime()) ? '' : d.toISOString().split('T')[0]; })() %>"
                                    <%=hrDisabled %>>
                            </div>
                            <div class="form-group"><label>Office Extension</label><input type="text"
                                    name="officeExtension" value="<%= val('officeExtension') %>" <%=hrDisabled %>></div>
                        </div>

                        <% if (role !=='HR' || request.id) { %>
                            <!-- Section 2: IT Services -->
                            <div class="it-services-box">
                                <div class="section-title">
                                    <span>IT Services Configuration</span>
                                    <span class="section-tag">IT Operations</span>
                                </div>

                                <div class="checkbox-card-group">
                                    <label class="checkbox-card">
                                        <input type="checkbox" name="intranetAccess"
                                            <%= (request.intranetAccess === false) ? '' : 'checked' %>
                                            <%= servicesDisabled %>>
                                            <span>Intranet Access <small style="color:#64748b;">(default)</small></span>
                                    </label>
                                </div>

                                <div style="margin-top: 20px;">
                                    <label style="margin-bottom: 8px; display:block; font-weight:600;">Email
                                        Services</label>
                                    <div class="checkbox-card-group">
                                        <label class="checkbox-card">
                                            <input type="checkbox" name="emailIncoming" <%=chk('emailIncoming') %>
                                            <%= servicesDisabled %>>
                                                <span>Incoming Email</span>
                                        </label>
                                        <label class="checkbox-card">
                                            <input type="checkbox" name="emailOutgoing" <%=chk('emailOutgoing') %>
                                            <%= servicesDisabled %>>
                                                <span>Outgoing Email</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group full-width" style="margin-top: 10px;">
                                    <label style="font-weight:600; font-size:0.85rem;">Email Details — specify what needs to be configured (recipients, limits, distribution lists, business justification):</label>
                                    <textarea name="emailPurpose" rows="2"
                                        placeholder="E.g. External email required for vendor communication; CC list: procurement@...; incoming only."
                                        <%=servicesDisabled %>><%= val('emailPurpose') %></textarea>
                                </div>

                                <div style="margin-top: 20px;">
                                    <label style="margin-bottom: 8px; display:block; font-weight:600;">Printing
                                        Services</label>
                                    <div class="grid-2">
                                        <div style="display:flex; gap:10px; align-items:center;">
                                            <input type="checkbox" id="chk-laser" name="laserPrinter" <%=chk('laserPrinter') %>
                                            <%= servicesDisabled %> style="width:20px; height:20px;"
                                            onchange="togglePrinterLocation('laser')">
                                            <% if (printerLocations && printerLocations.length > 0 && !servicesDisabled) { %>
                                                <select id="loc-laser" name="laserPrinterLocation" style="flex:1;">
                                                    <option value="">— Select Laser Printer —</option>
                                                    <% printerLocations.filter(p => p.name && p.name.toLowerCase().includes('laser')).forEach(p => { %>
                                                        <option value="<%= p.location %>" <%= val('laserPrinterLocation') === p.location ? 'selected' : '' %>><%= p.name %></option>
                                                    <% }) %>
                                                    <option value="<%= val('laserPrinterLocation') %>" selected><%= val('laserPrinterLocation') || 'Other' %></option>
                                                </select>
                                            <% } else { %>
                                                <input type="text" id="loc-laser" name="laserPrinterLocation"
                                                    placeholder="Laser Printer Location"
                                                    value="<%= val('laserPrinterLocation') %>" <%=servicesDisabled %>>
                                            <% } %>
                                        </div>
                                        <div style="display:flex; gap:10px; align-items:center;">
                                            <input type="checkbox" id="chk-dotmatrix" name="dotMatrixPrinter" <%=chk('dotMatrixPrinter') %>
                                            <%= servicesDisabled %> style="width:20px; height:20px;"
                                            onchange="togglePrinterLocation('dotmatrix')">
                                            <% if (printerLocations && printerLocations.length > 0 && !servicesDisabled) { %>
                                                <select id="loc-dotmatrix" name="dotMatrixPrinterLocation" style="flex:1;">
                                                    <option value="">— Select Dot Matrix —</option>
                                                    <% printerLocations.filter(p => p.name && p.name.toLowerCase().includes('matrix')).forEach(p => { %>
                                                        <option value="<%= p.location %>" <%= val('dotMatrixPrinterLocation') === p.location ? 'selected' : '' %>><%= p.name %></option>
                                                    <% }) %>
                                                    <option value="<%= val('dotMatrixPrinterLocation') %>"><%= val('dotMatrixPrinterLocation') || 'Other' %></option>
                                                </select>
                                            <% } else { %>
                                                <input type="text" id="loc-dotmatrix" name="dotMatrixPrinterLocation"
                                                    placeholder="Dot Matrix Location"
                                                    value="<%= val('dotMatrixPrinterLocation') %>" <%=servicesDisabled %>>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div style="margin-top: 20px; padding-top:20px; border-top:1px dashed #cbd5e1;">
                                    <label style="margin-bottom: 8px; display:block; font-weight:600;">File Share
                                        Services</label>
                                    <div class="grid-2">
                                        <div class="form-group">
                                            <label>Dept Share (S:)</label>
                                            <% if (fileSharePaths && fileSharePaths.length > 0 && !servicesDisabled) { %>
                                                <select name="deptSharePath">
                                                    <option value="">— Select Share —</option>
                                                    <% fileSharePaths.forEach(p => { %>
                                                        <option value="<%= p.path %>" <%= val('deptSharePath') === p.path ? 'selected' : '' %>><%= p.name %> (<%= p.path %>)</option>
                                                    <% }) %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" name="deptSharePath" value="<%= val('deptSharePath') %>" <%=servicesDisabled %>>
                                            <% } %>
                                        </div>
                                        <div class="form-group">
                                            <label>Home Folder (Z:)</label>
                                            <% if (fileSharePaths && fileSharePaths.length > 0 && !servicesDisabled) { %>
                                                <select name="homeFolderPath">
                                                    <option value="">— Select Home Folder —</option>
                                                    <% fileSharePaths.forEach(p => { %>
                                                        <option value="<%= p.path %>" <%= val('homeFolderPath') === p.path ? 'selected' : '' %>><%= p.name %> (<%= p.path %>)</option>
                                                    <% }) %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" name="homeFolderPath" value="<%= val('homeFolderPath') %>" <%=servicesDisabled %>>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="grid-2">
                                        <div class="form-group">
                                            <label>SharePoint / IFL Portal Link</label>
                                            <% if (sharepointPaths && sharepointPaths.length > 0 && !servicesDisabled) { %>
                                                <select name="iflPortalLink">
                                                    <option value="">— Select Portal —</option>
                                                    <% sharepointPaths.forEach(p => { %>
                                                        <option value="<%= p.url %>" <%= val('iflPortalLink') === p.url ? 'selected' : '' %>><%= p.name %></option>
                                                    <% }) %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" name="iflPortalLink" value="<%= val('iflPortalLink') %>" <%=servicesDisabled %>>
                                            <% } %>
                                        </div>
                                        <div class="form-group">
                                            <label>SharePoint Role <span style="color:#dc2626;">*</span></label>
                                            <select name="sharepointRole" <%=servicesDisabled %>>
                                                <option value="">— Select Role —</option>
                                                <option value="Viewer" <%= val('sharepointRole') === 'Viewer' ? 'selected' : '' %>>Viewer</option>
                                                <option value="Editor" <%= val('sharepointRole') === 'Editor' ? 'selected' : '' %>>Editor</option>
                                                <option value="Contributor" <%= val('sharepointRole') === 'Contributor' ? 'selected' : '' %>>Contributor</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                                <% if (role==='HOD' || request.hodRemarks) { %>
                                    <div class="section-title"><span>HOD Remarks</span></div>
                                    <div class="form-group full-width">
                                        <textarea name="hodRemarks" rows="3" placeholder="Enter HOD comments here..."
                                            <%=hodRemarksDisabled %>><%= val('hodRemarks') %></textarea>
                                    </div>
                                    <% } %>

                                    <!-- Change-request remarks from DCI Manager, shown to DCI team -->
                                    <% if (request.dciChangeRequestRemarks) { %>
                                        <div class="section-title"><span>Changes Requested by DCI Manager</span></div>
                                        <div class="form-group full-width">
                                            <div style="background:#fff7ed; border:1px solid #fdba74; border-radius:8px; padding:12px 14px; color:#9a3412; white-space:pre-wrap;">
                                                <%= request.dciChangeRequestRemarks %>
                                            </div>
                                        </div>
                                    <% } %>

                                        <% if (!['HR', 'IT' , 'HOD' ].includes(role) || request.ntUserName) { %>
                                            <!-- Section 3: DCI Configuration -->
                                            <div class="dci-box">
                                                <div class="section-title">
                                                    <span>DCI Configuration</span>
                                                    <span class="section-tag">DCI Team</span>
                                                </div>
                                                <div class="grid-3">
                                                    <div class="form-group"><label>NT User Name</label><input
                                                            type="text" name="ntUserName"
                                                            value="<%= val('ntUserName') %>" <%=configDisabled %>></div>
                                                    <div class="form-group"><label>Exchange Name</label><input
                                                            type="text" name="exchangeDisplayName"
                                                            value="<%= val('exchangeDisplayName') %>" <%=configDisabled
                                                            %>></div>
                                                    <div class="form-group"><label>SMTP Address</label><input
                                                            type="text" name="smtpAddress"
                                                            value="<%= val('smtpAddress') %>" <%=configDisabled %>>
                                                    </div>
                                                </div>
                                                <div class="grid-2">
                                                    <div class="form-group"><label>Member Of</label><input type="text"
                                                            name="memberOf" value="<%= val('memberOf') %>"
                                                            <%=configDisabled %>></div>
                                                    <div class="form-group"><label>DG Members</label><input type="text"
                                                            name="dgMembers" value="<%= val('dgMembers') %>"
                                                            <%=configDisabled %>></div>
                                                </div>
                                                <div class="grid-3">
                                                    <div class="form-group"><label>Mail Size</label><input type="text"
                                                            name="mailSizeLimit" value="<%= val('mailSizeLimit') %>"
                                                            <%=configDisabled %>></div>
                                                    <div class="form-group"><label>Recipient Limit</label><input
                                                            type="text" name="recipientLimit"
                                                            value="<%= val('recipientLimit') %>" <%=configDisabled %>>
                                                    </div>
                                                    <div class="form-group"><label>Storage Limit</label><input
                                                            type="text" name="mailboxStorageLimit"
                                                            value="<%= val('mailboxStorageLimit') %>" <%=configDisabled
                                                            %>></div>
                                                </div>
                                                <div class="form-group"><label>Group Policy Level</label>
                                                    <select name="groupPolicyLevel" <%=configDisabled %>>
                                                        <option value="">Select Level...</option>
                                                        <option value="Highly Managed"
                                                            <%=val('groupPolicyLevel')==='Highly Managed' ? 'selected'
                                                            : '' %>>Highly Managed</option>
                                                        <option value="Lightly Managed"
                                                            <%=val('groupPolicyLevel')==='Lightly Managed' ? 'selected'
                                                            : '' %>>Lightly Managed</option>
                                                        <option value="IT User" <%=val('groupPolicyLevel')==='IT User'
                                                            ? 'selected' : '' %>>IT User</option>
                                                    </select>
                                                </div>
                                                <div class="form-group"><label>Extra Facility</label><textarea
                                                        name="extraFacility" rows="2" <%=configDisabled
                                                        %>><%= val('extraFacility') %></textarea></div>
                                                <div class="form-group full-width">
                                                    <label>DCI Remarks / Instructions</label>
                                                    <textarea name="dciRemarks" rows="3" <%=dciRemarksDisabled
                                                        %>><%= val('dciRemarks') %></textarea>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- IT HOD Remarks — placed after the DCI Manager / DCI Configuration
                                                     section so the approval chain reads top-to-bottom:
                                                     HOD → DCI Manager → IT HOD. -->
                                                <% if (role==='ITHOD' || request.itHodRemarks) { %>
                                                    <div class="section-title"><span>IT HOD Remarks</span></div>
                                                    <div class="form-group full-width">
                                                        <textarea name="itHodRemarks" rows="3" placeholder="Enter IT HOD remarks / notes..."
                                                            <%= role === 'ITHOD' ? '' : 'disabled' %>><%= val('itHodRemarks') %></textarea>
                                                    </div>
                                                <% } %>

                                                <!-- OPS Checklist Dynamic -->
                                                <%- typeof opsChecklistHTML !=='undefined' ? opsChecklistHTML : '' %>

                                                    <!-- DCI Implementation -->
                                                    <% if (role==='DCIImplementer' ) { %>
                                                        <div class="dci-box" style="border-color: var(--primary);">
                                                            <div class="section-title"><span>Proof of
                                                                    Implementation</span></div>
                                                            <div class="form-group">
                                                                <label>Implementer Name
                                                                    <span style="color:#64748b; font-weight:400; font-size:0.8rem;">
                                                                        (auto-filled from Windows login)
                                                                    </span>
                                                                </label>
                                                                <input type="text" name="implementerName"
                                                                    data-ifl-sso-name="1"
                                                                    value="<%= (currentUser && (currentUser.displayName || currentUser.username)) || '' %>"
                                                                    disabled
                                                                    style="background:#f1f5f9; color:#0f172a;">
                                                            </div>
                                                            <div class="form-group"
                                                                style="padding: 20px; border: 2px dashed #cbd5e1; text-align: center; border-radius: 8px;">
                                                                <label
                                                                    style="cursor: pointer; color: var(--primary); font-weight: 600;">Click
                                                                    to Upload Screenshots (AD/Exchange)</label>
                                                                <input type="file" name="dciProof" multiple
                                                                    accept="image/*" required style="margin-top: 10px;">
                                                            </div>
                                                        </div>
                                                        <% } %>

                    </div>

                    <div class="action-bar">
                        <% if (role==='HR' ) { %><button type="submit" class="btn btn-primary">Submit Request</button>
                            <% } %>
                                <% if (role==='IT' ) { %><button type="submit" class="btn btn-primary">Save & Forward to
                                        HOD</button>
                                    <% } %>

                                        <% if (role==='HOD' ) { %>
                                            <button type="submit" name="action" value="Reject"
                                                class="btn btn-danger">Reject</button>
                                            <button type="submit" name="action" value="Approve"
                                                class="btn btn-success">Approve</button>
                                            <% } %>

                                                <% if (role==='DCI' ) { %><button type="submit"
                                                        class="btn btn-primary">Save & Forward to Manager</button>
                                                    <% } %>

                                                        <% if (role==='DCIManager') { %>
                                                            <button type="submit" name="action" value="Reject"
                                                                class="btn btn-danger">Reject Request</button>
                                                            <button type="submit" name="action" value="RequestChanges"
                                                                class="btn btn-secondary"
                                                                data-ifl-confirm="Send this request back to the DCI Team for changes?"
                                                                data-ifl-confirm-title="Request changes"
                                                                data-ifl-confirm-ok="Send back">
                                                                Request Changes
                                                            </button>
                                                            <button type="submit" name="action" value="Approve"
                                                                class="btn btn-success">Approve Request</button>
                                                            <% } %>
                                                        <% if (role==='ITHOD') { %>
                                                            <button type="submit" name="action" value="Reject"
                                                                class="btn btn-danger">Reject Request</button>
                                                            <button type="submit" name="action" value="Approve"
                                                                class="btn btn-success">Approve Request</button>
                                                            <% } %>

                                                                <% if (role==='DCIImplementer' ) { %><button
                                                                        type="submit" class="btn btn-primary">Upload
                                                                        Proofs & Complete</button>
                                                                    <% } %>
                                                                        <% if (role==='OPS' ) { %><button type="submit"
                                                                                class="btn btn-success">Verify & Close
                                                                                Request</button>
                                                                            <% } %>
                    </div>
        </form>

        <%
        // Workflow Progress — placed at the bottom of the form so it doesn't
        // crowd the action area. Minimal: each entry shows only the role that
        // acted and when, nothing else. Hidden when the timeline is empty.
        %>
        <% if (typeof timeline !== 'undefined' && timeline && timeline.length) { %>
            <style>
                .wf-history-card { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:16px 20px; margin-top:24px; }
                .wf-history-title { font-size:0.8rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px; }
                .wf-history-list { margin:0; padding-left:0; list-style:none; }
                .wf-step { position:relative; padding-left:34px; padding-bottom:14px; margin-left:11px; border-left:2px solid #e2e8f0; }
                .wf-step.is-last { border-left-color: transparent; padding-bottom:0; }
                .wf-step .wf-dot { position:absolute; left:-11px; top:0; width:22px; height:22px; border-radius:50%; background:#3b82f6; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; box-shadow:0 0 0 4px #f8fafc; }
                .wf-step .wf-role { font-size:0.95rem; color:#0f172a; font-weight:600; line-height:1.3; }
                .wf-step .wf-time { font-size:0.78rem; color:#94a3b8; margin-top:2px; }
            </style>
            <div class="wf-history-card">
                <div class="wf-history-title">Workflow Progress</div>
                <ol class="wf-history-list">
                    <% timeline.forEach((ev, i) => { %>
                        <li class="wf-step <%= i === timeline.length - 1 ? 'is-last' : '' %>">
                            <span class="wf-dot"><%= i + 1 %></span>
                            <div class="wf-role"><%= ev.actorRole || '—' %></div>
                            <div class="wf-time"><%= new Date(ev.timestamp).toLocaleString() %></div>
                        </li>
                    <% }) %>
                </ol>
            </div>
        <% } %>
    </div>

    <%- include('../partials/portal_close') %>

    <style>
        /* Loading spinner animation for submit buttons */
        @keyframes ifl-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .ifl-spinner { animation: ifl-spin 0.7s linear infinite; vertical-align: -3px; margin-right: 6px; }
        button.is-loading { opacity: 0.75; cursor: wait; pointer-events: none; }
        button.is-loading > .ifl-btn-original { display: none; }
        button:disabled { cursor: not-allowed; }
    </style>
    <script>
        /* ─── SSO pre-fill: populate requester name/email from /api/auth/me ─
             on page load. Uses window.iflGetUser() exposed by the SSO badge
             script in header.ejs. Only fills empty fields so we never clobber
             values the server already rendered (token-bearing stages). */
        document.addEventListener('DOMContentLoaded', async () => {
            const expected = <%- JSON.stringify(typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail ? expectedAssigneeEmail : null) %>;
            const overlay  = document.getElementById('iflVerifyOverlay');

            // Local-part comparison: same person can be ali.khan@ifl.net in
            // HRMS and ali.khan@igc.com.pk in AD — domain varies, local-part
            // stays consistent. Mirror of src/utils/emailMatch.js.
            const emailLocalPart = (e) => {
                if (!e || typeof e !== 'string') return '';
                const at = e.indexOf('@');
                if (at <= 0) return '';
                return e.slice(0, at).toLowerCase().trim();
            };
            const emailsMatch = (a, b) => {
                const la = emailLocalPart(a);
                const lb = emailLocalPart(b);
                return !!la && la === lb;
            };

            // Helper: dismiss the verification cloak (only present when expected != null)
            const liftCloak = () => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) {
                    overlay.classList.add('is-fading-out');
                    setTimeout(() => overlay.remove(), 260);
                }
            };

            // Helper: replace the entire page with the rejection card
            const showRejection = (expectedEmail, actualLabel) => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) overlay.remove();
                document.body.innerHTML = `
                  <div style="max-width:560px;margin:80px auto;padding:36px;background:#fff;border:1px solid #fee2e2;border-radius:14px;text-align:center;font-family:'Segoe UI',sans-serif;box-shadow:0 12px 40px -8px rgba(220,38,38,.18);">
                    <div style="width:72px;height:72px;border-radius:50%;background:#fee2e2;color:#b91c1c;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 18px;">⛔</div>
                    <h2 style="color:#b91c1c;margin:0 0 14px;font-size:1.15rem;">This page is authorized only for the intended recipient</h2>
                    <p style="color:#475569;line-height:1.55;margin:0 0 14px;">
                      This action link was sent to <strong>${expectedEmail}</strong>.<br>
                      You are signed in as <strong>${actualLabel}</strong>, so you cannot act on this request.
                    </p>
                    <p style="color:#64748b;font-size:.9rem;">If you need to handle it on someone's behalf, please contact your administrator.</p>
                  </div>`;
            };

            // Hydrate any input marked data-ifl-sso-name="1" (DCI Implementer's
            // "Implementer Name", OPS Verifier's "Verifier Name", etc.) with
            // the SSO display name. These inputs are rendered `disabled`, so
            // they're informational only — the server uses req.user to record
            // the actor identity, never the form value.
            const fillSsoNameFields = (u) => {
                const v = (u && (u.displayName || u.username)) || '';
                if (!v) return;
                document.querySelectorAll('input[data-ifl-sso-name="1"]').forEach(el => {
                    if (!el.value) el.value = v;
                });
            };

            // No expected email → not an SSO-gated stage (e.g. HR initiate). Lift any cloak and exit.
            if (!expected) {
                liftCloak();
                // Still attempt the standard pre-fill below
                try {
                    if (typeof window.iflGetUser === 'function') {
                        const u = await window.iflGetUser();
                        if (u) {
                            const nameEl  = document.querySelector('input[name="requesterName"]');
                            const emailEl = document.querySelector('input[name="requesterEmail"]');
                            if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                            if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                            fillSsoNameFields(u);
                        }
                    }
                } catch (_) {}
                return;
            }

            // Expected email present → mandatory SSO verification
            if (typeof window.iflGetUser !== 'function') {
                showRejection(expected, 'an unverified user (SSO not available on this device)');
                return;
            }
            try {
                const u = await window.iflGetUser();
                if (!u || !u.email) {
                    showRejection(expected, 'an unverified user');
                    return;
                }
                if (!emailsMatch(u.email, expected)) {
                    showRejection(expected, u.email || u.username);
                    return;
                }
                // Verified! Pre-fill any empty requester fields and reveal the form.
                const nameEl  = document.querySelector('input[name="requesterName"]');
                const emailEl = document.querySelector('input[name="requesterEmail"]');
                if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                fillSsoNameFields(u);
                liftCloak();
            } catch (e) {
                // SSO call failed for some reason (token.aspx unreachable, network, etc.)
                showRejection(expected, 'an unverified user (SSO check failed)');
            }
        });

        /* Wrap the action-bar form so any submit click attaches the SSO
           sidecar token, shows a spinner and locks the buttons. */
        (function setupSubmitLoaders() {
            const SPINNER_SVG = '<svg class="ifl-spinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>';

            // Add a hidden field to the form holding the latest sidecar token,
            // so server-side ssoMiddleware can authenticate the POST.
            const ensureTokenField = async (form) => {
                if (typeof window.iflGetToken !== 'function') return;
                let hidden = form.querySelector('input[name="x-sidecar-token"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'x-sidecar-token';
                    form.appendChild(hidden);
                }
                try {
                    hidden.value = await window.iflGetToken();
                } catch (_) { /* leave value empty; server will return a clear 401 */ }
            };

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('form').forEach(form => {
                    form.addEventListener('submit', async (e) => {
                        // Run native validation first; if it fails, don't lock the buttons.
                        if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;

                        const submitter = e.submitter || form.querySelector('button[type="submit"]:focus') || form.querySelector('button[type="submit"]');

                        // If the submitter declares a confirm prompt via data-attrs,
                        // run our custom IflDialog.confirm BEFORE doing any other work.
                        const confirmMsg = submitter && submitter.dataset.iflConfirm;
                        if (confirmMsg && !form.dataset.iflConfirmed) {
                            e.preventDefault();
                            const ok = await IflDialog.confirm(confirmMsg, {
                                title:   submitter.dataset.iflConfirmTitle  || undefined,
                                okText:  submitter.dataset.iflConfirmOk     || 'Confirm',
                                danger:  submitter.dataset.iflConfirmDanger === '1'
                            });
                            if (!ok) return;
                            form.dataset.iflConfirmed = '1';
                            // Re-fire so the rest of the handler proceeds normally.
                            if (submitter && typeof submitter.click === 'function') submitter.click();
                            else form.submit();
                            return;
                        }

                        // We need the sidecar token attached to the body BEFORE
                        // the browser POSTs. Block the native submit, fetch the
                        // token, then re-trigger submission.
                        if (!form.dataset.iflTokenAttached) {
                            e.preventDefault();
                            await ensureTokenField(form);
                            form.dataset.iflTokenAttached = '1';
                            // Re-fire submission preserving the original submitter
                            // so name=value pairs from action buttons (Approve/Reject) survive.
                            if (submitter && typeof submitter.click === 'function') {
                                submitter.click();
                            } else {
                                form.submit();
                            }
                            return;
                        }

                        // Second pass — confirm passed, token attached, real submit proceeds.
                        // (`submitter` was captured at the top of this handler.)

                        // Disable every submit button in the form so the user can't double-click or pick another action
                        form.querySelectorAll('button[type="submit"]').forEach(btn => {
                            // Preserve the original label inside a span so we can restore it later
                            if (!btn.querySelector('.ifl-btn-original')) {
                                const span = document.createElement('span');
                                span.className = 'ifl-btn-original';
                                while (btn.firstChild) span.appendChild(btn.firstChild);
                                btn.appendChild(span);
                            }
                            btn.disabled = true;
                            btn.classList.add('is-loading');

                            // The clicked button gets the spinner inline
                            if (btn === submitter) {
                                const indicator = document.createElement('span');
                                indicator.className = 'ifl-btn-loading-text';
                                indicator.innerHTML = SPINNER_SVG + 'Working…';
                                btn.appendChild(indicator);
                            }
                        });

                        // Safety net: if the page hasn't navigated within 30s (server stall), restore the buttons
                        setTimeout(() => {
                            form.querySelectorAll('button[type="submit"]').forEach(btn => {
                                btn.disabled = false;
                                btn.classList.remove('is-loading');
                                const ind = btn.querySelector('.ifl-btn-loading-text');
                                if (ind) ind.remove();
                            });
                            // Allow a future submission to re-fetch a fresh token
                            delete form.dataset.iflTokenAttached;
                        }, 30000);
                    });
                });
            });
        })();

        /* Toggle printer location dropdown/input based on checkbox */
        function togglePrinterLocation(type) {
            const chk = document.getElementById('chk-' + type);
            const loc = document.getElementById('loc-' + type);
            if (chk && loc) {
                loc.disabled = !chk.checked;
                if (!chk.checked) loc.value = '';
                loc.style.opacity = chk.checked ? '1' : '0.5';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Set initial state for printer location fields
            togglePrinterLocation('laser');
            togglePrinterLocation('dotmatrix');

            const btn = document.getElementById('btnGetEmployee');
            if (btn) {
                btn.addEventListener('click', async () => {
                    const empIdInput = document.getElementById('employeeIdInput');
                    const empId = empIdInput.value.trim();

                    if (!empId) {
                        IflDialog.warning('Please enter an Employee ID');
                        empIdInput.focus();
                        return;
                    }

                    const originalText = btn.textContent;
                    btn.textContent = 'Fetching...';
                    btn.disabled = true;

                    try {
                        const res = await fetch('/api/hrms/employee/' + empId);
                        if (!res.ok) throw new Error('Employee not found');
                        const data = await res.json();

                        // Populate fields
                        const setVal = (name, val) => {
                            const el = document.querySelector('input[name="' + name + '"]');
                            if (el && val) el.value = val;
                        };

                        setVal('fullName', data.fullName);
                        setVal('department', data.department);
                        setVal('subDepartment', data.subDepartment);
                        setVal('designation', data.designation);
                        setVal('location', data.location || data.projectUnit);
                        setVal('hod', data.hod);
                        setVal('mobile', data.mobile);
                        setVal('officeExtension', data.officeExtension);

                        // Safely parse Joining Date to YYYY-MM-DD format for HTML5 date input
                        if (data.joiningDate) {
                            const d = new Date(data.joiningDate);
                            if (!isNaN(d.getTime())) {
                                setVal('joiningDate', d.toISOString().split('T')[0]);
                            }
                        }

                        // Check if an active onboarding request already exists for this employee.
                        // HR is not allowed to view in-flight workflow data (least-privilege).
                        // We tell them the employee is locked and stop the flow — no link to trail.
                        try {
                            const existRes = await fetch('/api/onboarding/lookup?employeeId=' + encodeURIComponent(empId));
                            if (existRes.ok) {
                                const existData = await existRes.json();
                                if (existData && existData.existingRequestId) {
                                    IflDialog.warning('An onboarding request for this employee is already in progress. Please wait for it to complete before initiating a new one.', { title: 'Already in progress' });
                                    // Reset the field so HR doesn't try to submit anyway
                                    empIdInput.value = '';
                                    empIdInput.focus();
                                    return;
                                }
                            }
                        } catch (_) { /* non-fatal */ }
                    } catch (err) {
                        IflDialog.error(err.message || 'Could not look up the employee.');
                    } finally {
                        btn.textContent = originalText;
                        btn.disabled = false;
                    }
                });
            }
        });
    </script>


                    <% } %>

                </div><!-- /.form-content -->

                <!-- Workflow History (inside scroll area, visible after scrolling) -->
                <% if (typeof timeline !== 'undefined' && timeline && timeline.length) { %>
                <style>
                    .wf-history-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px 20px;margin:0 24px 24px;}
                    .wf-history-title{font-size:0.78rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;}
                    .wf-history-list{margin:0;padding-left:0;list-style:none;}

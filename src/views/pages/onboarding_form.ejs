                            <% } %>
                            <div class="form-group">
                                <label>Implementer Name <span style="color:#9ca3af;font-weight:400;text-transform:none;">(auto-filled)</span></label>
                                <input type="text" name="implementerName" data-ifl-sso-name="1"
                                    value="<%= (currentUser && (currentUser.displayName || currentUser.username)) || '' %>"

    <style>
        /* Loading spinner animation for submit buttons */
        @keyframes ifl-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .ifl-spinner { animation: ifl-spin 0.7s linear infinite; vertical-align: -3px; margin-right: 6px; }
        button.is-loading { opacity: 0.75; cursor: wait; pointer-events: none; }
        button.is-loading > .ifl-btn-original { display: none; }
        button:disabled { cursor: not-allowed; }
    </style>
    <script>
        /* ─── SSO pre-fill: populate requester name/email from /api/auth/me ─
             on page load. Uses window.iflGetUser() exposed by the SSO badge
             script in header.ejs. Only fills empty fields so we never clobber
             values the server already rendered (token-bearing stages). */
        document.addEventListener('DOMContentLoaded', async () => {
            const expected = <%- JSON.stringify(typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail ? expectedAssigneeEmail : null) %>;
            const overlay  = document.getElementById('iflVerifyOverlay');

            // Helper: dismiss the verification cloak (only present when expected != null)
            const liftCloak = () => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) {
                    overlay.classList.add('is-fading-out');
                    setTimeout(() => overlay.remove(), 260);
                }
            };

            // Helper: replace the entire page with the rejection card
            const showRejection = (expectedEmail, actualLabel) => {
                document.body.classList.remove('ifl-is-verifying');
                if (overlay) overlay.remove();
                document.body.innerHTML = `
                  <div style="max-width:560px;margin:80px auto;padding:36px;background:#fff;border:1px solid #fee2e2;border-radius:14px;text-align:center;font-family:'Segoe UI',sans-serif;box-shadow:0 12px 40px -8px rgba(220,38,38,.18);">
                    <div style="width:72px;height:72px;border-radius:50%;background:#fee2e2;color:#b91c1c;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 18px;">⛔</div>
                    <h2 style="color:#b91c1c;margin:0 0 14px;font-size:1.15rem;">This page is authorized only for the intended recipient</h2>
                    <p style="color:#475569;line-height:1.55;margin:0 0 14px;">
                      This action link was sent to <strong>${expectedEmail}</strong>.<br>
                      You are signed in as <strong>${actualLabel}</strong>, so you cannot act on this request.
                    </p>
                    <p style="color:#64748b;font-size:.9rem;">If you need to handle it on someone's behalf, please contact your administrator.</p>
                  </div>`;
            };

            // No expected email → not an SSO-gated stage (e.g. HR initiate). Lift any cloak and exit.
            if (!expected) {
                liftCloak();
                // Still attempt the standard pre-fill below
                try {
                    if (typeof window.iflGetUser === 'function') {
                        const u = await window.iflGetUser();
                        if (u) {
                            const nameEl  = document.querySelector('input[name="requesterName"]');
                            const emailEl = document.querySelector('input[name="requesterEmail"]');
                            if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                            if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                        }
                    }
                } catch (_) {}
                return;
            }

            // Expected email present → mandatory SSO verification
            if (typeof window.iflGetUser !== 'function') {
                showRejection(expected, 'an unverified user (SSO not available on this device)');
                return;
            }
            try {
                const u = await window.iflGetUser();
                if (!u || !u.email) {
                    showRejection(expected, 'an unverified user');
                    return;
                }
                if (u.email.toLowerCase().trim() !== expected.toLowerCase().trim()) {
                    showRejection(expected, u.email || u.username);
                    return;
                }
                // Verified! Pre-fill any empty requester fields and reveal the form.
                const nameEl  = document.querySelector('input[name="requesterName"]');
                const emailEl = document.querySelector('input[name="requesterEmail"]');
                if (nameEl  && !nameEl.value)  nameEl.value  = u.displayName || u.username || '';
                if (emailEl && !emailEl.value) emailEl.value = u.email || '';
                liftCloak();
            } catch (e) {
                // SSO call failed for some reason (token.aspx unreachable, network, etc.)
                showRejection(expected, 'an unverified user (SSO check failed)');
            }
        });

        /* Wrap the action-bar form so any submit click attaches the SSO
           sidecar token, shows a spinner and locks the buttons. */
        (function setupSubmitLoaders() {
            const SPINNER_SVG = '<svg class="ifl-spinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>';

            // Add a hidden field to the form holding the latest sidecar token,
            // so server-side ssoMiddleware can authenticate the POST.
            const ensureTokenField = async (form) => {
                if (typeof window.iflGetToken !== 'function') return;
                let hidden = form.querySelector('input[name="x-sidecar-token"]');
                if (!hidden) {
                    hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'x-sidecar-token';
                    form.appendChild(hidden);
                }
                try {
                    hidden.value = await window.iflGetToken();
                } catch (_) { /* leave value empty; server will return a clear 401 */ }
            };

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('form').forEach(form => {
                    form.addEventListener('submit', async (e) => {
                        // Run native validation first; if it fails, don't lock the buttons.
                        if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;

                        const submitter = e.submitter || form.querySelector('button[type="submit"]:focus') || form.querySelector('button[type="submit"]');

                        // If the submitter declares a confirm prompt via data-attrs,
                        // run our custom IflDialog.confirm BEFORE doing any other work.
                        const confirmMsg = submitter && submitter.dataset.iflConfirm;
                        if (confirmMsg && !form.dataset.iflConfirmed) {
                            e.preventDefault();
                            const ok = await IflDialog.confirm(confirmMsg, {
                                title:   submitter.dataset.iflConfirmTitle  || undefined,
                                okText:  submitter.dataset.iflConfirmOk     || 'Confirm',
                                danger:  submitter.dataset.iflConfirmDanger === '1'
                            });
                            if (!ok) return;
                            form.dataset.iflConfirmed = '1';
                            // Re-fire so the rest of the handler proceeds normally.
                            if (submitter && typeof submitter.click === 'function') submitter.click();
                            else form.submit();
                            return;
                        }

                        // We need the sidecar token attached to the body BEFORE
                        // the browser POSTs. Block the native submit, fetch the
                        // token, then re-trigger submission.
                        if (!form.dataset.iflTokenAttached) {
                            e.preventDefault();
                            await ensureTokenField(form);
                            form.dataset.iflTokenAttached = '1';
                            // Re-fire submission preserving the original submitter
                            // so name=value pairs from action buttons (Approve/Reject) survive.
                            if (submitter && typeof submitter.click === 'function') {
                                submitter.click();
                            } else {
                                form.submit();
                            }
                            return;
                        }

                        // Second pass — confirm passed, token attached, real submit proceeds.
                        // (`submitter` was captured at the top of this handler.)

                        // Disable every submit button in the form so the user can't double-click or pick another action
                        form.querySelectorAll('button[type="submit"]').forEach(btn => {
                            // Preserve the original label inside a span so we can restore it later
                            if (!btn.querySelector('.ifl-btn-original')) {
                                const span = document.createElement('span');
                                span.className = 'ifl-btn-original';
                                while (btn.firstChild) span.appendChild(btn.firstChild);
                                btn.appendChild(span);
                            }
                            btn.disabled = true;
                            btn.classList.add('is-loading');

                            // The clicked button gets the spinner inline
                            if (btn === submitter) {
                                const indicator = document.createElement('span');
                                indicator.className = 'ifl-btn-loading-text';
                                indicator.innerHTML = SPINNER_SVG + 'Working…';
                                btn.appendChild(indicator);
                            }
                        });

                        // Safety net: if the page hasn't navigated within 30s (server stall), restore the buttons
                        setTimeout(() => {
                            form.querySelectorAll('button[type="submit"]').forEach(btn => {
                                btn.disabled = false;
                                btn.classList.remove('is-loading');
                                const ind = btn.querySelector('.ifl-btn-loading-text');
                                if (ind) ind.remove();
                            });
                            // Allow a future submission to re-fetch a fresh token
                            delete form.dataset.iflTokenAttached;
                        }, 30000);
                    });
                });
            });
        })();

        /* Toggle printer location dropdown/input based on checkbox */
        function togglePrinterLocation(type) {
            const chk = document.getElementById('chk-' + type);
            const loc = document.getElementById('loc-' + type);
            if (chk && loc) {
                loc.disabled = !chk.checked;
                if (!chk.checked) loc.value = '';
                loc.style.opacity = chk.checked ? '1' : '0.5';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Set initial state for printer location fields
            togglePrinterLocation('laser');
            togglePrinterLocation('dotmatrix');

            const btn = document.getElementById('btnGetEmployee');
            if (btn) {
                btn.addEventListener('click', async () => {
                    const empIdInput = document.getElementById('employeeIdInput');
                    const empId = empIdInput.value.trim();

                    if (!empId) {
                        IflDialog.warning('Please enter an Employee ID');
                        empIdInput.focus();
                        return;
                    }

                    const originalText = btn.textContent;
                    btn.textContent = 'Fetching...';
                    btn.disabled = true;

                    try {
                        const res = await fetch('/api/hrms/employee/' + empId);
                        if (!res.ok) throw new Error('Employee not found');
                        const data = await res.json();

                        // Populate fields
                        const setVal = (name, val) => {
                            const el = document.querySelector('input[name="' + name + '"]');
                            if (el && val) el.value = val;
                        };

                        setVal('fullName', data.fullName);
                        setVal('department', data.department);
                        setVal('subDepartment', data.subDepartment);
                        setVal('designation', data.designation);
                        setVal('location', data.location || data.projectUnit);
                        setVal('hod', data.hod);
                        setVal('mobile', data.mobile);
                        setVal('officeExtension', data.officeExtension);

                        // Safely parse Joining Date to YYYY-MM-DD format for HTML5 date input
                        if (data.joiningDate) {
                            const d = new Date(data.joiningDate);
                            if (!isNaN(d.getTime())) {
                                setVal('joiningDate', d.toISOString().split('T')[0]);
                            }
                        }

                        // Check if an active onboarding request already exists for this employee.
                        // HR is not allowed to view in-flight workflow data (least-privilege).
                        // We tell them the employee is locked and stop the flow — no link to trail.
                        try {
                            const existRes = await fetch('/api/onboarding/lookup?employeeId=' + encodeURIComponent(empId));
                            if (existRes.ok) {
                                const existData = await existRes.json();
                                if (existData && existData.existingRequestId) {
                                    IflDialog.warning('An onboarding request for this employee is already in progress. Please wait for it to complete before initiating a new one.', { title: 'Already in progress' });
                                    // Reset the field so HR doesn't try to submit anyway
                                    empIdInput.value = '';
                                    empIdInput.focus();
                                    return;
                                }
                            }
                        } catch (_) { /* non-fatal */ }
                    } catch (err) {
                        IflDialog.error(err.message || 'Could not look up the employee.');
                    } finally {
                        btn.textContent = originalText;
                        btn.disabled = false;
                    }
                });
            }
        });
    </script>

    <% if (showPortal) { %>
    <script>
        /* ─── Portal sidebar — fetches role-scoped queue and renders rows ─── */
        (function () {
            const ROLE_KEY      = <%- JSON.stringify(roleKey) %>;
            const CURRENT_REQ_ID = <%- JSON.stringify(request && request.id ? request.id : null) %>;
            const listEl  = document.getElementById('portalList');
            const tabBtns = document.querySelectorAll('.portal-tab');
            const counts  = { pending: document.getElementById('ps-count-pending'),
                              history: document.getElementById('ps-count-history') };
            const cache   = { pending: null, history: null };
            let currentTab = 'pending';

            function escapeHTML(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
                    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            function initials(name) {
                return (name || '?').trim().split(/\s+/).slice(0, 2)
                    .map(p => p[0] || '').join('').toUpperCase() || '?';
            }

            function renderState(html) { listEl.innerHTML = '<div class="portal-list-state">' + html + '</div>'; }

            function renderEmpty(tab) {
                const msg = tab === 'pending'
                    ? 'You have no pending tasks right now.'
                    : 'No past activity for this role yet.';
                renderState('<div style="font-size:1.4rem;opacity:.4;margin-bottom:6px;">📭</div><div>' + msg + '</div>');
            }

            // Compact relative-then-absolute date.
            // < 24h → "3h ago" · < 7d → "2d ago" · else → "5 May, 14:30"
            function formatRelDate(ts) {
                if (!ts) return '';
                const d = new Date(ts);
                if (isNaN(d.getTime())) return '';
                const diff = Date.now() - d.getTime();
                const min = Math.floor(diff / 60000);
                if (min < 1)   return 'just now';
                if (min < 60)  return min + 'm ago';
                const hr = Math.floor(min / 60);
                if (hr < 24)   return hr + 'h ago';
                const day = Math.floor(hr / 24);
                if (day < 7)   return day + 'd ago';
                return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })
                    + ', ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            }

            // history row data is cached so the modal can render instantly
            // without re-fetching when the user clicks.
            const historyRowMap = {};

            function renderRows(items) {
                if (!items.length) { renderEmpty(currentTab); return; }
                const isHistory = currentTab === 'history';

                const html = items.map(it => {
                    if (isHistory && it.isEvent) {
                        historyRowMap[it.eventId] = it;
                        return renderHistoryRow(it);
                    }
                    return renderPendingRow(it);
                }).join('');
                listEl.innerHTML = html;
            }

            function renderPendingRow(it) {
                const isCurrent = it.requestId === CURRENT_REQ_ID;
                const hasName   = it.fullName && it.fullName.trim();
                const nameText  = hasName ? it.fullName : ('Request #' + it.requestId);

                const metaBits = [];
                if (hasName) metaBits.push('<strong>#' + escapeHTML(it.requestId) + '</strong>');
                if (it.department && it.department.trim())  metaBits.push(escapeHTML(it.department));
                if (it.designation && it.designation.trim()) metaBits.push(escapeHTML(it.designation));
                const metaHtml = metaBits.length ? '<div class="pr-meta">' + metaBits.join(' · ') + '</div>' : '';

                const timeStr  = formatRelDate(it.lastUpdated);
                const timeHtml = timeStr ? '<div class="pr-time">' + escapeHTML(timeStr) + '</div>' : '';

                const badge = isCurrent
                    ? '<span class="pr-badge is-now">Viewing</span>'
                    : '<span class="pr-badge is-now">Action</span>';

                const href = isCurrent ? '#' : escapeHTML(it.url || '#');
                const clickAttr = isCurrent ? 'onclick="event.preventDefault();return false;"' : '';

                return '<a class="portal-row ' + (isCurrent ? 'is-current' : '') + '" href="' + href + '" ' + clickAttr + ' title="' + escapeHTML(it.url || '') + '">'
                    +   '<div class="pr-top">'
                    +     '<div class="pr-name">'
                    +       (isCurrent ? '<span class="pr-current-dot"></span>' : '')
                    +       escapeHTML(nameText)
                    +     '</div>'
                    +     badge
                    +   '</div>'
                    +   metaHtml
                    +   timeHtml
                    + '</a>';
            }

            // History rows surface the role's ACTION ("Approved", "Configured
            // Services", …) as the primary line. Employee name + req# move to
            // a secondary line. Tone-colored badge mirrors the action.
            function renderHistoryRow(it) {
                const tone     = it.actionTone || 'info';
                const verb     = it.actionLabel || it.action || 'Action';
                const empName  = it.fullName && it.fullName.trim()
                    ? it.fullName + (it.requestId ? ' · #' + it.requestId : '')
                    : 'Request #' + it.requestId;

                const metaBits = [];
                if (it.department && it.department.trim())  metaBits.push(escapeHTML(it.department));
                if (it.designation && it.designation.trim()) metaBits.push(escapeHTML(it.designation));
                const metaHtml = metaBits.length ? '<div class="pr-meta">' + metaBits.join(' · ') + '</div>' : '';

                const timeStr  = formatRelDate(it.timestamp);
                const timeHtml = timeStr ? '<div class="pr-time">' + escapeHTML(timeStr) + '</div>' : '';

                return '<a class="portal-row" href="#" onclick="event.preventDefault();iflPortalDetail.open(' + Number(it.eventId) + ');">'
                    +   '<div class="pr-top">'
                    +     '<div class="pr-name">' + escapeHTML(verb) + '</div>'
                    +     '<span class="pr-badge tone-' + tone + '">' + escapeHTML(verb.split(' ')[0]) + '</span>'
                    +   '</div>'
                    +   '<div class="pr-sub-name">' + escapeHTML(empName) + '</div>'
                    +   metaHtml
                    +   timeHtml
                    + '</a>';
            }

            // Fetch a tab's data and (optionally) render it.
            //
            // CRITICAL: `renderRows` is only invoked when the *currently
            // active* tab matches the one we just fetched. The background
            // history prefetch must NOT clobber the rendered pending list.
            async function loadTab(tab, opts) {
                opts = opts || {};
                const renderIfActive = () => {
                    if (currentTab !== tab) return;
                    renderRows(cache[tab]);
                };

                if (cache[tab]) {
                    counts[tab].textContent = cache[tab].length || '';
                    renderIfActive();
                    return;
                }

                if (currentTab === tab) {
                    renderState('<div class="pls-spin"></div><div>Loading…</div>');
                }
                try {
                    const fetcher = (typeof window.iflFetch === 'function') ? window.iflFetch : (u, o) => fetch(u, o);
                    const r = await fetcher('/api/onboarding/queue?role=' + encodeURIComponent(ROLE_KEY) + '&type=' + tab);
                    if (!r.ok) throw new Error('queue ' + r.status);
                    const j = await r.json();
                    if (!j.success) throw new Error(j.error || 'failed');
                    cache[tab] = j.data || [];
                    counts[tab].textContent = cache[tab].length || '';

                    // Debug: print each row's destination URL so we can verify
                    // the queue endpoint hands back distinct tokens per row.
                    try {
                        console.groupCollapsed('[Portal] ' + tab + ' tab — ' + cache[tab].length + ' rows');
                        cache[tab].forEach(it => console.log('#' + it.requestId, '→', it.url));
                        console.groupEnd();
                    } catch (_) {}

                    renderIfActive();
                } catch (err) {
                    console.warn('[Portal]', err && err.message);
                    if (currentTab === tab) {
                        renderState('<div style="color:#dc2626;">Could not load tasks.<br><span style="font-size:.78rem;">' + escapeHTML(err && err.message || '') + '</span></div>');
                    }
                }
            }

            // ─── Detail popup controller ───────────────────────────────
            // Defensive: every step is wrapped so a missing element or
            // typo can't break the rest of the sidebar/portal setup.
            (function setupDetailPopup() {
                const detailBackdrop = document.getElementById('iflDetailBackdrop');
                const detailName     = document.getElementById('iflDetailName');
                const detailSub      = document.getElementById('iflDetailSub');
                const detailBody     = document.getElementById('iflDetailBody');
                if (!detailBackdrop || !detailName || !detailSub || !detailBody) {
                    console.warn('[Portal detail] modal elements missing; popup disabled.');
                    window.iflPortalDetail = { open() {}, close() {} };
                    return;
                }
                const detailCache = {};

                function fmtAbs(ts) {
                    if (!ts) return '—';
                    const d = new Date(ts);
                    if (isNaN(d.getTime())) return '—';
                    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
                        + ' · ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
                }
                function pillClassForStatus(s) {
                    if (!s) return 'is-pending';
                    if (/reject/i.test(s)) return 'is-rejected';
                    if (s === 'Completed') return 'is-done';
                    return 'is-pending';
                }
                function dotClassForAction(a) {
                    a = (a || '').toLowerCase();
                    if (a.indexOf('reject') >= 0) return 'is-rejected';
                    if (a.indexOf('approve') >= 0 || a.indexOf('completed') >= 0) return 'is-done';
                    return '';
                }

                function renderDetail(payload) {
                    if (!payload || !payload.success) {
                        detailBody.innerHTML = '<div class="ifl-detail-state" style="color:#dc2626;">Could not load details.</div>';
                        return;
                    }
                    const r = payload.request || {};
                    const tl = payload.timeline || [];

                    detailName.textContent = (r.fullName && r.fullName.trim()) ? r.fullName : ('Request #' + r.id);
                    detailSub.textContent  = '#' + r.id
                        + (r.designation ? ' · ' + r.designation : '')
                        + (r.department  ? ' · ' + r.department  : '');

                    const pillCls = pillClassForStatus(r.statusRaw);

                    const grid = [];
                    if (r.employeeId)    grid.push({ label: 'Employee ID',     value: escapeHTML(r.employeeId) });
                    if (r.location)      grid.push({ label: 'Location',        value: escapeHTML(r.location) });
                    if (r.subDepartment) grid.push({ label: 'Sub-department',  value: escapeHTML(r.subDepartment) });
                    grid.push({ label: 'Status', value: '<span class="ifl-detail-pill ' + pillCls + '">' + escapeHTML(r.statusLabel || r.statusRaw || '—') + '</span>' });
                    if (r.statusOwner && r.statusOwner !== '—') grid.push({ label: 'Currently With', value: escapeHTML(r.statusOwner) });
                    if (r.requesterName) grid.push({ label: 'Initiated By', value: escapeHTML(r.requesterName + (r.requesterEmail ? ' (' + r.requesterEmail + ')' : '')) });
                    grid.push({ label: 'Created', value: escapeHTML(fmtAbs(r.createdAt)) });
                    grid.push({ label: 'Updated', value: escapeHTML(fmtAbs(r.updatedAt)) });

                    const summaryHtml =
                        '<div class="ifl-detail-section">' +
                            '<h4>Summary</h4>' +
                            '<div class="ifl-detail-grid">' +
                                grid.map(g =>
                                    '<div>' +
                                        '<div class="idg-label">' + escapeHTML(g.label) + '</div>' +
                                        '<div class="idg-value">' + g.value + '</div>' +
                                    '</div>'
                                ).join('') +
                            '</div>' +
                        '</div>';

                    const timelineHtml = !tl.length ? '' :
                        '<div class="ifl-detail-section">' +
                            '<h4>Workflow Activity</h4>' +
                            '<ul class="ifl-detail-timeline">' +
                                tl.map(ev =>
                                    '<li>' +
                                        '<span class="idt-dot ' + dotClassForAction(ev.action) + '">●</span>' +
                                        '<div class="idt-action">' +
                                            '<span class="idt-role">' + escapeHTML(ev.actorRole || '—') + '</span>' +
                                            escapeHTML(ev.summary || ev.action || '') +
                                        '</div>' +
                                        '<div class="idt-meta">' + escapeHTML(fmtAbs(ev.timestamp)) + '</div>' +
                                    '</li>'
                                ).join('') +
                            '</ul>' +
                        '</div>';

                    detailBody.innerHTML = summaryHtml + timelineHtml;
                }

                // History-row modal: renders details of the role's action
                // for that request (date, action verb, remarks, employee).
                // Argument is the eventId (not request id) — data is already
                // in window.historyRowMap from the queue response.
                function openEventDetail(eventId) {
                    const ev = (typeof historyRowMap !== 'undefined') && historyRowMap[eventId];
                    if (!ev) {
                        detailName.textContent = 'Not found';
                        detailSub.textContent  = '';
                        detailBody.innerHTML   = '<div class="ifl-detail-state" style="color:#dc2626;">Event data missing.</div>';
                        return;
                    }

                    detailBackdrop.setAttribute('aria-hidden', 'false');
                    detailBackdrop.classList.add('is-open');

                    // Header: action verb + employee context
                    detailName.textContent = ev.actionLabel || ev.action || 'Action';
                    detailSub.textContent  = (ev.fullName ? ev.fullName + ' · ' : '')
                        + '#' + ev.requestId
                        + (ev.department ? ' · ' + ev.department : '');

                    // Build body sections: Your Action / Details / Employee
                    const tone = ev.actionTone || 'info';
                    const yourActionHtml =
                        '<div class="ifl-detail-section">' +
                            '<h4>Your Action</h4>' +
                            '<div class="ifl-detail-grid">' +
                                '<div><div class="idg-label">Action</div><div class="idg-value">' +
                                    '<span class="ifl-detail-pill ' + (tone === 'danger' ? 'is-rejected' : tone === 'success' ? 'is-done' : 'is-pending') + '">' +
                                        escapeHTML(ev.actionLabel || ev.action || '') +
                                    '</span>' +
                                '</div></div>' +
                                '<div><div class="idg-label">When</div><div class="idg-value">' + escapeHTML(fmtAbs(ev.timestamp)) + '</div></div>' +
                            '</div>' +
                        '</div>';

                    const detailHtml = ev.actionDetailHTML
                        ? '<div class="ifl-detail-section">' +
                              '<h4>What You Recorded</h4>' +
                              '<div class="ifl-detail-action-body">' + ev.actionDetailHTML + '</div>' +
                          '</div>'
                        : '';

                    const empBits = [];
                    if (ev.employeeId)    empBits.push({ label: 'Employee ID',   value: escapeHTML(ev.employeeId) });
                    if (ev.fullName)      empBits.push({ label: 'Name',          value: escapeHTML(ev.fullName) });
                    if (ev.designation)   empBits.push({ label: 'Designation',   value: escapeHTML(ev.designation) });
                    if (ev.department)    empBits.push({ label: 'Department',    value: escapeHTML(ev.department) });
                    if (ev.subDepartment) empBits.push({ label: 'Sub-Dept',      value: escapeHTML(ev.subDepartment) });
                    if (ev.initiatorName) empBits.push({ label: 'Initiated By',  value: escapeHTML(ev.initiatorName) });

                    const employeeHtml = empBits.length
                        ? '<div class="ifl-detail-section">' +
                              '<h4>Employee</h4>' +
                              '<div class="ifl-detail-grid">' +
                                  empBits.map(g =>
                                      '<div>' +
                                          '<div class="idg-label">' + escapeHTML(g.label) + '</div>' +
                                          '<div class="idg-value">' + g.value + '</div>' +
                                      '</div>'
                                  ).join('') +
                              '</div>' +
                          '</div>'
                        : '';

                    detailBody.innerHTML = yourActionHtml + detailHtml + employeeHtml;
                }

                async function open(eventId) {
                    if (eventId == null) return;
                    openEventDetail(Number(eventId));
                }
                function close() {
                    detailBackdrop.classList.remove('is-open');
                    detailBackdrop.setAttribute('aria-hidden', 'true');
                }
                window.iflPortalDetail = { open, close };

                detailBackdrop.addEventListener('mousedown', (e) => {
                    if (e.target === detailBackdrop) close();
                });
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && detailBackdrop.classList.contains('is-open')) close();
                });
            })();

            window.iflPortal = {
                switchTab(tab) {
                    if (tab === currentTab) return;
                    currentTab = tab;
                    tabBtns.forEach(b => b.classList.toggle('is-active', b.dataset.tab === tab));
                    // If we already have data, render immediately; otherwise
                    // loadTab() will fetch + render.
                    if (cache[tab]) renderRows(cache[tab]);
                    else loadTab(tab);
                }
            };

            // Wait briefly for the verification cloak to lift, then start
            // loading regardless. The cloak hides the sidebar visually, so
            // we can safely populate it in the background. A hard timeout
            // ensures the sidebar isn't held hostage by a slow SSO call.
            let _waited = 0;
            const startWhenReady = () => {
                const cloaked = document.body.classList.contains('ifl-is-verifying');
                if (cloaked && _waited < 6000) {
                    _waited += 200;
                    setTimeout(startWhenReady, 200);
                    return;
                }
                if (cloaked) console.warn('[Portal] cloak still up after 6s — loading sidebar anyway');
                loadTab('pending').catch(e => console.warn('[Portal] pending load failed:', e));
                // Eager-load history in the background.
                setTimeout(() => loadTab('history').catch(() => {}), 1200);
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', startWhenReady);
            } else {
                startWhenReady();
            }
        })();
    </script>
    <% } %>

    <%- include('../partials/footer') %>
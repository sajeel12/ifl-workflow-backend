                <% if (request.id) { %>
                    <span style="margin-right:auto;font-size:0.78rem;color:#94a3b8;">Request #<%= request.id %> · <%= role %></span>
                <% } %>
                <% if (role === 'HR') { %><button type="submit" class="btn btn-primary">Submit Request</button><% } %>
                <% if (role === 'IT') { %><button type="submit" class="btn btn-primary">Save &amp; Forward to HOD</button><% } %>
                <% if (role === 'HOD') { %>
                    <button type="submit" name="action" value="Reject" class="btn btn-danger">Reject</button>
                    <button type="submit" name="action" value="Approve" class="btn btn-success">Approve</button>
                <% } %>
                <% if (role === 'DCI') { %><button type="submit" class="btn btn-primary">Save &amp; Forward to Manager</button><% } %>
                <% if (role === 'DCIManager') { %>
                    <button type="submit" name="action" value="Reject" class="btn btn-danger">Reject Request</button>
                    <button type="submit" name="action" value="RequestChanges" class="btn btn-secondary"
                        data-ifl-confirm="Send this request back to the DCI Team for changes?"
                        data-ifl-confirm-title="Request changes"
                        data-ifl-confirm-ok="Send back">Request Changes</button>
                    <button type="submit" name="action" value="Approve" class="btn btn-success">Approve Request</button>
                <% } %>
                <% if (role === 'ITHOD') { %>
                    <button type="submit" name="action" value="Reject" class="btn btn-danger">Reject Request</button>
                    <button type="submit" name="action" value="Approve" class="btn btn-success">Approve Request</button>
                <% } %>
                <% if (role === 'DCIImplementer') { %><button type="submit" class="btn btn-primary">Upload Proofs &amp; Complete</button><% } %>

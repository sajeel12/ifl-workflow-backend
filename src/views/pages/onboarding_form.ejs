<%- include('../partials/header', { title: 'IT Onboarding Workflow' }) %>
    <link rel="stylesheet" href="/css/modern.css">

    <%
    // When an action token is present (email-link click), the form must be
    // hidden until the SSO email is verified against the expected approver.
    // The body starts in "is-verifying" state; the verification JS lifts
    // this once the check passes — or the rejection screen replaces it.
    %>
    <% if (token && typeof expectedAssigneeEmail !== 'undefined' && expectedAssigneeEmail) { %>
    <style>
        body.ifl-is-verifying > *:not(#iflVerifyOverlay) { visibility: hidden !important; }
        #iflVerifyOverlay {
            position: fixed; inset: 0;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            z-index: 9999;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: opacity 0.25s ease;
        }
        #iflVerifyOverlay.is-fading-out { opacity: 0; pointer-events: none; }
        #iflVerifyOverlay .iflv-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px 48px;
            box-shadow: 0 12px 40px -8px rgba(15, 76, 129, 0.18);
            display: flex; flex-direction: column; align-items: center; gap: 18px;
            min-width: 320px;
        }
        #iflVerifyOverlay .iflv-spinner {
            width: 56px; height: 56px;
            border: 4px solid #e0f2fe;
            border-top-color: #0078D4;
            border-radius: 50%;
            animation: iflv-spin 0.8s linear infinite;
        }
        @keyframes iflv-spin { to { transform: rotate(360deg); } }
        #iflVerifyOverlay .iflv-title { font-size: 1.05rem; font-weight: 700; color: #0F172A; margin: 0; }
        #iflVerifyOverlay .iflv-sub   { font-size: 0.88rem; color: #64748B; margin: 0; line-height: 1.5; text-align: center; max-width: 320px; }
        #iflVerifyOverlay .iflv-logo  { height: 44px; opacity: 0.92; margin-bottom: 4px; }
    </style>
    <script>
        // Apply the cloak immediately (before DOM parses further) so the form
        // never paints for an unauthorized viewer.
        document.documentElement.style.background = 'linear-gradient(135deg,#f8fafc,#e0f2fe)';
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('ifl-is-verifying');
        });
    </script>
    <div id="iflVerifyOverlay">
        <div class="iflv-card">
            <img src="/logo.png" alt="IFL" class="iflv-logo" onerror="this.style.display='none'">
            <div class="iflv-spinner"></div>
            <h3 class="iflv-title">Verifying your access…</h3>
            <p class="iflv-sub">Please wait while we confirm you are the intended recipient of this action.</p>
        </div>
    </div>
    <% } %>

    <!-- Header is now outside the constrained container to allow full width -->
    <header class="app-header">
        <div class="brand-section">
            <img src="/logo.png" alt="IFL" class="logo" onerror="this.style.display='none'">
            <div class="app-title">
                <h1>IT Onboarding Workflow</h1>
                <p>Ibrahim Fibers Limited</p>
            </div>
        </div>
        <div class="status-section">
            <% if (token) { %>
                <div class="status-badge">REQ #<%= request.id || 'NEW' %> | <%= role %>
                </div>
                <% } %>
        </div>
    </header>

    <%
    // Portal layout — when an approver opens the form via an email link (any
    // role except HR/read-only with a workflow token), we wrap the form in a
    // shell with a left sidebar that shows the role's pending tasks + history.
    // The sidebar fetches /api/onboarding/queue and renders rows the user
    // can click to switch between their workitems without going back to email.
    %>
    <%- include('../partials/portal_shell') %>

    <%
    // Determine which section starts expanded based on the current role
    const _activeSec = {
        'HR':            'sec-employee',
        'IT':            'sec-it',
        'HOD':           'sec-hod',
        'DCI':           'sec-dci',
        'DCIManager':    'sec-dci',
        'ITHOD':         'sec-ithod',
        'DCIImplementer':'sec-dci-impl',
        'OPS':           'sec-ops',
    }[role] || 'sec-employee';
    const _collapsed = (id) => _activeSec !== id ? 'is-collapsed' : '';
    %>

    <div class="app-container">

        <!-- ── Step Progress Bar (always visible) ── -->
        <div class="steps-container">
            <div class="steps" style="--step-progress: <%= stepProgress %>%">
                <% steps.forEach((s, i) => { %>
                    <div class="step-item <%= s.status %>">
                        <div class="step-circle">
                            <% if (s.status === 'completed') { %>&#10003;<% } else { %><%= i + 1 %><% } %>
                        </div>
                        <div class="step-label"><%= s.label %></div>
                    </div>
                <% }); %>
            </div>
        </div>

        <form class="onb-form" method="POST" action="<%- formAction %>" <%- formEnctype %>>
            <% if (locals.portalToken) { %><input type="hidden" name="pt" value="<%= locals.portalToken %>"><% } %>
            <% if (role === 'DCIImplementer') { %><input type="hidden" name="token" value="<%= token %>"><% } %>

            <!-- ── Scrollable form body ── -->
            <div class="form-scroll">
                <div class="form-content">

                    <!-- ════ SECTION: Employee Details ════ -->
                    <div class="form-section <%= _collapsed('sec-employee') %>" id="sec-employee" style="--sec-accent:#2563eb">
                        <div class="form-section-hd" onclick="iflToggleSection(this)">
                            <span class="form-section-ttl">Employee Details</span>
                            <span class="form-section-tag">HR</span>
                            <% if (_activeSec !== 'sec-employee' && (val('fullName') || val('employeeId'))) { %>
                                <span class="form-section-hint"><%= val('fullName') || val('employeeId') %></span>
                            <% } %>
                            <svg class="form-section-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="form-section-body">
                            <!-- Requester info (auto-filled, read-only) -->
                            <div class="grid-2" style="margin-bottom:10px;">
                                <div class="form-group">
                                    <label>Requester Name <span style="color:#9ca3af;font-weight:400;text-transform:none;">(auto-filled)</span></label>
                                    <input type="text" name="requesterName" value="<%= val('requesterName') %>" readonly style="background:#f1f5f9;">
                                </div>
                                <div class="form-group">
                                    <label>Requester Email</label>
                                    <input type="text" name="requesterEmail" value="<%= val('requesterEmail') %>" readonly style="background:#f1f5f9;">
                                </div>
                            </div>

                            <!-- Employee ID lookup -->
                            <div style="background:#f8fafc;padding:12px 16px;border-radius:8px;border:1.5px solid #e2e4e9;margin-bottom:14px;">
                                <div style="font-size:0.7rem;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:0.055em;margin-bottom:6px;">Employee ID</div>
                                <div style="display:flex;gap:10px;align-items:center;">
                                    <input type="text" id="employeeIdInput" name="employeeId"
                                        value="<%= val('employeeId') %>" <%=hrDisabled %> required
                                        style="font-size:1rem;font-weight:600;letter-spacing:0.02em;max-width:220px;flex:1 1 auto;">
                                    <% if (role === 'HR') { %>
                                        <button type="button" id="btnGetEmployee" class="btn btn-primary" style="flex-shrink:0;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                            </svg>
                                            Get Employee Data
                                        </button>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Main employee fields — compact 4-column + 3-column layout -->
                            <div class="grid-4">
                                <div class="form-group">
                                    <label>Full Name</label>
                                    <input type="text" name="fullName" value="<%= val('fullName') %>" <%=hrDisabled %> required>
                                </div>
                                <div class="form-group">
                                    <label>Request Mode</label>
                                    <select name="requestMode" <%=hrDisabled %>>
                                        <option value="New" <%=val('requestMode')==='New' ? 'selected' : '' %>>New Hiring</option>
                                        <option value="Change" <%=val('requestMode')==='Change' ? 'selected' : '' %>>Change / Modification</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>HOD Name</label>
                                    <input type="text" name="hod" value="<%= val('hod') %>" <%=hrDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Joining Date</label>
                                    <input type="date" name="joiningDate"
                                        value="<%= (function(){ if(!val('joiningDate')) return ''; const d = new Date(val('joiningDate')); return isNaN(d.getTime()) ? '' : d.toISOString().split('T')[0]; })() %>"
                                        <%=hrDisabled %>>
                                </div>
                            </div>
                            <div class="grid-4">
                                <div class="form-group">
                                    <label>Department</label>
                                    <input type="text" name="department" value="<%= val('department') %>" <%=hrDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Sub-Department</label>
                                    <input type="text" name="subDepartment" value="<%= val('subDepartment') %>" <%=hrDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Designation</label>
                                    <input type="text" name="designation" value="<%= val('designation') %>" <%=hrDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Location Group <span style="color:#9ca3af;font-weight:400;text-transform:none;">(auto)</span></label>
                                    <%
                                        let locDisplay = val('location') || '';
                                        try {
                                            const _locModule = locDisplay && typeof locationGroupLabels !== 'undefined'
                                                ? locationGroupLabels[locDisplay] : null;
                                            if (_locModule) locDisplay = _locModule;
                                        } catch(_) {}
                                    %>
                                    <input type="text" value="<%= locDisplay %>" readonly style="background:#f1f5f9;" data-ifl-location="1">
                                </div>
                            </div>

                            <!-- Request details note -->
                            <div style="display:flex;align-items:flex-start;gap:8px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 14px;margin-bottom:6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                <span style="font-size:0.8rem;color:#92400e;line-height:1.5;">Describe what needs to be configured — services required, access levels, email setup, printer assignments, and any special permissions.</span>
                            </div>
                        </div>
                    </div>

                    <!-- ════ SECTION: IT Services (conditional) ════ -->
                    <% if (role !== 'HR' || request.id) { %>
                    <div class="form-section <%= _collapsed('sec-it') %>" id="sec-it" style="--sec-accent:#0078D4">
                        <div class="form-section-hd" onclick="iflToggleSection(this)">
                            <span class="form-section-ttl">IT Services Configuration</span>
                            <span class="form-section-tag">IT Operations</span>
                            <svg class="form-section-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="form-section-body">
                            <!-- Access & Email -->
                            <div class="grid-3" style="margin-bottom:10px;">
                                <label class="checkbox-card" style="margin-bottom:0;">
                                    <input type="checkbox" name="intranetAccess"
                                        <%= (request.intranetAccess === false) ? '' : 'checked' %> <%= servicesDisabled %>>
                                    <span>Intranet Access <small style="color:#64748b;">(default)</small></span>
                                </label>
                                <label class="checkbox-card" style="margin-bottom:0;">
                                    <input type="checkbox" name="emailIncoming" <%=chk('emailIncoming') %> <%= servicesDisabled %>>
                                    <span>Incoming Email</span>
                                </label>
                                <label class="checkbox-card" style="margin-bottom:0;">
                                    <input type="checkbox" name="emailOutgoing" <%=chk('emailOutgoing') %> <%= servicesDisabled %>>
                                    <span>Outgoing Email</span>
                                </label>
                            </div>
                            <div class="form-group" style="margin-bottom:14px;">
                                <label>Email Details</label>
                                <textarea name="emailPurpose" rows="2"
                                    placeholder="Specify what needs to be configured — recipients, limits, distribution lists, business justification."
                                    <%=servicesDisabled %>><%= val('emailPurpose') %></textarea>
                            </div>

                            <!-- Printing -->
                            <div class="grid-2" style="margin-bottom:12px;">
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <input type="checkbox" id="chk-laser" name="laserPrinter" <%=chk('laserPrinter') %>
                                        <%= servicesDisabled %> style="width:16px;height:16px;flex-shrink:0;"
                                        onchange="togglePrinterLocation('laser')">
                                    <% if (printerLocations && printerLocations.length > 0 && !servicesDisabled) { %>
                                        <select id="loc-laser" name="laserPrinterLocation" style="flex:1;">
                                            <option value="">— Laser Printer —</option>
                                            <% printerLocations.filter(p => p.name && p.name.toLowerCase().includes('laser')).forEach(p => { %>
                                                <option value="<%= p.location %>" <%= val('laserPrinterLocation') === p.location ? 'selected' : '' %>><%= p.name %></option>
                                            <% }) %>
                                            <option value="<%= val('laserPrinterLocation') %>" selected><%= val('laserPrinterLocation') || 'Other' %></option>
                                        </select>
                                    <% } else { %>
                                        <input type="text" id="loc-laser" name="laserPrinterLocation" placeholder="Laser Printer Location" value="<%= val('laserPrinterLocation') %>" <%=servicesDisabled %>>
                                    <% } %>
                                </div>
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <input type="checkbox" id="chk-dotmatrix" name="dotMatrixPrinter" <%=chk('dotMatrixPrinter') %>
                                        <%= servicesDisabled %> style="width:16px;height:16px;flex-shrink:0;"
                                        onchange="togglePrinterLocation('dotmatrix')">
                                    <% if (printerLocations && printerLocations.length > 0 && !servicesDisabled) { %>
                                        <select id="loc-dotmatrix" name="dotMatrixPrinterLocation" style="flex:1;">
                                            <option value="">— Dot Matrix —</option>
                                            <% printerLocations.filter(p => p.name && p.name.toLowerCase().includes('matrix')).forEach(p => { %>
                                                <option value="<%= p.location %>" <%= val('dotMatrixPrinterLocation') === p.location ? 'selected' : '' %>><%= p.name %></option>
                                            <% }) %>
                                            <option value="<%= val('dotMatrixPrinterLocation') %>"><%= val('dotMatrixPrinterLocation') || 'Other' %></option>
                                        </select>
                                    <% } else { %>
                                        <input type="text" id="loc-dotmatrix" name="dotMatrixPrinterLocation" placeholder="Dot Matrix Location" value="<%= val('dotMatrixPrinterLocation') %>" <%=servicesDisabled %>>
                                    <% } %>
                                </div>
                            </div>

                            <!-- File Shares -->
                            <div style="border-top:1px dashed #cbd5e1;padding-top:12px;">
                                <div class="grid-4">
                                    <div class="form-group">
                                        <label>Dept Share (S:)</label>
                                        <% if (fileSharePaths && fileSharePaths.length > 0 && !servicesDisabled) { %>
                                            <select name="deptSharePath">
                                                <option value="">— Select Share —</option>
                                                <% fileSharePaths.forEach(p => { %><option value="<%= p.path %>" <%= val('deptSharePath') === p.path ? 'selected' : '' %>><%= p.name %></option><% }) %>
                                            </select>
                                        <% } else { %>
                                            <input type="text" name="deptSharePath" value="<%= val('deptSharePath') %>" <%=servicesDisabled %>>
                                        <% } %>
                                    </div>
                                    <div class="form-group">
                                        <label>Home Folder (Z:)</label>
                                        <% if (fileSharePaths && fileSharePaths.length > 0 && !servicesDisabled) { %>
                                            <select name="homeFolderPath">
                                                <option value="">— Select Home Folder —</option>
                                                <% fileSharePaths.forEach(p => { %><option value="<%= p.path %>" <%= val('homeFolderPath') === p.path ? 'selected' : '' %>><%= p.name %></option><% }) %>
                                            </select>
                                        <% } else { %>
                                            <input type="text" name="homeFolderPath" value="<%= val('homeFolderPath') %>" <%=servicesDisabled %>>
                                        <% } %>
                                    </div>
                                    <div class="form-group">
                                        <label>SharePoint / IFL Portal</label>
                                        <% if (sharepointPaths && sharepointPaths.length > 0 && !servicesDisabled) { %>
                                            <select name="iflPortalLink">
                                                <option value="">— Select Portal —</option>
                                                <% sharepointPaths.forEach(p => { %><option value="<%= p.url %>" <%= val('iflPortalLink') === p.url ? 'selected' : '' %>><%= p.name %></option><% }) %>
                                            </select>
                                        <% } else { %>
                                            <input type="text" name="iflPortalLink" value="<%= val('iflPortalLink') %>" <%=servicesDisabled %>>
                                        <% } %>
                                    </div>
                                    <div class="form-group">
                                        <label>SharePoint Role <span style="color:#dc2626;">*</span></label>
                                        <select name="sharepointRole" <%=servicesDisabled %>>
                                            <option value="">— Select Role —</option>
                                            <option value="Viewer" <%= val('sharepointRole') === 'Viewer' ? 'selected' : '' %>>Viewer</option>
                                            <option value="Editor" <%= val('sharepointRole') === 'Editor' ? 'selected' : '' %>>Editor</option>
                                            <option value="Contributor" <%= val('sharepointRole') === 'Contributor' ? 'selected' : '' %>>Contributor</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- ════ SECTION: HOD Remarks (conditional) ════ -->
                    <% if (role === 'HOD' || request.hodRemarks) { %>
                    <div class="form-section <%= _collapsed('sec-hod') %>" id="sec-hod" style="--sec-accent:#16a34a">
                        <div class="form-section-hd" onclick="iflToggleSection(this)">
                            <span class="form-section-ttl">HOD Remarks</span>
                            <span class="form-section-tag">HOD</span>
                            <% if (_activeSec !== 'sec-hod' && request.hodRemarks) { %><span class="form-section-hint">Filled</span><% } %>
                            <svg class="form-section-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="form-section-body">
                            <div class="form-group">
                                <textarea name="hodRemarks" rows="3" placeholder="Enter HOD comments here…" <%=hodRemarksDisabled %>><%= val('hodRemarks') %></textarea>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- ════ SECTION: DCI Manager Change Request (read-only) ════ -->
                    <% if (request.dciChangeRequestRemarks) { %>
                    <div class="form-section <%= _collapsed('sec-dci-changes') %>" id="sec-dci-changes" style="--sec-accent:#f59e0b">
                        <div class="form-section-hd" onclick="iflToggleSection(this)">
                            <span class="form-section-ttl">Changes Requested by DCI Manager</span>
                            <span class="form-section-tag" style="background:#fef3c7;color:#b45309;">Action Required</span>
                            <svg class="form-section-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <div class="form-section-body">
                            <div style="background:#fff7ed;border:1px solid #fdba74;border-radius:8px;padding:12px 14px;color:#9a3412;white-space:pre-wrap;font-size:0.875rem;">
                                <%= request.dciChangeRequestRemarks %>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- ════ SECTION: DCI Configuration (conditional) ════ -->
                    <% if (!['HR', 'IT', 'HOD'].includes(role) || request.ntUserName) { %>
                    <div class="form-section <%= _collapsed('sec-dci') %>" id="sec-dci" style="--sec-accent:#7c3aed">
                        <div class="form-section-hd" onclick="iflToggleSection(this)">
                            <span class="form-section-ttl">DCI Configuration</span>
                            <span class="form-section-tag">DCI Team</span>
                            <% if (_activeSec !== 'sec-dci' && val('ntUserName')) { %><span class="form-section-hint"><%= val('ntUserName') %></span><% } %>
                            <svg class="form-section-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                        <%
                            const SMTP_DOMAINS = ['@igc.com.pk', '@ifl.net', '@pp.ifl.net', '@lhr.ifl.net', '@igcpk.com'];
                            const dciEditable = (role === 'DCI');
                        %>
                        <div class="form-section-body">
                            <!-- NT login name with AD availability check -->
                            <div class="grid-3">
                                <div class="form-group">
                                    <label>NT User Name (Login)</label>
                                    <div style="display:flex;gap:8px;align-items:center;">
                                        <input type="text" id="dciNtName" name="ntUserName" value="<%= val('ntUserName') %>" <%=configDisabled %> style="flex:1 1 auto;">
                                        <% if (dciEditable) { %>
                                            <button type="button" id="dciCheckNtBtn" class="btn btn-secondary" style="flex-shrink:0;white-space:nowrap;">Check</button>
                                        <% } %>
                                    </div>
                                    <div id="dciNtStatus" style="font-size:0.78rem;margin-top:5px;min-height:16px;"></div>
                                </div>
                                <div class="form-group">
                                    <label>Exchange Display Name</label>
                                    <input type="text" id="dciDisplayName" name="exchangeDisplayName" value="<%= val('exchangeDisplayName') %>" <%=configDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Title <span style="color:#9ca3af;font-weight:400;text-transform:none;">(auto)</span></label>
                                    <input type="text" id="dciTitle" name="adTitle" value="<%= val('adTitle') || val('designation') %>" <%=configDisabled %>>
                                </div>
                            </div>

                            <!-- Alias + SMTP domain compose the SMTP address -->
                            <div class="grid-4">
                                <div class="form-group">
                                    <label>Alias Name</label>
                                    <input type="text" id="dciAlias" name="aliasName" value="<%= val('aliasName') %>" <%=configDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Email Domain</label>
                                    <select id="dciSmtpDomain" <%=configDisabled %>>
                                        <% SMTP_DOMAINS.forEach(d => { %>
                                            <option value="<%= d %>"><%= d %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="form-group" style="grid-column:span 2;">
                                    <label>SMTP Address</label>
                                    <input type="text" id="dciSmtp" name="smtpAddress" value="<%= val('smtpAddress') %>" <%=configDisabled %>>
                                </div>
                            </div>

                            <!-- Department + MG Level -->
                            <div class="grid-3">
                                <div class="form-group">
                                    <label>Department <span style="color:#9ca3af;font-weight:400;text-transform:none;">(auto)</span></label>
                                    <input type="text" id="dciDept" name="adDepartment" value="<%= val('adDepartment') || val('department') %>" <%=configDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>MG Level</label>
                                    <input type="text" name="mgLevel" value="<%= val('mgLevel') %>" <%=configDisabled %>>
                                </div>
                                <div class="form-group">
                                    <label>Group Policy Level</label>
                                    <select name="groupPolicyLevel" <%=configDisabled %>>
                                        <option value="">Select Level…</option>

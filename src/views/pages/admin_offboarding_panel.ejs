<%- include('../partials/admin_shell_top', { activeTab: 'offboarding' }) %>

  <!-- Page header -->
  <div class="a-page-hd">
    <h1 class="a-page-hd__title">Employee Offboarding</h1>
    <p class="a-page-hd__sub">Manage requests to revoke AD and physical access for departing employees.</p>
  </div>

  <!-- Main card -->
  <div class="a-card">
    <div class="a-card__hd">
      <div class="a-tabs" style="border:none;margin:0;flex:1;">
        <button class="a-tab a-tab--active" onclick="switchTab('initiate', event)">Initiate Request</button>
        <button class="a-tab" onclick="switchTab('manager', event)">Manager Approval</button>
        <button class="a-tab" onclick="switchTab('system', event)">System Team</button>
        <button class="a-tab" onclick="switchTab('history', event)">History</button>
      </div>
    </div>

    <div class="a-card__body">

      <!-- Initiate -->
      <div id="tab-initiate" class="tab-content">
        <h3 style="margin-top:0;font-size:1rem;margin-bottom:16px;">Initiate Offboarding Request</h3>
        <div class="a-field" style="max-width:380px;">
          <label class="a-label">Employee ID</label>
          <input type="text" id="initEmployeeId" class="a-input" placeholder="e.g. 1001">
        </div>
        <button class="btn btn-primary" onclick="initiateOffboarding()">Submit Request</button>
        <div id="initiateMessage" style="margin-top:14px;font-size:.875rem;"></div>
      </div>

      <!-- Manager Approval -->
      <div id="tab-manager" class="tab-content" style="display:none;">
        <h3 style="margin-top:0;font-size:1rem;margin-bottom:16px;">Pending Manager Approval</h3>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Req ID</th><th>Employee</th><th>Initiated By</th><th>Action</th></tr>
            </thead>
            <tbody id="managerTableBody">
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- System Team -->
      <div id="tab-system" class="tab-content" style="display:none;">
        <h3 style="margin-top:0;font-size:1rem;margin-bottom:16px;">Pending System Team Tasks</h3>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Req ID</th><th>Employee</th><th>Department</th><th>Action</th></tr>
            </thead>
            <tbody id="systemTableBody">
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- History -->
      <div id="tab-history" class="tab-content" style="display:none;">
        <h3 style="margin-top:0;font-size:1rem;margin-bottom:16px;">All Offboarding Requests</h3>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Req ID</th><th>Employee</th><th>IT Agent</th><th>Status</th></tr>
            </thead>
            <tbody id="historyTableBody">
              <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

<!-- ── Manager Approval Modal ── -->
<div class="modal-overlay" id="managerApprovalModal" style="opacity:0;pointer-events:none;">
  <div class="modal">
    <div class="modal-header">
      <h2>Approve Offboarding</h2>
      <button class="close-btn" onclick="document.getElementById('managerApprovalModal').classList.remove('active')">×</button>
    </div>
    <div style="padding:24px;">
      <input type="hidden" id="modalManagerReqId">
      <div class="a-field">
        <label class="a-label">Assign to System Team Agent</label>
        <select id="modalAgentSelect" class="a-input">
          <option value="">— Select Agent —</option>
          <option value="IT_AGENT_1">John Doe (IT Agent 1)</option>
          <option value="IT_AGENT_2">Jane Smith (IT Agent 2)</option>
        </select>
      </div>
      <div class="a-field">
        <label class="a-label">Remarks</label>
        <textarea id="modalManagerRemarks" class="a-input" rows="3" style="resize:vertical;"></textarea>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:8px;">
        <button class="btn btn-secondary" onclick="document.getElementById('managerApprovalModal').classList.remove('active')">Cancel</button>
        <button class="btn btn-primary" onclick="submitManagerApproval()">Approve &amp; Assign</button>
      </div>
    </div>
  </div>
</div>

<!-- ── System Team Task Modal ── -->
<div class="modal-overlay" id="systemTaskModal" style="opacity:0;pointer-events:none;">
  <div class="modal">
    <div class="modal-header">
      <h2>Complete IT Tasks</h2>
      <button class="close-btn" onclick="document.getElementById('systemTaskModal').classList.remove('active')">×</button>
    </div>
    <div style="padding:24px;">
      <p style="margin:0 0 20px;font-size:.875rem;">Revoking access for: <strong id="modalSysEmpName"></strong></p>
      <input type="hidden" id="modalSystemReqId">

      <div class="a-field">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:500;font-size:.9rem;">
          <input type="checkbox" id="modalAdRevoked" style="width:17px;height:17px;">
          AD Account Revoked (Email, Portals, Network, Printing)
        </label>
      </div>
      <div class="a-field">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:500;font-size:.9rem;">
          <input type="checkbox" id="modalPhysRevoked" style="width:17px;height:17px;">
          Physical Access Revoked (SmartXS, Doors)
        </label>
      </div>
      <div class="a-field" style="margin-top:8px;">
        <label class="a-label">Notes (Optional)</label>
        <textarea id="modalSysNotes" class="a-input" rows="2" style="resize:vertical;"></textarea>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
        <button class="btn btn-secondary" onclick="document.getElementById('systemTaskModal').classList.remove('active')">Cancel</button>
        <button class="btn btn-primary" onclick="submitSystemTask()">Save &amp; Complete</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin_shell_bottom') %>

<script>
  function switchTab(tabId, e) {
    document.querySelectorAll('.a-tab').forEach(b => b.classList.remove('a-tab--active'));
    document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
    if (e && e.target) e.target.classList.add('a-tab--active');
    document.getElementById('tab-' + tabId).style.display = 'block';
    if (tabId === 'manager') loadManagerRequests();
    if (tabId === 'system')  loadSystemRequests();
    if (tabId === 'history') loadHistoryRequests();
  }

  async function initiateOffboarding() {
    const empId = document.getElementById('initEmployeeId').value.trim();
    const msgEl = document.getElementById('initiateMessage');
    if (!empId) return;
    try {
      const res = await fetch('/api/offboarding/initiate', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ employeeId: empId }) });
      const data = await res.json();
      if (data.success) { msgEl.style.color = 'var(--a-green)'; msgEl.innerText = data.message; document.getElementById('initEmployeeId').value = ''; }
      else { msgEl.style.color = 'var(--a-red)'; msgEl.innerText = data.error; }
    } catch { msgEl.style.color = 'var(--a-red)'; msgEl.innerText = 'Network error.'; }
  }

  async function loadManagerRequests() {
    const tbody = document.getElementById('managerTableBody');
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--a-text-muted);">Loading…</td></tr>';
    try {
      const res = await fetch('/api/offboarding/pending-manager');
      const data = await res.json();
      if (!data.success || data.data.length === 0) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">No pending approvals.</td></tr>'; return; }
      tbody.innerHTML = data.data.map(req => `
        <tr>
          <td><strong>#${req.id}</strong></td>
          <td>${req.fullName} <span style="color:var(--a-text-muted);font-size:.8rem;">(${req.employeeId})</span></td>
          <td>${req.initiatedBy}</td>
          <td><button class="btn btn-secondary" style="padding:5px 12px;font-size:.8rem;" onclick="openManagerModal('${req.id}')">Approve</button></td>
        </tr>`).join('');
    } catch (e) { console.error(e); }
  }

  function openManagerModal(id) {
    document.getElementById('modalManagerReqId').value = id;
    document.getElementById('managerApprovalModal').classList.add('active');
  }

  async function submitManagerApproval() {
    const reqId   = document.getElementById('modalManagerReqId').value;
    const agentId = document.getElementById('modalAgentSelect').value;
    const remarks = document.getElementById('modalManagerRemarks').value;
    if (!agentId) { alert('Please select an agent'); return; }
    try {
      const res = await fetch('/api/offboarding/approve', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ requestId:reqId, assignedSystemAgentId:agentId, managerRemarks:remarks }) });
      const data = await res.json();
      if (data.success) { document.getElementById('managerApprovalModal').classList.remove('active'); loadManagerRequests(); }
      else alert(data.error);
    } catch { alert('Network Error'); }
  }

  async function loadSystemRequests() {
    const tbody = document.getElementById('systemTableBody');
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--a-text-muted);">Loading…</td></tr>';
    try {
      const res = await fetch('/api/offboarding/pending-system');
      const data = await res.json();
      if (!data.success || data.data.length === 0) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">No pending IT tasks.</td></tr>'; return; }
      tbody.innerHTML = data.data.map(req => `
        <tr>
          <td><strong>#${req.id}</strong></td>
          <td>${req.fullName} <span style="color:var(--a-text-muted);font-size:.8rem;">(${req.employeeId})</span></td>
          <td>${req.department}</td>
          <td><button class="btn btn-primary" style="padding:5px 12px;font-size:.8rem;" onclick="openSystemModal('${req.id}','${req.fullName}',${req.adRevoked},${req.physicalAccessRevoked})">Tasks</button></td>
        </tr>`).join('');
    } catch (e) { console.error(e); }
  }

  function openSystemModal(id, name, ad, phys) {
    document.getElementById('modalSystemReqId').value = id;
    document.getElementById('modalSysEmpName').innerText = name;
    document.getElementById('modalAdRevoked').checked = ad;
    document.getElementById('modalPhysRevoked').checked = phys;
    document.getElementById('systemTaskModal').classList.add('active');
  }

  async function submitSystemTask() {
    const reqId    = document.getElementById('modalSystemReqId').value;
    const adCheck  = document.getElementById('modalAdRevoked').checked;
    const physCheck= document.getElementById('modalPhysRevoked').checked;
    const notes    = document.getElementById('modalSysNotes').value;
    try {
      const res = await fetch('/api/offboarding/complete-task', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ requestId:reqId, adRevoked:adCheck, physicalAccessRevoked:physCheck, checklistNotes:notes }) });
      const data = await res.json();
      if (data.success) { document.getElementById('systemTaskModal').classList.remove('active'); loadSystemRequests(); }
      else alert(data.error);
    } catch { alert('Network Error'); }
  }

  async function loadHistoryRequests() {
    const tbody = document.getElementById('historyTableBody');
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--a-text-muted);">Loading…</td></tr>';
    try {
      const res = await fetch('/api/offboarding/all');
      const data = await res.json();
      if (!data.success || data.data.length === 0) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--a-text-muted);">No history found.</td></tr>'; return; }
      tbody.innerHTML = data.data.map(req => `
        <tr>
          <td><strong>#${req.id}</strong></td>
          <td>${req.fullName} <span style="color:var(--a-text-muted);font-size:.8rem;">(${req.employeeId})</span></td>
          <td>${req.assignedSystemAgentId || '—'}</td>
          <td><span class="badge ${req.status==='Completed'?'completed':'in_progress'}">${req.status}</span></td>
        </tr>`).join('');
    } catch (e) { console.error(e); }
  }
</script>

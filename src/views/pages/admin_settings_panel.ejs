<%- include('../partials/admin_shell_top', { activeTab: 'settings' }) %>

  <!-- Page header -->
  <div class="a-page-hd a-page-hd--row">
    <div>
      <h1 class="a-page-hd__title">HRMS Synchronization</h1>
      <p class="a-page-hd__sub">Pull the latest employee data from Oracle HRMS (IFL_EMP_INFO_WF_SERVICE).</p>
    </div>
    <button class="btn btn-primary" id="syncBtn" onclick="triggerSync()">↺ Force Sync Now</button>
  </div>

  <!-- Sync config card -->
  <div class="a-card">
    <div class="a-card__hd">
      <div>
        <h2 class="a-card__title">Automated Schedule</h2>
        <p class="a-card__desc">Configure when HRMS sync runs automatically.</p>
      </div>
    </div>
    <div class="a-card__body">
      <%- include('../partials/cron_builder', { config: config }) %>
      <div style="margin-top:20px;">
        <button class="btn btn-primary" onclick="updateConfig()" id="btnSaveConfig">Save Schedule</button>
      </div>
    </div>
  </div>

  <!-- Sync history card -->
  <div class="a-card">
    <div class="a-card__hd">
      <h2 class="a-card__title">Sync History</h2>
      <span class="a-chip"><%= syncLogs ? syncLogs.length : 0 %> records</span>
    </div>
    <div class="a-card__body" style="padding:0;">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Type</th>
              <th>Status</th>
              <th>Processed</th>
              <th>Started</th>
              <th>Completed</th>
            </tr>
          </thead>
          <tbody>
            <% if (syncLogs && syncLogs.length > 0) { %>
              <% syncLogs.forEach(log => { %>
                <tr>
                  <td style="color:var(--a-text-muted);">#<%= log.id %></td>
                  <td><strong><%= log.syncType %></strong></td>
                  <td><span class="badge <%= log.syncStatus.toLowerCase() %>"><%= log.syncStatus %></span></td>
                  <td><%= log.recordsProcessed %></td>
                  <td style="color:var(--a-text-muted);font-size:.82rem;"><%= new Date(log.startedAt).toLocaleString() %></td>
                  <td style="color:var(--a-text-muted);font-size:.82rem;"><%= log.completedAt ? new Date(log.completedAt).toLocaleString() : '—' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center;padding:40px;color:var(--a-text-muted);">No sync history available.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

<%- include('../partials/admin_shell_bottom') %>

<script>
  async function updateConfig() {
    const btn = document.getElementById('btnSaveConfig');
    const enabled = document.getElementById('enableSchedule').checked;
    const expression = document.getElementById('cronExpression').value;
    btn.disabled = true; btn.innerText = 'Saving…';
    try {
      const res = await fetch('/admin/update-sync-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled, expression })
      });
      const json = await res.json();
      if (json.success) IflDialog.success(json.message || 'Schedule updated.');
      else IflDialog.error(json.error || 'Failed to update schedule.');
    } catch { IflDialog.error('Network error while updating config.'); }
    finally { btn.disabled = false; btn.innerText = 'Save Schedule'; }
  }

  async function triggerSync() {
    const btn = document.getElementById('syncBtn');
    btn.disabled = true; btn.innerText = '↺ Syncing…';
    try {
      const res = await fetch('/admin/sync-now', { method:'POST', headers:{'Content-Type':'application/json'} });
      const json = await res.json();
      if (json.success) {
        await IflDialog.success(json.message || 'Sync completed.');
        window.location.reload();
      } else {
        IflDialog.error(json.error || 'Sync failed.');
        btn.disabled = false; btn.innerText = '↺ Force Sync Now';
      }
    } catch {
      IflDialog.error('Network error. Please retry.');
      btn.disabled = false; btn.innerText = '↺ Force Sync Now';
    }
  }
</script>

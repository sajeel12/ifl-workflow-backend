<%
    // Renders the role-portal sidebar shell (left sidebar + detail-modal markup
    // + all sidebar CSS), and opens <main class="portal-main"> so the caller
    // can place its page-specific content inside. The caller MUST include
    // partials/portal_close.ejs after its main content, and
    // partials/portal_scripts.ejs near the end of the page (after the body
    // markup) to wire up the sidebar's fetching + tab behaviour.
    //
    // Required locals:
    //   showPortal : boolean — when false, this partial renders nothing
    //   roleKey    : string  — passed to /api/onboarding/queue (e.g. 'HOD')
    //   roleLabel  : string  — human label shown in the sidebar head
%>
<% if (locals.showPortal) { %>
<style>
    /* ── Layout shell ────────────────────────────────────────────── */
    .portal-shell {
        display: flex;
        min-height: calc(100vh - 90px);
        background: #f1f5f9;
    }
    .portal-sidebar {
        width: 304px; flex-shrink: 0;
        background: #ffffff;
        border-right: 1px solid #e2e8f0;
        box-shadow:
            1px 0 0 rgba(15, 23, 42, 0.02),
            4px 0 24px -8px rgba(15, 23, 42, 0.05);
        display: flex; flex-direction: column;
        position: sticky; top: 0; align-self: flex-start;
        height: calc(100vh - 90px); overflow: hidden;
    }

    /* ── Sidebar header — gradient accent + role chip ─────────────── */
    .portal-side-head {
        padding: 22px 22px 18px;
        background:
            radial-gradient(ellipse at top right, rgba(0, 120, 212, 0.08) 0%, transparent 70%),
            #ffffff;
        border-bottom: 1px solid #f1f5f9;
        position: relative;
    }
    .portal-side-head::before {
        content: '';
        position: absolute; left: 0; right: 0; top: 0; height: 3px;
        background: linear-gradient(90deg, #0078D4 0%, #00BCF2 100%);
    }
    .portal-side-head .ps-role {
        display: inline-block;
        font-size: 0.66rem; font-weight: 700; color: #0078D4;
        text-transform: uppercase; letter-spacing: 0.08em;
        background: #e0f2fe;
        padding: 4px 10px; border-radius: 999px;
        margin-bottom: 10px;
    }
    .portal-side-head .ps-title {
        font-size: 1.18rem; font-weight: 800; color: #0f172a;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }
    .portal-side-head .ps-sub {
        font-size: 0.78rem; color: #64748b; margin-top: 5px;
        line-height: 1.45;
    }

    /* ── Tabs — pill-style sliding indicator ──────────────────────── */
    .portal-tabs {
        display: flex;
        padding: 14px 18px 12px;
        gap: 6px;
        background: #fff;
        border-bottom: 1px solid #f1f5f9;
    }
    .portal-tab {
        flex: 1;
        background: #f8fafc;
        border: 1px solid transparent;
        padding: 9px 8px;
        font-size: 0.8rem; font-weight: 600; color: #64748b;
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.16s ease;
        font-family: inherit;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    }
    .portal-tab:hover {
        color: #0f172a;
        background: #eef2f7;
    }
    .portal-tab.is-active {
        color: #ffffff;
        background: linear-gradient(135deg, #0078D4 0%, #005fa8 100%);
        border-color: rgba(0, 120, 212, 0.4);
        box-shadow:
            0 4px 12px -4px rgba(0, 120, 212, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    .portal-tab .ps-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 18px; height: 18px;
        background: #cbd5e1; color: #475569;
        padding: 0 6px; border-radius: 999px;
        font-size: 0.66rem; font-weight: 700;
        line-height: 1;
    }
    .portal-tab.is-active .ps-count {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }
    .portal-tab:hover:not(.is-active) .ps-count { background: #94a3b8; color: #ffffff; }

    /* ── List + custom scrollbar ──────────────────────────────────── */
    .portal-list {
        flex: 1;
        overflow-y: auto;
        padding: 12px 12px 28px;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }
    .portal-list::-webkit-scrollbar { width: 6px; }
    .portal-list::-webkit-scrollbar-track { background: transparent; }
    .portal-list::-webkit-scrollbar-thumb {
        background: #cbd5e1; border-radius: 999px;
    }
    .portal-list::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    .portal-list-state {
        padding: 40px 22px;
        text-align: center;
        color: #94a3b8; font-size: 0.85rem;
        line-height: 1.5;
    }
    .portal-list-state .pls-spin {
        width: 26px; height: 26px;
        border: 2.5px solid #e2e8f0;
        border-top-color: #0078D4;
        border-radius: 50%;
        animation: ps-spin 0.8s linear infinite;
        display: inline-block; margin-bottom: 10px;
    }
    @keyframes ps-spin { to { transform: rotate(360deg); } }

    /* ── Row card — soft card surface with hover lift ─────────────── */
    .portal-row {
        display: block;
        padding: 12px 14px;
        margin-bottom: 6px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        text-decoration: none; color: inherit;
        transition:
            transform 0.12s ease,
            box-shadow 0.16s ease,
            border-color 0.16s ease,
            background 0.12s ease;
        position: relative;
    }
    .portal-row:hover {
        transform: translateY(-1px);
        background: #fbfdff;
        border-color: #bfdbfe;
        box-shadow:
            0 4px 12px -4px rgba(15, 23, 42, 0.08),
            0 2px 4px -2px rgba(15, 23, 42, 0.04);
    }
    .portal-row.is-active {
        background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
        border-color: #93c5fd;
    }
    .portal-row .pr-top {
        display: flex; align-items: center; justify-content: space-between;
        gap: 8px;
    }
    .portal-row .pr-name {
        font-size: 0.92rem; font-weight: 600; color: #0f172a;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
        flex: 1;
        letter-spacing: -0.005em;
    }
    .portal-row .pr-badge {
        font-size: 0.62rem; font-weight: 700;
        padding: 3px 8px; border-radius: 999px;
        text-transform: uppercase; letter-spacing: 0.05em;
        flex-shrink: 0;
        border: 1px solid transparent;
        line-height: 1;
    }
    .portal-row .pr-badge.is-now {
        background: #fef3c7; color: #b45309; border-color: #fde68a;
    }
    .portal-row .pr-badge.is-done {
        background: #f1f5f9; color: #64748b; border-color: #e2e8f0;
    }
    .portal-row .pr-meta {
        font-size: 0.74rem; color: #64748b;
        margin-top: 6px; line-height: 1.4;
        display: flex; flex-wrap: wrap; gap: 0;
    }
    .portal-row .pr-meta strong { color: #475569; font-weight: 600; }

    /* Current-row treatment — distinct, animated dot, brand-gradient bg */
    .portal-row.is-current {
        background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
        border-color: #60a5fa;
        box-shadow:
            0 4px 14px -6px rgba(0, 120, 212, 0.32),
            inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }
    .portal-row.is-current:hover { transform: none; }
    .portal-row.is-current .pr-current-dot {
        display: inline-block;
        width: 7px; height: 7px; border-radius: 50%;
        background: #0078D4;
        box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.25);
        margin-right: 7px;
        animation: ps-pulse 1.6s ease-in-out infinite;
        vertical-align: 1px;
    }
    @keyframes ps-pulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.25); }
        50%      { box-shadow: 0 0 0 7px rgba(0, 120, 212, 0.06); }
    }

    .portal-main {
        flex: 1; min-width: 0;
        padding: 0;
        height: calc(100vh - 90px);
        overflow: hidden;
    }

    @media (max-width: 1000px) {
        .portal-shell { flex-direction: column; }
        .portal-sidebar {
            width: 100%; max-height: none;
            position: static; border-right: none;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: none;
        }
        .portal-list { max-height: 320px; }
    }

    .portal-row .pr-time {
        font-size: 0.71rem; color: #94a3b8;
        margin-top: 6px; line-height: 1.3;
        display: inline-flex; align-items: center; gap: 4px;
    }
    .portal-row .pr-time::before {
        content: '';
        display: inline-block;
        width: 4px; height: 4px; border-radius: 50%;
        background: #cbd5e1;
        margin-right: 2px;
    }
    .portal-row .pr-sub-name {
        font-size: 0.78rem; color: #475569;
        margin-top: 4px; line-height: 1.4;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* Tone-coloured badges with subtle border for clarity */
    .pr-badge.tone-success {
        background: #dcfce7; color: #15803d; border-color: #86efac;
    }
    .pr-badge.tone-danger {
        background: #fee2e2; color: #b91c1c; border-color: #fca5a5;
    }
    .pr-badge.tone-warning {
        background: #fef3c7; color: #b45309; border-color: #fde68a;
    }
    .pr-badge.tone-info {
        background: #dbeafe; color: #1d4ed8; border-color: #93c5fd;
    }

    /* ─── Detail popup ─────────────────────────────────────── */
    .ifl-detail-backdrop {
        position: fixed; inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        display: flex; align-items: center; justify-content: center;
        z-index: 5000;
        opacity: 0; pointer-events: none;
        transition: opacity 0.18s ease;
    }
    .ifl-detail-backdrop.is-open { opacity: 1; pointer-events: auto; }
    .ifl-detail-card {
        background: #fff;
        border-radius: 14px;
        width: min(640px, calc(100vw - 32px));
        max-height: calc(100vh - 80px);
        box-shadow: 0 20px 60px -16px rgba(0, 0, 0, 0.35);
        transform: translateY(8px) scale(0.97);
        transition: transform 0.18s ease;
        display: flex; flex-direction: column;
        overflow: hidden;
    }
    .ifl-detail-backdrop.is-open .ifl-detail-card { transform: translateY(0) scale(1); }

    .ifl-detail-header {
        padding: 22px 26px;
        background: linear-gradient(120deg, #0078D4 0%, #005fa8 100%);
        color: #fff;
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px;
        flex-shrink: 0;
    }
    .ifl-detail-header .idh-name { font-size: 1.05rem; font-weight: 700; line-height: 1.3; }
    .ifl-detail-header .idh-sub { font-size: 0.82rem; opacity: 0.88; margin-top: 2px; }
    .ifl-detail-close {
        background: rgba(255,255,255,0.18);
        border: none; color: #fff;
        width: 32px; height: 32px; border-radius: 50%;
        cursor: pointer; font-size: 18px; line-height: 1;
        flex-shrink: 0;
    }
    .ifl-detail-close:hover { background: rgba(255,255,255,0.32); }

    .ifl-detail-body {
        padding: 22px 26px;
        overflow-y: auto; flex: 1;
    }
    .ifl-detail-state {
        text-align: center; padding: 32px 0;
        color: #64748b; font-size: 0.9rem;
    }
    .ifl-detail-state .idsp {
        width: 26px; height: 26px;
        border: 3px solid #e2e8f0;
        border-top-color: #0078D4;
        border-radius: 50%;
        animation: ps-spin 0.8s linear infinite;
        display: inline-block; margin-bottom: 8px;
    }

    .ifl-detail-section {
        margin-bottom: 18px;
    }
    .ifl-detail-section:last-child { margin-bottom: 0; }
    .ifl-detail-section h4 {
        font-size: 0.72rem; font-weight: 700; color: #64748b;
        letter-spacing: 0.06em; text-transform: uppercase;
        margin: 0 0 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f1f5f9;
    }
    .ifl-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
    }
    .ifl-detail-grid .idg-label {
        font-size: 0.7rem; font-weight: 600;
        color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;
        margin-bottom: 2px;
    }
    .ifl-detail-grid .idg-value {
        font-size: 0.92rem; color: #0f172a; font-weight: 500;
        word-break: break-word;
    }
    .ifl-detail-pill {
        display: inline-block; padding: 3px 10px; border-radius: 999px;
        font-size: 0.72rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.04em;
    }
    .ifl-detail-pill.is-pending { background: #fef3c7; color: #b45309; }
    .ifl-detail-pill.is-done    { background: #dcfce7; color: #15803d; }
    .ifl-detail-pill.is-rejected{ background: #fee2e2; color: #b91c1c; }

    .ifl-detail-timeline { padding-left: 0; list-style: none; margin: 0; }
    .ifl-detail-timeline li {
        position: relative;
        padding: 0 0 16px 28px;
        border-left: 2px solid #e2e8f0;
        margin-left: 9px;
    }
    .ifl-detail-timeline li:last-child { border-left-color: transparent; padding-bottom: 0; }
    .ifl-detail-timeline .idt-dot {
        position: absolute; left: -9px; top: 0;
        width: 18px; height: 18px; border-radius: 50%;
        background: #0078D4; color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.65rem; font-weight: 700;
        box-shadow: 0 0 0 3px #fff;
    }
    .ifl-detail-timeline .idt-dot.is-done { background: #16a34a; }
    .ifl-detail-timeline .idt-dot.is-rejected { background: #dc2626; }
    .ifl-detail-timeline .idt-action { font-size: 0.88rem; color: #0f172a; font-weight: 500; line-height: 1.4; }
    .ifl-detail-timeline .idt-meta { font-size: 0.72rem; color: #94a3b8; margin-top: 3px; }
    .ifl-detail-timeline .idt-role { font-weight: 700; color: #475569; margin-right: 6px; }
</style>
<div class="portal-shell">
    <aside class="portal-sidebar">
        <div class="portal-side-head">
            <div class="ps-role"><%= locals.roleLabel %></div>
            <div class="ps-title">My Queue</div>
            <div class="ps-sub">Tasks routed to your role</div>
        </div>
        <div class="portal-tabs">
            <button type="button" class="portal-tab is-active" data-tab="pending" onclick="iflPortal.switchTab('pending')">
                Pending <span class="ps-count" id="ps-count-pending"></span>
            </button>
            <button type="button" class="portal-tab" data-tab="history" onclick="iflPortal.switchTab('history')">
                History <span class="ps-count" id="ps-count-history"></span>
            </button>
        </div>
        <div class="portal-list" id="portalList">
            <div class="portal-list-state">
                <div class="pls-spin"></div>
                <div>Loading your tasks…</div>
            </div>
        </div>
    </aside>

    <!-- Detail popup (history-row click target) -->
    <div id="iflDetailBackdrop" class="ifl-detail-backdrop" aria-hidden="true">
      <div class="ifl-detail-card" role="dialog" aria-labelledby="iflDetailName">
        <div class="ifl-detail-header">
          <div>
            <div class="idh-name" id="iflDetailName">Request</div>
            <div class="idh-sub" id="iflDetailSub"></div>
          </div>
          <button class="ifl-detail-close" type="button" onclick="iflPortalDetail.close()" aria-label="Close">×</button>
        </div>
        <div class="ifl-detail-body" id="iflDetailBody">
          <div class="ifl-detail-state"><div class="idsp"></div><div>Loading details…</div></div>
        </div>
      </div>
    </div>

    <main class="portal-main">
<% } %>

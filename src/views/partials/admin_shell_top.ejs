<%- include('./header') %>
<link rel="stylesheet" href="/css/admin.css">

<div class="a-page">

  <!-- ── Top Header ── -->
  <header class="a-header">
    <img src="/logo.png" alt="IFL" class="a-header__logo" onerror="this.style.display='none'">
    <div class="a-header__brand">
      <div class="a-header__title">IFL Admin Portal</div>
      <div class="a-header__sub">System Management</div>
    </div>
    <span class="a-header__badge">Admin</span>
  </header>

  <!-- ── Shell: sidebar + main ── -->
  <div class="a-shell">

    <!-- Sidebar -->
    <aside class="a-sidebar">
      <div class="a-sidebar__heading">Administration</div>
      <nav class="a-nav">

        <!-- HOD Assignment -->
        <a href="/admin/hod-panel"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'hod') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          HOD Assignment
        </a>

        <!-- Workflow Approvers -->
        <a href="/admin/workflow-approvers"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'approvers') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          Workflow Approvers
        </a>


        <!-- Onboarding History -->
        <a href="/admin/onboarding-history"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'history') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M3 21v-5h5"/>
          </svg>
          Onboarding History
        </a>

        <hr class="a-sidebar__divider">

        <!-- System Configuration -->
        <a href="/admin/system-config"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'config') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6m0 6v6"/>
            <path d="M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24"/>
            <path d="M1 12h6m6 0h6"/>
            <path d="M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"/>
          </svg>
          System Config
        </a>

        <!-- HRMS Sync -->
        <a href="/admin/settings"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'settings') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/>
            <polyline points="23 20 23 14 17 14"/>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
          </svg>
          HRMS Sync
        </a>

        <!-- Offboarding -->
        <a href="/admin/offboarding"
           class="a-nav__item <%= (typeof activeTab !== 'undefined' && activeTab === 'offboarding') ? 'a-nav__item--active' : '' %>">
          <svg class="a-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Offboarding
        </a>

      </nav>
    </aside>

    <!-- Main content — page injects content here -->
    <main class="a-main">

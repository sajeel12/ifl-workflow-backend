<!DOCTYPE html>
<html>

<head>
    <title>
        <%= locals.title ? title : 'IFL Workflow' %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Segoe UI Web (West European)', 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', sans-serif;
            background-color: #faf9f8;
            color: #323130;
        }

        .header {
            background: linear-gradient(120deg, #0078D4 0%, #005fa8 60%, #004880 100%);
            padding: 0 24px;
            height: 66px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 14px rgba(0, 120, 212, 0.28);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* SSO identity badge — sits at the right edge of whichever header
           the page provides (.a-header for admin, .header for form views). */
        .sso-badge {
            margin-left: auto;
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.12);
            padding: 5px 14px 5px 6px;
            border-radius: 999px;
            color: #fff;
            font-size: 12.5px;
            line-height: 1.15;
            white-space: nowrap;
            max-width: 240px;
        }

        .sso-badge .sso-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.25);
            color: #fff;
            font-weight: 700;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-transform: uppercase;
            flex: 0 0 auto;
        }

        .sso-badge .sso-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            min-width: 0;
            overflow: hidden;
        }

        .sso-badge .sso-name {
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .sso-badge .sso-meta {
            font-size: 10.5px;
            opacity: 0.85;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .sso-badge.is-anonymous .sso-avatar {
            background: rgba(255, 255, 255, 0.15);
        }

        .sso-badge.is-anonymous .sso-name {
            font-weight: 500;
            opacity: 0.85;
        }

        /* When inside the admin header, sit next to the existing "Admin" pill,
           not on top of it — the .a-header__badge already has margin-left:auto,
           so we drop ours so the two badges share the right side cleanly. */
        .a-header>.sso-badge {
            margin-left: 12px;
        }

        /* In the onboarding-form header (.app-header uses justify-content:
           space-between with a left brand-section and a right status-section),
           the SSO badge would compete with .status-section for the right edge
           and overlap it. Drop the auto-margin and add a small gap instead so
           the two pills sit side-by-side on the right. */
        .app-header {
            gap: 12px;
        }

        .app-header>.sso-badge {
            margin-left: 12px;
        }

        .logo {
            height: 48px;
            padding: 6px;
        }

        .brand {
            color: white;
            font-weight: 600;
            font-size: 20px;
        }

        .main-container {
            max-width: 720px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            box-shadow: 0 1.6px 3.6px 0 rgba(0, 0, 0, 0.132), 0 0.3px 0.9px 0 rgba(0, 0, 0, 0.108);
            padding: 32px;
            border-radius: 0;
        }

        /* Common messaging styles */
        .message-container {
            max-width: 600px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            box-shadow: 0 1.6px 3.6px 0 rgba(0, 0, 0, 0.132);
            text-align: center;
        }

        .message-icon {
            font-size: 48px;
            margin-bottom: 20px;
        }

        .success-icon {
            color: #107C10;
        }

        .error-icon {
            color: #D13438;
        }

        .info-icon {
            color: #0078D4;
        }

        .message-title {
            margin-top: 0;
            font-weight: 600;
            margin-bottom: 10px;
            color: #201f1e;
        }

        .message-title.error {
            color: #D13438;
        }

        .message-title.info {
            color: #0078D4;
        }

        .message-text {
            color: #323130;
            margin-bottom: 20px;
        }

        .meta {
            color: #605e5c;
            font-size: 13px;
            margin-top: 10px;
        }

        .comment-box {
            background: #f3f2f1;
            padding: 15px;
            margin-top: 20px;
            text-align: left;
        }

        .comment-box.success {
            border-left: 4px solid #107C10;
        }

        .comment-box.error {
            border-left: 4px solid #D13438;
        }

        /* ─── IflDialog — global custom alert/confirm modal ─────────────── */
        .ifld-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 4000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s ease;
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .ifld-backdrop.is-open {
            opacity: 1;
            pointer-events: auto;
        }

        .ifld-dialog {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.35);
            padding: 28px 28px 22px;
            min-width: 320px;
            max-width: 440px;
            transform: translateY(8px) scale(0.97);
            transition: transform 0.18s ease;
            text-align: center;
        }

        .ifld-backdrop.is-open .ifld-dialog {
            transform: translateY(0) scale(1);
        }

        .ifld-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 26px;
        }

        .ifld-icon svg {
            width: 28px;
            height: 28px;
            stroke-width: 2;
        }

        .ifld-icon--info {
            background: #DBEAFE;
            color: #1D4ED8;
        }

        .ifld-icon--success {
            background: #DCFCE7;
            color: #15803D;
        }

        .ifld-icon--warning {
            background: #FEF3C7;
            color: #B45309;
        }

        .ifld-icon--error {
            background: #FEE2E2;
            color: #B91C1C;
        }

        .ifld-icon--confirm {
            background: #FEF3C7;
            color: #B45309;
        }

        .ifld-title {
            font-size: 1.08rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0 0 6px;
        }

        .ifld-message {
            font-size: 0.92rem;
            color: #334155;
            line-height: 1.5;
            margin: 0 0 22px;
            white-space: pre-line;
            word-wrap: break-word;
        }

        .ifld-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            border-top: 1px solid #E2E8F0;
            padding-top: 14px;
        }

        .ifld-actions.is-single {
            justify-content: center;
        }

        .ifld-btn {
            padding: 9px 20px;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: background 0.12s, transform 0.06s;
            min-width: 80px;
            font-family: inherit;
        }

        .ifld-btn:active {
            transform: scale(0.97);
        }

        .ifld-btn-cancel {
            background: #F1F5F9;
            color: #475569;
            border-color: #E2E8F0;
        }

        .ifld-btn-cancel:hover {
            background: #E2E8F0;
        }

        .ifld-btn-confirm {
            background: #0078D4;
            color: #fff;
        }

        .ifld-btn-confirm:hover {
            background: #006bb8;
        }

        .ifld-btn-confirm.is-danger {
            background: #DC2626;
        }

        .ifld-btn-confirm.is-danger:hover {
            background: #B91C1C;
        }
    </style>

    <%#
        Pages that include this partial via {adminCss: true} (the admin shell)
        get admin.css loaded inside <head> so its rules apply before any body
        content paints. Without this, modal-overlay defaults to visible and
        nav SVGs render at their natural large size for the first frame —
        a classic FOUC glitch during page navigation.
    %>
    <% if (typeof adminCss !== 'undefined' && adminCss) { %>
        <link rel="stylesheet" href="/css/admin.css">
    <% } %>
</head>

<body>
    <!--
        Global SSO identity badge — populated at runtime from /api/auth/me.
        At DOMContentLoaded the badge is moved into whichever header bar
        exists on the current page (.a-header for admin, .header for form
        views) so it sits inside the bar's flex flow rather than floating
        and overlapping. If neither header exists, it falls back to fixed.
    -->
    <div id="ssoBadge" class="sso-badge is-anonymous">
        <div class="sso-avatar">?</div>
        <div class="sso-text">
            <div class="sso-name">Checking session…</div>
            <div class="sso-meta">SSO</div>
        </div>
    </div>
    <script>
        (function () {
            const badge = document.getElementById('ssoBadge');
            if (!badge) return;

            const set = (name, meta, signedIn) => {
                badge.classList.toggle('is-anonymous', !signedIn);
                const initials = (name || '?').trim().split(/\s+/).slice(0, 2).map(p => p[0] || '').join('').toUpperCase() || '?';
                badge.querySelector('.sso-avatar').textContent = initials;
                badge.querySelector('.sso-name').textContent = name || 'Not signed in';
                badge.querySelector('.sso-meta').textContent = meta || 'SSO';
            };

            // Move the badge into the host header bar so it doesn't float.
            //   .a-header   → admin shell
            //   .app-header → onboarding form / message pages
            //   body > .header → fallback for any page that uses the legacy class
            // Falls back to a fixed top-right position only if no header is present.
            const attachToHeader = () => {
                const host = document.querySelector('.a-header')
                    || document.querySelector('.app-header')
                    || document.querySelector('.pd-topbar')
                    || document.querySelector('.pm-topbar')
                    || document.querySelector('body > .header');
                if (host) {
                    badge.style.position = 'static';
                    badge.style.top = badge.style.right = badge.style.zIndex = '';
                    host.appendChild(badge);
                } else {
                    badge.style.position = 'fixed';
                    badge.style.top = '14px';
                    badge.style.right = '24px';
                    badge.style.zIndex = '1100';
                }
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', attachToHeader);
            } else {
                attachToHeader();
            }

            // ─── Sidecar SSO flow ─────────────────────────────────────
            // 1. Grab a signed token from /token.aspx (IIS handles Windows Auth there).
            // 2. Use that token in the x-sidecar-token header for all /api/* calls
            //    that go through Node's ssoMiddleware.
            // 3. Cache the token in sessionStorage so we don't hit token.aspx on
            //    every request — but treat tokens older than 4 minutes as stale
            //    (the middleware allows up to 5 minutes; we leave a safety margin).
            const TOKEN_KEY = 'x-sidecar-token';
            const TOKEN_TS_KEY = 'x-sidecar-token-ts';
            const TOKEN_TTL_MS = 4 * 60 * 1000;

            const getCachedToken = () => {
                try {
                    const t = sessionStorage.getItem(TOKEN_KEY);
                    const ts = parseInt(sessionStorage.getItem(TOKEN_TS_KEY) || '0', 10);
                    if (t && (Date.now() - ts) < TOKEN_TTL_MS) {
                        // Don't serve a cached token that has no email — force a fresh fetch
                        // so the retry logic in fetchFreshToken gets another attempt.
                        try { const p = JSON.parse(t); if (!p.email) return null; } catch (_) {}
                        return t;
                    }
                } catch (_) { }
                return null;
            };

            const doFetchToken = async () => {
                const r = await fetch('/token.aspx', { credentials: 'include', cache: 'no-store' });
                if (!r.ok) throw new Error('token.aspx ' + r.status);
                const j = await r.json();
                if (!j || !j.signature) throw new Error('token.aspx returned no signature');
                return j;
            };

            const fetchFreshToken = async () => {
                // credentials: 'include' is required so the browser sends Windows
                // creds to /token.aspx via the same origin (IIS).
                let j = await doFetchToken();

                // token.aspx can return a valid signature but an empty email when its
                // AD lookup loses a race (slow DC, cold LDAP connection). Retry once
                // after 1.5 s — the second call almost always has the email populated.
                // Never cache a token that has no email; always re-fetch next time.
                if (!j.email) {
                    console.warn('[SSO] token.aspx returned no email — retrying in 1.5 s');
                    await new Promise(ok => setTimeout(ok, 1500));
                    try { j = await doFetchToken(); } catch (_) { /* keep first result */ }
                    if (!j.email) {
                        console.warn('[SSO] token.aspx still returned no email after retry — proceeding without (server will hydrate from AD)');
                        // Return the token but do NOT cache it so the next page load retries.
                        return JSON.stringify(j);
                    }
                }

                const stash = JSON.stringify(j);
                try {
                    sessionStorage.setItem(TOKEN_KEY, stash);
                    sessionStorage.setItem(TOKEN_TS_KEY, String(Date.now()));
                } catch (_) { }
                return stash;
            };

            const getToken = async () => getCachedToken() || await fetchFreshToken();

            // ── window.iflFetch — ALWAYS use this instead of plain fetch() ──────
            // for any call to a route guarded by ssoMiddleware or adminApiGuard.
            // Plain fetch() does NOT attach a sidecar token, so the server guard
            // has no identity and returns 403/401. A 401 causes IIS Windows-Auth
            // to intercept and show a login popup — broken UX on every API call.
            // Exception: fetch('/token.aspx') here must stay plain (it bootstraps
            // the token). Open/unguarded routes are also fine with plain fetch.
            //
            // Idle-tab self-healing: on a 401 we ASSUME the cached token went
            // stale (a tab left open >5 min hits the server's 300s window). We
            // bust the cache, force a fresh /token.aspx round-trip, and re-issue
            // the request exactly once. If that still 401s we give up and let
            // the IflDialog session-expired listener prompt a reload.
            const issueRequest = (url, opts, token) => {
                const headers = Object.assign({}, opts.headers || {}, { 'x-sidecar-token': token });
                return fetch(url, Object.assign({ credentials: 'include' }, opts, { headers }));
            };
            window.iflFetch = async (url, opts = {}) => {
                let token = await getToken();
                let res   = await issueRequest(url, opts, token);
                if (res.status !== 401) return res;
                // Stale-token recovery — one shot, no loops. We deliberately do
                // NOT dispatch any session-expired event here: that path used to
                // pop a modal + force a reload, which on a server where
                // /token.aspx is flaky (slow AD lookups, transient IIS hiccups)
                // creates a reload loop the user can't escape from. Instead, log
                // quietly and let the caller render its own inline error. The
                // user can recover by opening a new tab — same as before — but
                // no automatic dialog interrupts them.
                try {
                    sessionStorage.removeItem(TOKEN_KEY);
                    sessionStorage.removeItem(TOKEN_TS_KEY);
                } catch (_) { /* private mode / quota — ignore */ }
                try {
                    token = await fetchFreshToken();
                } catch (e) {
                    console.warn('[SSO] Fresh token fetch failed during 401 recovery:', e && e.message);
                    return res;
                }
                const retry = await issueRequest(url, opts, token);
                if (retry.status === 401) {
                    console.warn('[SSO] Retry still 401 after fresh token — surfacing failure to caller');
                }
                return retry;
            };
            window.iflGetToken = getToken;
            window.iflGetUser = async () => {
                try {
                    const r = await window.iflFetch('/api/auth/me');
                    if (!r.ok) return null;
                    const j = await r.json();
                    return (j && j.user) ? j.user : null;
                } catch (_) { return null; }
            };

            // ─── Visibility pre-warmer ────────────────────────────────────────
            // When the user comes back to a long-idle tab, fetch a fresh token
            // in the background BEFORE they click anything — so the first click
            // hits a warm cache instead of taking the silent-retry path.
            // Guarded by an in-flight flag so rapid focus/blur events don't
            // stack /token.aspx calls.
            let __tokenWarmInFlight = false;
            const warmTokenIfStale = () => {
                if (__tokenWarmInFlight) return;
                let needsWarm = true;
                try {
                    const ts = parseInt(sessionStorage.getItem(TOKEN_TS_KEY) || '0', 10);
                    // 30s headroom: warm if we're within 30s of the 4-min TTL
                    // expiring, so a click landing right after focus still finds
                    // a fresh token in cache.
                    needsWarm = !ts || (Date.now() - ts) > (TOKEN_TTL_MS - 30000);
                } catch (_) { /* assume warm needed */ }
                if (!needsWarm) return;
                __tokenWarmInFlight = true;
                fetchFreshToken()
                    .catch(e => console.warn('[SSO] Background token warm failed:', e && e.message))
                    .finally(() => { __tokenWarmInFlight = false; });
            };
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') warmTokenIfStale();
            });

            (async () => {
                try {
                    const r = await window.iflFetch('/api/auth/me');
                    if (!r.ok) throw new Error('auth/me ' + r.status);
                    const j = await r.json();
                    if (j && j.user) {
                        const u = j.user;
                        const role = u.designation;
                        set(u.displayName || u.username || u.email, role, true);
                    } else {
                        set('Not signed in', 'SSO required', false);
                    }
                } catch (err) {
                    console.warn('[SSO]', err && err.message);
                    set('Not signed in', 'SSO unavailable', false);
                }
            })();
        })();
    </script>

    <!-- ─── Global custom dialog (alert / confirm replacement) ─────────────
         API:
             await IflDialog.alert('message', { title?, variant? });
             const ok = await IflDialog.confirm('message', { title?, okText?, cancelText?, danger? });
             IflDialog.success('Saved');   IflDialog.error('Network error');
         All return Promises. Pages can also keep using window.alert(...) —
         it's transparently delegated to IflDialog.alert. window.confirm is
         intentionally NOT overridden (it has to stay sync for legacy inline
         handlers); confirm call-sites are migrated to IflDialog.confirm.
    -->
    <div id="iflDialogBackdrop" class="ifld-backdrop" role="dialog" aria-hidden="true">
        <div class="ifld-dialog" role="document">
            <div class="ifld-icon ifld-icon--info" id="iflDialogIcon"></div>
            <h3 class="ifld-title" id="iflDialogTitle"></h3>
            <p class="ifld-message" id="iflDialogMessage"></p>
            <div class="ifld-actions" id="iflDialogActions">
                <button type="button" class="ifld-btn ifld-btn-cancel" id="iflDialogCancel">Cancel</button>
                <button type="button" class="ifld-btn ifld-btn-confirm" id="iflDialogConfirm">OK</button>
            </div>
        </div>
    </div>
    <script>
        (function () {
            const ICONS = {
                info: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
                success: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
                warning: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
                error: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
                confirm: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
            };
            const DEFAULT_TITLES = {
                info: 'Information',
                success: 'Success',
                warning: 'Warning',
                error: 'Error',
                confirm: 'Are you sure?'
            };

            const backdrop = document.getElementById('iflDialogBackdrop');
            const iconEl = document.getElementById('iflDialogIcon');
            const titleEl = document.getElementById('iflDialogTitle');
            const msgEl = document.getElementById('iflDialogMessage');
            const actEl = document.getElementById('iflDialogActions');
            const cancelBtn = document.getElementById('iflDialogCancel');
            const confirmBtn = document.getElementById('iflDialogConfirm');

            let currentResolve = null;
            let currentMode = null;
            let escListener = null;

            function close(result) {
                backdrop.classList.remove('is-open');
                backdrop.setAttribute('aria-hidden', 'true');
                if (escListener) {
                    document.removeEventListener('keydown', escListener);
                    escListener = null;
                }
                if (currentResolve) {
                    const r = currentResolve; currentResolve = null;
                    r(result);
                }
            }

            function show(mode, message, opts) {
                opts = opts || {};
                const variant = opts.variant || (mode === 'confirm' ? 'confirm' : 'info');
                const title = opts.title != null ? opts.title : DEFAULT_TITLES[variant];

                iconEl.className = 'ifld-icon ifld-icon--' + variant;
                iconEl.innerHTML = ICONS[variant] || ICONS.info;

                titleEl.textContent = title || '';
                titleEl.style.display = title ? '' : 'none';
                msgEl.textContent = String(message == null ? '' : message);

                if (mode === 'confirm') {
                    actEl.classList.remove('is-single');
                    cancelBtn.style.display = '';
                    cancelBtn.textContent = opts.cancelText || 'Cancel';
                    confirmBtn.textContent = opts.okText || 'OK';
                    confirmBtn.classList.toggle('is-danger', !!opts.danger);
                } else {
                    actEl.classList.add('is-single');
                    cancelBtn.style.display = 'none';
                    confirmBtn.textContent = opts.okText || 'OK';
                    confirmBtn.classList.remove('is-danger');
                }

                currentMode = mode;
                backdrop.setAttribute('aria-hidden', 'false');
                requestAnimationFrame(() => backdrop.classList.add('is-open'));
                setTimeout(() => confirmBtn.focus(), 50);

                escListener = (e) => {
                    if (e.key === 'Escape') {
                        e.preventDefault();
                        close(mode === 'confirm' ? false : undefined);
                    } else if (e.key === 'Enter' && mode !== 'confirm') {
                        e.preventDefault();
                        close(undefined);
                    }
                };
                document.addEventListener('keydown', escListener);

                return new Promise(resolve => { currentResolve = resolve; });
            }

            confirmBtn.addEventListener('click', () => close(currentMode === 'confirm' ? true : undefined));
            cancelBtn.addEventListener('click', () => close(false));
            backdrop.addEventListener('mousedown', (e) => {
                if (e.target === backdrop) close(currentMode === 'confirm' ? false : undefined);
            });

            window.IflDialog = {
                alert: (msg, opts) => show('alert', msg, opts),
                confirm: (msg, opts) => show('confirm', msg, opts),
                success: (msg, opts) => show('alert', msg, Object.assign({ variant: 'success' }, opts)),
                error: (msg, opts) => show('alert', msg, Object.assign({ variant: 'error' }, opts)),
                warning: (msg, opts) => show('alert', msg, Object.assign({ variant: 'warning' }, opts))
            };

            // Transparent override of legacy alert(...) calls. window.confirm
            // is left as the browser default — confirm sites must migrate to
            // IflDialog.confirm explicitly because the new API is async.
            window.alert = (msg) => { IflDialog.alert(msg); };

            // ─── Session-expired handler ──────────────────────────────────────
            // Fired by iflFetch when even a fresh-token retry hits 401 — i.e.
            // /token.aspx itself is broken (Kerberos / IIS / SPN issue). Prompt
            // the user to reload; that's the only honest recovery path. The
            // shownOnce guard prevents repeat dialogs if multiple in-flight
            // requests all 401 at the same time.
            // ifl:session-expired listener is intentionally a no-op now.
            // Previously this auto-prompted a page reload, but on servers where
            // /token.aspx is intermittently flaky that reload re-triggered the
            // same 401, producing a login-loop the user couldn't break out of.
            // The 401-retry path in iflFetch still silently re-fetches the
            // token, which handles every recoverable case. If a request is
            // truly unrecoverable, the caller's own error UI surfaces it and
            // the user can recover by opening a new tab (their existing
            // escape hatch). Leaving this listener registered so any future
            // dispatcher doesn't throw an unhandled-event warning.
            window.addEventListener('ifl:session-expired', () => {
                console.warn('[SSO] ifl:session-expired received (no-op).');
            });
        })();
    </script>
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Shared HMAC secret used by token.aspx to sign the sidecar token.
         Must match SSO_SHARED_SECRET in the Node.js .env file. -->
    <appSettings>
        <add key="SsoSharedSecret" value="IFL_WORKFLOW_SECRET_KEY_2025" />
        <!-- Global Catalog server for the ifl.net forest.
             Covers all child domains (lhr.ifl.net / IBRAHIM5_NT etc.).
             Find with: [System.DirectoryServices.ActiveDirectory.Forest]::GetCurrentForest().FindGlobalCatalog().Name -->
        <add key="GcHost" value="HODCSRV19S.IFL.NET" />
    </appSettings>

    <system.webServer>

        <!-- ───────────────────────────────────────────────────────────────
             URL Rewrite — keep token.aspx local to IIS, proxy the rest
             to the Node.js Windows Service on 127.0.0.1:3000.
             ─────────────────────────────────────────────────────────────── -->
        <rewrite>
            <rules>

                <!-- 1. token.aspx must be served by IIS directly so it can
                       read User.Identity.Name. Stop processing here. -->
                <rule name="SidecarAuth" stopProcessing="true">
                    <match url="^token\.aspx$" />
                    <action type="None" />
                </rule>

                <!-- 1b. adsearch.aspx — AD name-search sidecar (query → list of users with sAMAccountName).
                         Same pattern as adlookup.aspx. Anonymous + loopback-only. -->
                <rule name="SidecarSearch" stopProcessing="true">
                    <match url="^adsearch\.aspx$" />
                    <action type="None" />
                </rule>

                <!-- 1c. adlookup.aspx — AD reverse-lookup sidecar (email → sAMAccountName).
                         Served directly by IIS (uses app-pool Windows identity for LDAP).
                         Anonymous auth is enabled for this path only (see <location> below).
                         Loopback-only enforcement is done inside the ASPX itself. -->
                <rule name="SidecarLookup" stopProcessing="true">
                    <match url="^adlookup\.aspx$" />
                    <action type="None" />
                </rule>

                <!-- 2. Reverse-proxy everything else to Node.js. -->
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
                    <serverVariables>
                        <!-- Pass the IIS-authenticated user identity to Node as a
                             trusted header. This works for browser navigations where
                             JavaScript can't add custom headers (e.g. clicking a link
                             to /api/onboarding/initiate). Node's ssoMiddleware reads
                             this header and trusts it because the only way to reach
                             Node is through this proxy (it binds to 127.0.0.1 only). -->
                        <set name="HTTP_X_AUTH_USER" value="{LOGON_USER}" />
                        <!-- Forward the original Host header so Node sees portal.ifl.local
                             instead of 127.0.0.1:3000. Useful for logging / link generation. -->
                        <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                        <set name="HTTP_X_FORWARDED_PROTO" value="{REQUEST_SCHEME}" />
                    </serverVariables>
                </rule>

            </rules>

            <!-- Whitelist the server variables we set above. Required by URL Rewrite. -->
            <allowedServerVariables>
                <add name="HTTP_X_AUTH_USER" />
                <add name="HTTP_X_FORWARDED_HOST" />
                <add name="HTTP_X_FORWARDED_PROTO" />
            </allowedServerVariables>
        </rewrite>

        <!-- ───────────────────────────────────────────────────────────────
             Authentication — Anonymous off, Windows on. Kernel-Mode is
             disabled so the AppPool identity validates the token (no SPN
             dance needed). Negotiate is preferred over NTLM so Kerberos
             is used when SPNs are registered (production), and NTLM is
             the fallback when not (e.g. localhost / non-domain test).
             ─────────────────────────────────────────────────────────────── -->
        <security>
            <authentication>
                <anonymousAuthentication enabled="false" />
                <windowsAuthentication enabled="true"
                                       useKernelMode="false"
                                       useAppPoolCredentials="true">
                    <providers>
                        <clear />
                        <add value="Negotiate" />
                        <add value="NTLM" />
                    </providers>
                    <extendedProtection tokenChecking="None" />
                </windowsAuthentication>
            </authentication>

            <!-- Allow the proxy rules above to forward request bodies of any size. -->
            <requestFiltering>
                <requestLimits maxAllowedContentLength="52428800" />
            </requestFiltering>
        </security>

        <!-- Don't let IIS handle errors from the Node.js process — pass them through. -->
        <httpErrors existingResponse="PassThrough" />

    </system.webServer>


    <!-- adlookup.aspx gets anonymous auth so the Node.js process can call it
         over loopback without triggering an NTLM challenge. Windows auth is
         still on for the whole site; this location overrides it for that one file.
         The ASPX itself enforces loopback-only (REMOTE_ADDR check) and returns
         HMAC-signed responses so Node can verify authenticity. -->
    <location path="adsearch.aspx" overrideMode="Allow">
        <system.webServer>
            <security>
                <authentication>
                    <anonymousAuthentication enabled="true" />
                    <windowsAuthentication enabled="false" />
                </authentication>
            </security>
        </system.webServer>
    </location>

    <location path="adlookup.aspx" overrideMode="Allow">
        <system.webServer>
            <security>
                <authentication>
                    <anonymousAuthentication enabled="true" />
                    <windowsAuthentication enabled="false" />
                </authentication>
            </security>
        </system.webServer>
    </location>

</configuration>
